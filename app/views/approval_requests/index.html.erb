<% tabs = [
  ["pending", "Pending", :clock, "amber"],
  ["approved", "Approved", :approval, "green"],
  ["returned", "Returned", :undo, "blue"],
  ["rejected", "Rejected", :x_circle, "red"],
  ["all", "All", :document, "slate"]
] %>
<% rows = [] %>
<% rows += @pending_approval_requests.to_a.map { |request| [request, :pending] } if @status.in?(%w[pending all]) %>
<% rows += @processed_approval_requests.to_a.map { |request| [request, :processed] } if @status.in?(%w[approved returned rejected all]) %>

<div class="appr">
  <section class="appr-head">
    <div class="appr-head__title">
      <span class="appr-head__icon"><%= app_icon(:approval, size: 30) %></span>
      <div>
        <h1><%= @form_name.presence || "My Approvals" %></h1>
        <p>Review and process approval requests from one place.</p>
      </div>
    </div>
    <div class="appr-stats">
      <% tabs.first(4).each do |key, label, icon, tone| %>
        <%= link_to approval_requests_path(status: key, form_name: @form_name), class: "appr-stat appr-stat--#{tone}#{' is-active' if @status == key}" do %>
          <span class="appr-stat__icon"><%= app_icon(icon, size: 22) %></span>
          <span><strong><%= @status_counts[key] %></strong><small><%= label %></small></span>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="appr-toolbar">
    <nav class="appr-tabs" aria-label="Approval status">
      <% tabs.each do |key, label, icon, tone| %>
        <%= link_to approval_requests_path(status: key, form_name: @form_name), class: "appr-tab appr-tab--#{tone}#{' is-active' if @status == key}" do %>
          <%= app_icon(icon, size: 16) %> <%= label %> (<%= @status_counts[key] %>)
        <% end %>
      <% end %>
    </nav>
    <div class="appr-tools">
      <div class="appr-search" data-table-search-slot="approvals"></div>
      <%= form_with url: approval_requests_path, method: :get, local: true, class: "appr-filter" do %>
        <%= hidden_field_tag :status, @status %>
        <%= select_tag :form_name, options_for_select([["All forms", ""]] + @form_names.map { |name| [name, name] }, @form_name), onchange: "this.form.submit()", "aria-label": "Filter by form" %>
      <% end %>
    </div>
  </section>

  <section class="appr-panel">
    <div class="app-table-wrap appr-table-wrap" data-search-slot="approvals" data-search-placeholder="Search by form, reference, vendor or approver..." data-page-size="10">
      <table class="table app-table appr-table" data-sortable-table="true">
        <thead>
          <tr>
            <th class="appr-col-num">#</th>
            <th>Form Type</th>
            <th>Reference</th>
            <th>Vendor / Firm</th>
            <th>Current Level</th>
            <th>Current Approver</th>
            <th>Submitted On</th>
            <th>Status</th>
            <th class="appr-col-actions">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% rows.each_with_index do |(approval_request, kind), index| %>
            <% info = approval_row_info(approval_request) %>
            <% target_path = approval_record_target_path(approval_request.approvable) %>
            <% viewer_steps = viewer_approval_steps_for(approval_request) %>
            <% current_step = viewer_steps.find { |step| step.status == "pending" } || approval_request.current_step %>
            <% can_act = kind == :pending && current_step.present? && employee_matches_current_login?(current_step.employee_master) %>
            <% badge_data = approval_status_badge_data(approval_request) %>
            <% my_step = if kind == :processed
                 processed_steps = approval_request.approval_steps.reject { |item| item.status.in?(%w[waiting pending]) }
                 if current_approval_employee_ids.any?
                   processed_steps.find { |item| employee_matches_current_login?(item.employee_master) }
                 else
                   processed_steps.max_by { |item| [item.actioned_at || Time.at(0), item.updated_at || Time.at(0)] }
                 end
               end %>
            <tr class="<%= 'is-mine' if can_act %>">
              <td class="appr-col-num"><%= index + 1 %></td>
              <td>
                <span class="appr-form">
                  <span class="appr-form__icon appr-form__icon--<%= info[:tone] %>"><%= app_icon(info[:icon], size: 18) %></span>
                  <span><%= approval_request.form_name %></span>
                </span>
              </td>
              <td class="appr-ref"><%= info[:code] %></td>
              <td class="appr-main">
                <strong title="<%= info[:title] %>"><%= info[:title] %></strong>
                <% if info[:subtitle].present? %><small><%= info[:subtitle] %></small><% end %>
              </td>
              <td><%= info[:level] %></td>
              <td class="appr-main">
                <strong title="<%= info[:approver] %>"><%= info[:approver] %></strong>
                <% if info[:approver_role].present? %><small><%= info[:approver_role] %></small><% end %>
              </td>
              <td class="appr-date">
                <% if info[:submitted_at] %>
                  <%= info[:submitted_at].strftime("%d-%m-%Y") %><small><%= info[:submitted_at].strftime("%I:%M %p") %></small>
                <% else %>-<% end %>
              </td>
              <td>
                <span class="appr-status appr-status--<%= kind == :pending ? 'amber' : approval_status_tone(approval_request) %>" title="<%= badge_data[:label] %>"><%= kind == :pending ? "Pending" : approval_request.status_label %></span>
                <% if can_act %>
                  <small class="appr-yours">Your turn · <%= WorkflowLevelNaming.humanize_level_label(current_step.level) %></small>
                <% elsif my_step %>
                  <small class="appr-yours appr-yours--done" title="<%= my_step.remark.presence %>">You: <%= my_step.effective_status_label %><%= " · #{my_step.remark.truncate(30)}" if my_step.remark.present? %></small>
                <% end %>
              </td>
              <td class="appr-col-actions">
                <div class="appr-actions">
                  <% if target_path != approval_requests_path %>
                    <%= link_to target_path, class: "appr-view" do %><%= app_icon(:eye, size: 16) %> View<% end %>
                  <% end %>
                  <% if can_act %>
                    <% ids = %w[approve return reject].index_with { |action| "#{action}-approval-request-#{approval_request.id}" } %>
                    <button type="button" class="appr-more" aria-label="More actions" aria-haspopup="true" data-appr-menu-toggle>⋮</button>
                    <div class="appr-menu" role="menu" hidden data-appr-menu>
                      <button type="button" role="menuitem" class="appr-menu__item appr-menu__item--approve" data-approval-popup-open="<%= ids["approve"] %>">✓ Approve</button>
                      <button type="button" role="menuitem" class="appr-menu__item appr-menu__item--return" data-approval-popup-open="<%= ids["return"] %>">↩ Return</button>
                      <button type="button" role="menuitem" class="appr-menu__item appr-menu__item--reject" data-approval-popup-open="<%= ids["reject"] %>">✕ Reject</button>
                    </div>
                    <div class="appr-popups">
                      <%= render "approval_requests/approve_modal", approval_request: approval_request, modal_id: ids["approve"], trigger_label: "Approve", trigger_class: "appr-hidden-trigger" %>
                      <%= render "approval_requests/return_modal", approval_request: approval_request, current_step: current_step, modal_id: ids["return"], trigger_label: "Return", trigger_class: "appr-hidden-trigger" %>
                      <%= render "approval_requests/reject_modal", approval_request: approval_request, modal_id: ids["reject"], trigger_label: "Reject", trigger_class: "appr-hidden-trigger" %>
                    </div>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if rows.empty? %>
        <div class="appr-empty">
          <span><%= app_icon(:approval, size: 28) %></span>
          <strong><%= @status == "pending" ? "Nothing is waiting for your approval" : "No requests in this list" %></strong>
        </div>
      <% end %>
    </div>
  </section>
</div>

<script>
  (() => {
    // Approve / Return / Reject popups live in the table rows; show them above
    // the page so the table box cannot clip them.
    document.querySelectorAll(".appr-popups [data-approval-popup-panel]").forEach((panel) => document.body.appendChild(panel))
    if (window.apprMenuBound) return
    window.apprMenuBound = true
    const closeAll = () => document.querySelectorAll("[data-appr-menu]").forEach((menu) => { menu.hidden = true })
    document.addEventListener("click", (event) => {
      const toggle = event.target.closest("[data-appr-menu-toggle]")
      if (toggle) {
        // The menu is moved to <body> so the table box cannot clip it.
        const menu = toggle.apprMenu || toggle.parentElement.querySelector("[data-appr-menu]")
        toggle.apprMenu = menu
        if (menu.parentElement !== document.body) document.body.appendChild(menu)
        const wasOpen = !menu.hidden
        closeAll()
        if (!wasOpen) {
          const rect = toggle.getBoundingClientRect()
          menu.hidden = false
          menu.style.top = `${Math.min(rect.bottom + 4, window.innerHeight - menu.offsetHeight - 8)}px`
          menu.style.left = `${Math.max(8, rect.right - menu.offsetWidth)}px`
        }
        return
      }
      if (event.target.closest("[data-appr-menu] [data-approval-popup-open]")) {
        setTimeout(closeAll, 0)
        return
      }
      if (!event.target.closest("[data-appr-menu]")) closeAll()
    })
    document.addEventListener("scroll", (event) => { if (!event.target.closest?.("[data-appr-menu]")) closeAll() }, true)
    document.addEventListener("turbo:before-cache", () => document.querySelectorAll("body > [data-appr-menu], body > [data-approval-popup-panel]").forEach((node) => node.remove()))
    document.addEventListener("keydown", (event) => { if (event.key === "Escape") closeAll() })
  })()
</script>
