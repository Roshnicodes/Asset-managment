<div class="app-hero-card">
  <div class="app-hero-copy">
    <span class="app-hero-eyebrow">Workflow Desk</span>
    <h1 class="app-hero-title"><%= @form_name.presence || "My Approvals" %></h1>
    <p class="app-hero-text">Review pending and processed approval requests from one place.</p>
  </div>
  <div class="app-hero-meta">
    <div class="app-hero-stat">
      <strong><%= @pending_approval_requests.size %></strong>
      <span>Pending</span>
    </div>
    <div class="app-hero-stat">
      <strong><%= @processed_approval_requests.size %></strong>
      <span>Processed</span>
    </div>
  </div>
</div>

<div class="app-filter-pills">
  <% %w[pending approved returned rejected all].each do |s| %>
    <%= link_to s.titleize, approval_requests_path(status: s, form_name: @form_name), class: "app-filter-pill #{'is-active' if @status == s}" %>
  <% end %>
</div>

<% if @status == 'pending' || @status == 'all' %>
  <div class="app-admin-panel" style="margin-bottom: 1.5rem;">
    <div class="app-admin-panel-header">
      <div>
        <h2 class="app-admin-panel-title">Pending Approvals</h2>
        <p class="app-section-note mb-0">This section shows requests where your action is currently expected.</p>
      </div>
    </div>

    <div class="app-table-wrap approval-requests-table-wrap">
    <table class="table app-table approval-requests-table" data-sortable-table="true">
      <thead>
        <tr>
          <th data-sort-direction="none"><button type="button" class="app-table-sort-trigger" data-sort-trigger data-sort-index="0">Form</button></th>
          <th data-sort-direction="none"><button type="button" class="app-table-sort-trigger" data-sort-trigger data-sort-index="1">Reference</button></th>
          <th data-sort-direction="none"><button type="button" class="app-table-sort-trigger" data-sort-trigger data-sort-index="2">Status</button></th>
          <th data-sort-direction="none"><button type="button" class="app-table-sort-trigger" data-sort-trigger data-sort-index="3">Current Level</button></th>
          <th data-sort-direction="none"><button type="button" class="app-table-sort-trigger" data-sort-trigger data-sort-index="4">Current Approver</button></th>
          <th data-sort-direction="none"><button type="button" class="app-table-sort-trigger" data-sort-trigger data-sort-index="5">Current Action</button></th>
          <th data-sort-direction="none"><button type="button" class="app-table-sort-trigger" data-sort-trigger data-sort-index="6">Approval Trail</button></th>
          <th>View</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% @pending_approval_requests.each do |approval_request| %>
          <% viewer_steps = viewer_approval_steps_for(approval_request) %>
          <% current_step = viewer_steps.find { |step| step.status == "pending" } || approval_request.current_step %>
          <% badge_data = approval_status_badge_data(approval_request) %>
          <tr>
            <td class="approval-requests-table__form"><%= approval_request.form_name %></td>
            <td class="approval-requests-table__reference"><%= approval_request.reference_label %></td>
            <td class="approval-requests-table__status">
              <span class="badge border <%= badge_data[:css_class] %> fw-semibold px-2 py-1 approval-status-chip">
                <%= badge_data[:label] %>
              </span>
            </td>
            <td class="approval-requests-table__level"><%= approval_request.current_level_label %></td>
            <td class="approval-requests-table__approver"><%= approval_request.current_approver_label %></td>
            <td class="approval-requests-table__current-action"><%= approval_request.current_action_summary %></td>
            <td class="approval-requests-table__trail">
              <div class="approval-trail-summary">
                <% approval_request.trail_steps.each do |step| %>
                  <div class="approval-trail-summary__item approval-trail-summary__item--<%= step.effective_status %>">
                    <span class="approval-trail-summary__level"><%= WorkflowLevelNaming.humanize_level_label(step.level) %></span>
                    <span class="approval-trail-summary__name"><%= step.employee_master.name %></span>
                    <span class="approval-trail-summary__status"><%= step.effective_status_label %></span>
                  </div>
                <% end %>
              </div>
            </td>
            <td class="approval-requests-table__view">
              <% target_path = approval_record_target_path(approval_request.approvable) %>
              <% if target_path == approval_requests_path %>
                -
              <% else %>
                <%= link_to "View", target_path, class: "app-action-button approval-view-link" %>
              <% end %>
            </td>
            <td class="approval-requests-table__actions">
              <% if current_step.present? && employee_matches_current_login?(current_step.employee_master) %>
                <div class="approval-action-stack">
                  <span class="badge border bg-info bg-opacity-10 text-info px-2 py-1 approval-you-chip">
                    Pending For You: <%= WorkflowLevelNaming.humanize_level_label(current_step.level) %>
                  </span>
                  <%= render "approval_requests/approve_modal",
                    approval_request: approval_request,
                    modal_id: "approve-approval-request-#{approval_request.id}",
                    trigger_label: "Approve",
                    trigger_class: "app-form-submit approval-action-btn" %>

                  <%= render "approval_requests/return_modal",
                    approval_request: approval_request,
                    current_step: current_step,
                    modal_id: "return-approval-request-#{approval_request.id}",
                    trigger_label: "Return",
                    trigger_class: "app-secondary-btn approval-action-btn" %>

                  <%= render "approval_requests/reject_modal",
                    approval_request: approval_request,
                    modal_id: "reject-approval-request-#{approval_request.id}",
                    trigger_label: "Reject",
                    trigger_class: "app-danger-btn approval-action-btn" %>
                </div>
              <% else %>
                <span class="text-muted">View only</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
<% end %>

<% if @status.in?(%w[approved returned rejected all]) %>
  <div class="app-admin-panel">
    <div class="app-admin-panel-header">
      <div>
        <h2 class="app-admin-panel-title">Processed Approvals</h2>
        <p class="app-section-note mb-0">This section shows the history of approved, returned, and rejected requests.</p>
      </div>
    </div>

    <div class="app-table-wrap approval-requests-table-wrap">
    <table class="table app-table approval-requests-table" data-sortable-table="true">
      <thead>
        <tr>
          <th data-sort-direction="none"><button type="button" class="app-table-sort-trigger" data-sort-trigger data-sort-index="0">Form</button></th>
          <th data-sort-direction="none"><button type="button" class="app-table-sort-trigger" data-sort-trigger data-sort-index="1">Reference</button></th>
          <th data-sort-direction="none"><button type="button" class="app-table-sort-trigger" data-sort-trigger data-sort-index="2">Final Status</button></th>
          <th data-sort-direction="none"><button type="button" class="app-table-sort-trigger" data-sort-trigger data-sort-index="3">Your Decision</button></th>
          <th data-sort-direction="none"><button type="button" class="app-table-sort-trigger" data-sort-trigger data-sort-index="4">Remark</button></th>
          <th data-sort-direction="none"><button type="button" class="app-table-sort-trigger" data-sort-trigger data-sort-index="5">Approval Trail</button></th>
          <th>View</th>
        </tr>
      </thead>
      <tbody>
        <% @processed_approval_requests.each do |approval_request| %>
          <% processed_steps = approval_request.approval_steps.reject { |item| item.status.in?(%w[waiting pending]) } %>
          <% step = if current_approval_employee_ids.any?
               processed_steps.find { |item| employee_matches_current_login?(item.employee_master) }
             else
               processed_steps.max_by { |item| [item.actioned_at || Time.at(0), item.updated_at || Time.at(0)] }
             end %>
          <tr>
            <td class="approval-requests-table__form"><%= approval_request.form_name %></td>
            <td class="approval-requests-table__reference"><%= approval_request.reference_label %></td>
            <td class="approval-requests-table__status"><span class="approval-status-chip approval-status-chip--plain"><%= approval_request.status_label %></span></td>
            <td class="approval-requests-table__decision"><%= step&.effective_status_label || "-" %></td>
            <td class="approval-requests-table__remark"><%= step&.remark.presence || "-" %></td>
            <td class="approval-requests-table__trail">
              <div class="approval-trail-summary">
                <% approval_request.trail_steps.each do |step| %>
                  <div class="approval-trail-summary__item approval-trail-summary__item--<%= step.effective_status %>">
                    <span class="approval-trail-summary__level"><%= WorkflowLevelNaming.humanize_level_label(step.level) %></span>
                    <span class="approval-trail-summary__name"><%= step.employee_master.name %></span>
                    <span class="approval-trail-summary__status"><%= step.effective_status_label %></span>
                  </div>
                <% end %>
              </div>
            </td>
            <td class="approval-requests-table__view">
              <% target_path = approval_record_target_path(approval_request.approvable) %>
              <% if target_path == approval_requests_path %>
                -
              <% else %>
                <%= link_to "View", target_path, class: "app-action-button approval-view-link" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
<% end %>
