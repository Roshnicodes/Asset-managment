<div class="assets-page asset-insurance-page">
  <div class="app-toolbar assets-toolbar">
    <div class="assets-toolbar-copy">
      <h1 class="assets-page-title">Asset Insurance</h1>
      <p class="app-section-note assets-page-note">Capture insurance availability for each asset and store policy details wherever coverage exists.</p>
    </div>

    <div class="assets-toolbar-controls">
      <%= link_to "View Insurance Overview", overview_asset_insurances_path, class: "app-secondary-btn" %>
      <%= link_to "Back to Assets", assets_path, class: "app-secondary-btn" %>
    </div>
  </div>

  <div class="app-detail-card assets-workspace-card" id="asset-insurance-workspace">
    <div class="app-page-header app-subsection-header-tight assets-section-head">
      <div>
        <h3 class="assets-section-title">Insurance Workspace</h3>
        <p class="app-section-note assets-section-note">
          <% if @asset_ids_filter.present? %>
            Newly created or selected assets are ready for insurance capture. Choose `Yes` to enter company, policy number, insurance date, and expiry date, or `No` if insurance does not apply.
          <% else %>
            Pending assets are listed here first so the insurance team can quickly complete coverage decisions.
          <% end %>
        </p>
      </div>
      <span class="assets-table-tag"><%= pluralize(@workspace_assets.size, "asset") %> in workspace</span>
    </div>

    <% if @workspace_assets.blank? %>
      <div class="assets-inline-note">No asset is waiting in the insurance workspace right now. Use the list below to open any asset and update insurance details later.</div>
    <% else %>
      <%= form_with url: update_all_asset_insurances_path, method: :patch, local: true, data: { finance_bulk_form: true, asset_insurance_card: true } do %>
        <%= hidden_field_tag :asset_ids, @asset_ids_filter if @asset_ids_filter.present? %>
        <%= hidden_field_tag :bulk_insurance_update, "1" %>

        <div class="app-table-wrap assets-list-table">
          <table class="table app-table assets-table assets-insurance-workspace-table">
            <thead>
              <tr>
                <th style="width: 56px;">
                  <%= check_box_tag :select_all_asset_insurance_rows, "1", false, class: "form-check-input", data: { finance_select_all: true } %>
                </th>
                <th>Asset Code</th>
                <th>Asset Name</th>
                <th>Product</th>
                <th>Item No</th>
                <th>Serial Number</th>
                <th>Rate</th>
                <th>Current Status</th>
                <% if admin_user? %>
                  <th>Action</th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% selected_asset_ids = Array(params[:selected_asset_ids]).map(&:to_s) %>
              <% @workspace_assets.each do |asset| %>
                <tr id="asset-insurance-<%= asset.id %>">
                  <td>
                    <%= check_box_tag "selected_asset_ids[]", asset.id, selected_asset_ids.include?(asset.id.to_s), class: "form-check-input", data: { finance_row_checkbox: true } %>
                  </td>
                  <td><%= asset.asset_code.presence || "-" %></td>
                  <td>
                    <strong><%= asset.name.presence || asset.product.name %></strong>
                    <% if asset.errors.any? %>
                      <div class="app-form-errors asset-insurance-card__errors mt-2">
                        <h2><%= pluralize(asset.errors.count, "error") %> found</h2>
                        <ul>
                          <% asset.errors.each do |error| %>
                            <li><%= error.full_message %></li>
                          <% end %>
                        </ul>
                      </div>
                    <% end %>
                  </td>
                  <td><%= asset.product.name %></td>
                  <td><%= asset.unique_product_code.presence || "-" %></td>
                  <td><%= asset.serial_number.presence || "-" %></td>
                  <td><%= asset.quotation_proposal_vendor_item&.quoted_rate.present? ? number_with_precision(asset.quotation_proposal_vendor_item.quoted_rate, precision: 2) : "-" %></td>
                  <td><span class="<%= asset.insurance_status_css_class %>"><%= asset.insurance_status_label %></span></td>
                  <% if admin_user? %>
                    <td class="app-row-actions">
                      <div class="d-flex align-items-center gap-2">
                        <%= link_to edit_asset_insurance_path(asset), class: "app-action-icon text-warning", title: "Edit Insurance" do %>
                          <%= app_icon(:pencil, size: 18) %>
                        <% end %>
                        <%= button_to asset_insurance_path(asset),
                              method: :delete,
                              data: { turbo_confirm: "Delete insurance details for this asset?" },
                              class: "app-action-icon text-danger",
                              form_class: "d-inline-block" do %>
                          <%= app_icon(:trash, size: 18) %>
                        <% end %>
                      </div>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="asset-insurance-bulk-panel">
          <div class="d-flex justify-content-between gap-3 flex-wrap align-items-start mb-3">
            <div>
              <div class="asset-insurance-bulk-panel__title">Common Insurance Details</div>
            </div>
            <span class="badge border bg-info bg-opacity-10 text-info">Selected: <span data-finance-selected-count>0</span></span>
          </div>

          <div class="app-form-grid two-col">
            <div class="app-form-field">
              <label for="insured">Insurance Available?</label>
              <%= select_tag :insured,
                    options_for_select([["Select status", ""], ["No", "false"], ["Yes", "true"]], params[:insured]),
                    id: "insured",
                    class: "form-control",
                    data: { insurance_status_select: true },
                    required: true %>
            </div>

            <div class="app-form-field">
              <label>Coverage Decision</label>
              <div class="asset-insurance-card__help">
                Select assets above, choose `Yes` to apply one policy detail set to all selected assets, or choose `No` to clear their policy details.
              </div>
            </div>
          </div>

          <% show_insurance_fields = params[:insured].to_s == "true" %>
          <div class="app-form-grid four-col asset-insurance-extra-fields <%= "is-hidden" unless show_insurance_fields %>"
               data-insurance-extra-fields="true"
               <%= "hidden" unless show_insurance_fields %>>
            <div class="app-form-field">
              <label for="insurance_company_name">Insurance Company Name</label>
              <%= text_field_tag :insurance_company_name,
                    params[:insurance_company_name],
                    id: "insurance_company_name",
                    class: "form-control",
                    placeholder: "Enter company name" %>
            </div>

            <div class="app-form-field">
              <label for="insurance_policy_number">Policy Number</label>
              <%= text_field_tag :insurance_policy_number,
                    params[:insurance_policy_number],
                    id: "insurance_policy_number",
                    class: "form-control",
                    placeholder: "Enter policy number" %>
            </div>

            <div class="app-form-field">
              <label for="insurance_date">Insurance Date</label>
              <%= date_field_tag :insurance_date,
                    params[:insurance_date],
                    id: "insurance_date",
                    class: "form-control" %>
            </div>

            <div class="app-form-field">
              <label for="insurance_expiry_date">Insurance Expiry Date</label>
              <%= date_field_tag :insurance_expiry_date,
                    params[:insurance_expiry_date],
                    id: "insurance_expiry_date",
                    class: "form-control" %>
            </div>
          </div>
        </div>

        <div class="assets-submit-row">
          <%= submit_tag "Save Selected Insurance Details", class: "app-form-submit" %>
        </div>
      <% end %>
    <% end %>
  </div>

</div>
