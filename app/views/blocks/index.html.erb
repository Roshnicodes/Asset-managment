<div class="app-toolbar">
  <div>
    <h1>LG - Blocks</h1>
    <p class="app-section-note">LG includes State, District, and Block.</p>
  </div>
  <%= link_to "Add Block", new_block_path, class: "app-primary-btn" %>
</div>

<div class="app-form-card app-form-card-wide mb-3">
  <%= form_with url: import_blocks_path, multipart: true, local: true do |form| %>
    <div class="app-form-grid two-col">
      <div class="app-form-field">
        <%= form.label :file, "Upload LG Excel / CSV" %>
        <%= form.file_field :file, accept: ".csv,.xls,.xlsx" %>
      </div>

      <div class="app-form-actions">
        <%= form.submit "Upload File", class: "app-form-submit" %>
      </div>
    </div>
  <% end %>
</div>

<div class="app-form-actions mb-2">
  <%= form_with url: destroy_selected_blocks_path, method: :delete, local: true, id: "bulk-delete-blocks", data: { bulk_delete_form: true } do %>
    <%= submit_tag "Delete Selected", class: "app-danger-btn", data: { turbo_confirm: "Delete selected blocks?" } %>
  <% end %>
</div>

<div class="app-table-wrap">
  <table class="table app-table">
    <thead>
      <tr>
        <th>
          <label class="app-bulk-select-all">
            <%= check_box_tag :select_all_blocks, "1", false, data: { bulk_delete_select_all: true }, form: "bulk-delete-blocks" %>
            <span>Select All</span>
          </label>
        </th>
        <th>State Code</th>
        <th>State</th>
        <th>District Code</th>
        <th>District</th>
        <th>Block Code</th>
        <th>Block</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% @blocks.each do |block| %>
        <tr>
          <td><%= check_box_tag "block_ids[]", block.id, false, data: { bulk_delete_checkbox: true }, form: "bulk-delete-blocks" %></td>
          <td><%= block.district.state.code.presence || "-" %></td>
          <td><%= block.district.state.name %></td>
          <td><%= block.district.code.presence || "-" %></td>
          <td><%= block.district.name %></td>
          <td><%= block.code.presence || "-" %></td>
          <td><%= block.name %></td>
          <td class="app-row-actions">
            <%= link_to "Edit", edit_block_path(block) %> |
            <%= button_to "Delete", block_path(block), method: :delete, data: { turbo_confirm: "Delete this block?" }, class: "app-action-button app-delete-button" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
