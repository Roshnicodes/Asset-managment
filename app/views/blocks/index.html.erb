<div class="app-toolbar">
  <div>
    <h1>LG - Blocks</h1>
    <p class="app-section-note">LG includes State, District, and Block.</p>
  </div>
  <%= link_to "Add Block", new_block_path, class: "app-primary-btn" %>
</div>

<div class="app-list-controls" style="display:flex!important;align-items:center!important;gap:8px!important;flex-wrap:nowrap!important;margin-bottom:8px!important;padding:8px 10px!important;overflow:hidden!important;">
  <div class="app-list-control-upload" style="display:inline-flex!important;flex:0 0 auto!important;width:auto!important;">
    <%= form_with url: import_blocks_path, multipart: true, local: true, html: { style: "display:inline-flex!important;align-items:center!important;width:auto!important;margin:0!important;" } do |form| %>
      <div class="app-list-upload-inline" style="display:inline-flex!important;align-items:center!important;gap:8px!important;width:auto!important;">
        <%= form.file_field :file, accept: ".csv,.xls,.xlsx", class: "app-list-file-input", style: "width:170px!important;max-width:170px!important;min-height:36px!important;font-size:13px!important;" %>
        <%= form.submit "Upload File", class: "app-form-submit", style: "min-height:36px!important;padding:6px 12px!important;font-size:14px!important;white-space:nowrap!important;" %>
      </div>
    <% end %>
  </div>

  <div class="app-list-control-action" style="display:inline-flex!important;flex:0 0 auto!important;width:auto!important;">
    <%= form_with url: destroy_selected_blocks_path, method: :delete, local: true, id: "bulk-delete-blocks", data: { bulk_delete_form: true }, html: { style: "display:inline-flex!important;margin:0!important;" } do %>
      <%= submit_tag "Delete Selected", class: "app-danger-btn", data: { turbo_confirm: "Delete selected blocks?" }, style: "min-height:36px!important;padding:6px 12px!important;font-size:14px!important;white-space:nowrap!important;" %>
    <% end %>
  </div>

  <div class="app-list-control-search" data-table-search-slot="blocks-records" style="display:inline-flex!important;flex:0 1 380px!important;width:380px!important;margin-left:0!important;">
    <%= render "shared/table_search", placeholder: "Search blocks..." %>
  </div>
</div>

<div class="app-table-wrap" data-search-placeholder="Search blocks..." data-search-slot="blocks-records" data-server-search="true" data-table-search="false">
  <table class="table app-table">
    <thead>
      <tr>
        <th>
          <label class="app-bulk-select-all">
            <%= check_box_tag :select_all_blocks, "1", false, data: { bulk_delete_select_all: true }, form: "bulk-delete-blocks" %>
            <span>Select All</span>
          </label>
        </th>
        <th>State Code</th>
        <th>State</th>
        <th>District Code</th>
        <th>District</th>
        <th>Block Code</th>
        <th>Block</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% @blocks.each do |block| %>
        <tr>
          <td><%= check_box_tag "block_ids[]", block.id, false, data: { bulk_delete_checkbox: true }, form: "bulk-delete-blocks" %></td>
          <td><%= block.district.state.code.presence || "-" %></td>
          <td><%= block.district.state.name %></td>
          <td><%= block.district.code.presence || "-" %></td>
          <td><%= block.district.name %></td>
          <td><%= block.code.presence || "-" %></td>
          <td><%= block.name %></td>
          <td class="app-row-actions">
            <%= link_to "Edit", edit_block_path(block) %> |
            <%= button_to "Delete", block_path(block), method: :delete, data: { turbo_confirm: "Delete this block?" }, class: "app-action-button app-delete-button" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render "shared/table_pagination", pagination: @pagination %>
