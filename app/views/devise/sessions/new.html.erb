<div class="auth-wrapper">
  <div class="auth-split-card">
    <%= render "devise/shared/auth_slider" %>
    
    <div class="auth-form-side">
      <div class="auth-header">
        <h1 class="auth-title">Accelerated Procurement Unified Realtime Transaction Interface</h1>
        <p class="auth-subtitle">Secure procurement, AI-powered approvals, and realtime transaction visibility in one beautiful login experience.</p>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form", data: { turbo: false } }) do |f| %>
        <div class="form-group mb-4">
          <%= f.label :email, "Employee Code", class: "form-label" %>
          <%= f.text_field :email, class: "form-control", placeholder: "EMP001", autofocus: true, autocomplete: "username" %>
        </div>

        <div class="form-group mb-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <%= f.label :password, "Your Password", class: "form-label mb-0" %>
          </div>
          <%= f.password_field :password, class: "form-control", placeholder: "••••••••", autocomplete: "current-password" %>
        </div>

        <div class="mb-4 form-check">
          <%= f.check_box :remember_me, class: "form-check-input" %>
          <%= f.label :remember_me, "Keep me logged in", class: "form-check-label small opacity-75" %>
        </div>

        <%= f.submit "SIGN IN", class: "btn-auth-submit" %>
      <% end %>

    </div>
  </div>
</div>
