<div class="app-toolbar">
  <div>
    <h1>Employee Master</h1>
  </div>
  <div class="app-toolbar-actions">
    <%= link_to "Export Excel", export_employee_masters_path, class: "app-secondary-btn" %>
    <%= button_to "Sync Approval Logins", sync_logins_employee_masters_path, method: :post, class: "app-secondary-btn" %>
    <%= link_to "Add Employee", new_employee_master_path, class: "app-primary-btn" %>
  </div>
</div>

<style>
  .employee-master-workspace {
    display: flex !important;
    flex-direction: column !important;
    height: calc(100vh - 140px) !important;
    max-height: calc(100vh - 140px) !important;
    min-height: 0 !important;
    gap: 0.5rem !important;
    overflow: hidden !important;
  }

  .app-toolbar:has(+ style + .employee-master-workspace) {
    margin-bottom: 0.5rem !important;
  }

  .app-toolbar:has(+ style + .employee-master-workspace) h1 {
    margin-bottom: 0 !important;
  }

  .employee-master-workspace.app-page-paged > :not(.app-page-header):not(.app-detail-actions):not(.app-form-pager) {
    flex: 1 1 auto !important;
    min-height: 0 !important;
    overflow-y: auto !important;
  }

  .employee-master-workspace .app-table-wrap {
    flex: 1 1 auto !important;
    max-height: none !important;
    min-height: 0 !important;
  }

  .employee-master-workspace .app-page-section-pager,
  .employee-master-workspace > .app-form-pager {
    display: none !important;
  }

  .employee-master-workspace > .app-form-card {
    display: block !important;
    visibility: visible !important;
  }

  .employee-master-workspace > .app-card {
    display: flex !important;
    visibility: visible !important;
  }

  .employee-master-workspace > .app-form-card[hidden],
  .employee-master-workspace > .app-card[hidden] {
    display: block !important;
  }

  .employee-master-workspace > .employee-master-table-page[hidden] {
    display: flex !important;
  }

  .employee-master-table-page {
    display: flex !important;
    flex-direction: column !important;
    min-height: 0 !important;
    padding: 0.75rem !important;
    overflow: hidden !important;
  }

  .employee-master-upload-card {
    padding: 0.4rem 0.6rem !important;
  }

  .employee-master-upload-card .app-form-grid {
    align-items: end !important;
    gap: 0.5rem !important;
    grid-template-columns: minmax(220px, 360px) auto !important;
  }

  .employee-master-upload-card .app-form-field {
    margin-bottom: 0 !important;
  }

  .employee-master-upload-card .app-form-field label {
    margin-bottom: 0.25rem !important;
    font-size: 0.78rem !important;
  }

  .employee-master-upload-card .app-form-actions {
    margin-top: 0 !important;
    padding-top: 0 !important;
    justify-content: flex-start !important;
  }

  .employee-master-upload-card input[type="file"] {
    min-height: 34px !important;
    padding: 0.35rem 0.5rem !important;
    font-size: 0.82rem !important;
  }

  .employee-master-upload-card .app-form-submit {
    min-height: 34px !important;
    padding: 0.35rem 0.8rem !important;
    font-size: 0.82rem !important;
  }

  .employee-master-table-page .app-table-search {
    flex: 0 0 auto;
    margin-bottom: 0.5rem !important;
  }

  .employee-master-controls {
    display: flex !important;
    align-items: center !important;
    flex: 0 0 auto !important;
    flex-wrap: nowrap !important;
    gap: 8px !important;
    width: 100% !important;
    min-height: 48px !important;
    margin: 0 0 8px !important;
    padding: 6px 8px !important;
    overflow: hidden !important;
  }

  .employee-master-controls form,
  .employee-master-controls .app-list-control-upload,
  .employee-master-controls .app-list-control-action,
  .employee-master-controls .app-list-upload-inline {
    display: inline-flex !important;
    align-items: center !important;
    flex: 0 0 auto !important;
    width: auto !important;
    margin: 0 !important;
    min-width: 0 !important;
  }

  .employee-master-controls .app-list-upload-inline {
    gap: 8px !important;
  }

  .employee-master-controls .app-list-file-input {
    flex: 0 0 170px !important;
    width: 170px !important;
    max-width: 170px !important;
    min-height: 36px !important;
    padding: 5px 6px !important;
    font-size: 13px !important;
  }

  .employee-master-controls .app-form-submit,
  .employee-master-controls .app-danger-btn {
    min-height: 36px !important;
    padding: 6px 12px !important;
    font-size: 14px !important;
    white-space: nowrap !important;
  }

  .employee-master-controls .app-list-control-search {
    display: inline-flex !important;
    flex: 0 1 380px !important;
    width: 380px !important;
    min-width: 180px !important;
    margin-left: 0 !important;
  }

  .employee-master-controls .app-table-search {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    width: 100% !important;
    margin: 0 !important;
  }

  .employee-master-controls .app-table-search-input {
    flex: 1 1 auto !important;
    width: 100% !important;
    max-width: none !important;
    min-height: 36px !important;
    padding: 6px 10px !important;
    font-size: 14px !important;
  }

  .employee-master-controls .app-table-search-btn {
    flex: 0 0 auto !important;
  }

  .employee-master-table-wrap thead th {
    position: sticky;
    top: 0;
    z-index: 5;
    background: #f8fcf9 !important;
    box-shadow: inset 0 -1px 0 #dce7dd;
    white-space: nowrap;
  }

  .employee-master-actions {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .employee-master-actions form {
    display: inline-flex !important;
    margin: 0 !important;
  }

  .employee-master-actions .app-action-icon {
    width: 30px;
    height: 30px;
  }

  .employee-master-actions .text-info {
    background: rgba(13, 202, 240, 0.12);
    color: #087990 !important;
  }

  .employee-master-actions .text-info:hover {
    background: #087990;
    color: #fff !important;
  }
</style>

<script>
  (() => {
    const restoreEmployeeMasterTable = () => {
      const workspace = document.querySelector(".employee-master-workspace")
      if (!workspace) return

      workspace.removeAttribute("data-ui-page-pager")
      workspace.classList.remove("app-page-paged")
      workspace.dataset.uiPagePagerReady = "true"

      workspace.querySelectorAll(":scope > .app-form-card, :scope > .app-card").forEach((section) => {
        section.hidden = false
        section.style.removeProperty("display")
        section.style.removeProperty("overflow-y")
      })

      workspace.querySelectorAll(":scope > .app-page-section-pager, :scope > .app-form-pager").forEach((pager) => {
        pager.remove()
      })
    }

    document.addEventListener("DOMContentLoaded", () => {
      restoreEmployeeMasterTable()
      requestAnimationFrame(restoreEmployeeMasterTable)
      setTimeout(restoreEmployeeMasterTable, 250)
    })

    document.addEventListener("turbo:load", () => {
      restoreEmployeeMasterTable()
      requestAnimationFrame(restoreEmployeeMasterTable)
      setTimeout(restoreEmployeeMasterTable, 250)
    })
  })()
</script>

<div class="employee-master-workspace">
  <div class="app-list-controls employee-master-controls" style="display:flex!important;align-items:center!important;gap:8px!important;flex-wrap:nowrap!important;margin-bottom:8px!important;padding:8px 10px!important;overflow:hidden!important;">
    <div class="app-list-control-upload" style="display:inline-flex!important;flex:0 0 auto!important;width:auto!important;">
      <%= form_with url: import_employee_masters_path, multipart: true, local: true, html: { style: "display:inline-flex!important;align-items:center!important;width:auto!important;margin:0!important;" } do |form| %>
        <div class="app-list-upload-inline" style="display:inline-flex!important;align-items:center!important;gap:8px!important;width:auto!important;">
          <%= form.file_field :file, accept: ".csv,.xls,.xlsx", class: "app-list-file-input", style: "width:170px!important;max-width:170px!important;min-height:36px!important;font-size:13px!important;" %>
          <%= form.submit "Upload File", class: "app-form-submit", style: "min-height:36px!important;padding:6px 12px!important;font-size:14px!important;white-space:nowrap!important;" %>
        </div>
      <% end %>
    </div>

    <div class="app-list-control-action" style="display:inline-flex!important;flex:0 0 auto!important;width:auto!important;">
      <%= form_with url: destroy_selected_employee_masters_path, method: :delete, local: true, id: "bulk-delete-employees", data: { bulk_delete_form: true }, html: { style: "display:inline-flex!important;margin:0!important;" } do %>
        <%= submit_tag "Delete Selected", class: "app-danger-btn", data: { turbo_confirm: "Delete selected employees?" }, style: "min-height:36px!important;padding:6px 12px!important;font-size:14px!important;white-space:nowrap!important;" %>
      <% end %>
    </div>

    <div class="app-list-control-search" data-table-search-slot="employee-master-records" style="display:inline-flex!important;flex:0 1 380px!important;width:380px!important;margin-left:0!important;">
      <%= render "shared/table_search", placeholder: "Search employees..." %>
    </div>
  </div>

  <div class="app-card employee-master-table-page">
    <div class="app-table-wrap employee-master-table-wrap" data-search-placeholder="Search employees..." data-search-slot="employee-master-records" data-server-search="true" data-table-search="false">
      <table class="table app-table">
        <thead>
          <tr>
            <th>
              <label class="app-bulk-select-all">
                <%= check_box_tag :select_all_employees, "1", false, data: { bulk_delete_select_all: true }, form: "bulk-delete-employees" %>
                <span>Select All</span>
              </label>
            </th>
            <th>Stakeholder</th>
            <th>User Type</th>
            <th>Employee Code</th>
            <th>User Name</th>
            <th>Designation</th>
            <th>Email ID</th>
            <th>Mobile No</th>
            <th>State</th>
            <th>District</th>
            <th>Block</th>
            <th>Gram Panchayat</th>
            <th>Village</th>
            <th>Parent Office</th>
            <th>Office</th>
            <th>Location</th>
            <th>Full Address</th>
            <th>Pincode</th>
            <th>Login Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% @employee_masters.each do |employee_master| %>
            <tr>
              <td><%= check_box_tag "employee_master_ids[]", employee_master.id, false, data: { bulk_delete_checkbox: true }, form: "bulk-delete-employees" %></td>
              <td><%= employee_master.stakeholder_category.name %></td>
              <td><%= employee_master.user_type %></td>
              <td><%= employee_master.employee_code %></td>
              <td><%= employee_master.name %></td>
              <td><%= employee_master.designation %></td>
              <td><%= employee_master.email_id %></td>
              <td><%= employee_master.mobile_no %></td>
              <td><%= employee_master.state&.name %></td>
              <td><%= employee_master.district&.name %></td>
              <td><%= employee_master.block&.name %></td>
              <td><%= employee_master.gram_panchayat %></td>
              <td><%= employee_master.village %></td>
              <td><%= employee_master.parent_office %></td>
              <td><%= employee_master.office %></td>
              <td><%= employee_master.location %></td>
              <td><%= employee_master.full_address %></td>
              <td><%= employee_master.pincode %></td>
              <td><%= employee_master.login_ready? ? "Ready" : "Not Ready" %></td>
              <td class="app-row-actions">
                <div class="employee-master-actions">
                  <%= link_to edit_employee_master_path(employee_master), class: "app-action-icon text-warning", title: "Edit", aria: { label: "Edit employee" } do %>
                    <%= app_icon(:pencil, size: 16) %>
                  <% end %>

                  <% if employee_master.email_id.present? && employee_master.employee_code.present? %>
                    <%= button_to reset_login_password_employee_master_path(employee_master),
                          method: :post,
                          data: { turbo_confirm: "Reset login password to #{EmployeeLoginProvisioner::DEFAULT_PASSWORD} for this employee?" },
                          class: "app-action-icon text-info",
                          title: "Reset Login Password",
                          aria: { label: "Reset login password" },
                          form_class: "d-inline-block" do %>
                      <%= app_icon(:key, size: 16) %>
                    <% end %>
                  <% end %>

                  <%= button_to employee_master_path(employee_master),
                        method: :delete,
                        data: { turbo_confirm: "Delete this employee?" },
                        class: "app-action-icon text-danger",
                        title: "Delete",
                        aria: { label: "Delete employee" } do %>
                    <%= app_icon(:trash, size: 16) %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/table_pagination", pagination: @pagination %>
  </div>
</div>
