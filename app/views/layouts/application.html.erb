<!DOCTYPE html>
<html>
<head>
  <title>Asset Management</title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <%= favicon_link_tag "/favicon.svg", type: "image/svg+xml" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload", preload_links_header: false %>
  <%= javascript_importmap_tags %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "payment_advice", "data-turbo-track": "reload" if controller_name == "payment_advices" %>
  <!-- Bootstrap JS (IMPORTANT for dropdown) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <% unless devise_controller? %>
    <style>
      @media screen and (min-width: 992px) {
        html,
        body.app-fixed-shell {
          width: 100% !important;
          height: 100vh !important;
          max-height: 100vh !important;
          overflow: hidden !important;
        }

        body.app-fixed-shell {
          position: fixed !important;
          inset: 0 !important;
        }

        body.app-fixed-shell > .app-navbar {
          position: fixed !important;
          inset: 0 0 auto 0 !important;
          height: 96px !important;
          min-height: 96px !important;
          padding: 0.55rem 1.25rem !important;
          z-index: 1100 !important;
          background: #ffffff !important;
        }

        body.app-fixed-shell .app-logo-img {
          width: auto !important;
          max-width: 220px !important;
          max-height: 78px !important;
          object-fit: contain !important;
        }

        body.app-fixed-shell > .app-shell {
          position: fixed !important;
          inset: 96px 0 0 0 !important;
          display: grid !important;
          grid-template-columns: 280px minmax(0, 1fr) !important;
          gap: 0.75rem !important;
          width: 100vw !important;
          height: calc(100vh - 96px) !important;
          min-height: 0 !important;
          padding: 0.75rem !important;
          overflow: hidden !important;
        }

        body.app-fixed-shell > .app-shell > .app-sidebar {
          position: relative !important;
          top: auto !important;
          height: 100% !important;
          max-height: none !important;
          min-height: 0 !important;
          overflow-y: auto !important;
          overflow-x: hidden !important;
          border-radius: 20px !important;
          padding: 1rem 0.9rem !important;
        }

        body.app-fixed-shell > .app-shell > .app-main {
          height: 100% !important;
          min-height: 0 !important;
          overflow: hidden !important;
        }

        body.app-fixed-shell > .app-shell > .app-main > .app-content {
          display: flex !important;
          flex-direction: column !important;
          height: 100% !important;
          min-height: 0 !important;
          max-height: 100% !important;
          overflow-y: auto !important;
          overflow-x: hidden !important;
          padding: 0.75rem !important;
          border-radius: 20px !important;
        }

        body.app-fixed-shell .app-content > .quotation-proposal-show {
          flex: 0 0 auto !important;
          height: auto !important;
          max-height: none !important;
          overflow: visible !important;
        }
      }

      @media screen and (max-width: 991px) {
        body.app-fixed-shell > .app-navbar {
          position: sticky !important;
          top: 0 !important;
          z-index: 1100 !important;
        }
      }
    </style>
  <% end %>
</head>

<body class="<%= devise_controller? ? 'auth-page-body' : 'app-fixed-shell' %>">

<% unless devise_controller? %>
  <%= render "layouts/navbar" %>
<% end %>

<% if devise_controller? %>
  <%= yield %>
<% else %>
  <div class="app-shell">

    <%= render("layouts/sidebar") if user_signed_in? %>

    <main class="app-main">
      <div class="app-content">

        <!-- FLASH -->
        <% if notice %>
          <div class="alert alert-success" data-auto-dismiss-flash="true"><%= notice %></div>
        <% end %>

        <% if alert %>
          <div class="alert alert-danger" data-auto-dismiss-flash="true"><%= alert %></div>
        <% end %>

        <%= yield %>
      </div>
    </main>

  </div>
<% end %>

<script>
  document.addEventListener("change", function(event) {
    var target = event.target;
    if (!target || !target.matches("[data-bulk-delete-select-all]")) return;

    var formId = target.getAttribute("form");
    if (!formId) return;

    document.querySelectorAll('[data-bulk-delete-checkbox][form="' + formId + '"]').forEach(function(checkbox) {
      checkbox.checked = target.checked;
    });
  });

  document.addEventListener("change", function(event) {
    var target = event.target;
    if (!target || !target.matches("[data-bulk-delete-checkbox]")) return;

    var formId = target.getAttribute("form");
    if (!formId) return;

    var selectAll = document.querySelector('[data-bulk-delete-select-all][form="' + formId + '"]');
    var checkboxes = Array.from(document.querySelectorAll('[data-bulk-delete-checkbox][form="' + formId + '"]'));
    if (!selectAll || checkboxes.length === 0) return;

    var checkedCount = checkboxes.filter(function(checkbox) { return checkbox.checked; }).length;
    selectAll.checked = checkedCount === checkboxes.length;
    selectAll.indeterminate = checkedCount > 0 && checkedCount < checkboxes.length;
  });

  document.addEventListener("submit", function(event) {
    var form = event.target;
    if (!form || !form.matches("[data-bulk-delete-form]") || !form.id) return;

    var selectAll = document.querySelector('[data-bulk-delete-select-all][form="' + form.id + '"]');
    if (!selectAll || !selectAll.checked) return;

    document.querySelectorAll('[data-bulk-delete-checkbox][form="' + form.id + '"]').forEach(function(checkbox) {
      checkbox.checked = true;
    });
  });
</script>

</body>
</html>
