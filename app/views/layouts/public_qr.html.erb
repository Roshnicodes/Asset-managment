<!DOCTYPE html>
<html>
<head>
  <title>Vendor Quotation Details</title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    html {
      min-height: 100%;
      overflow-y: auto;
    }

    .public-qr-page {
      min-height: 100vh;
      min-height: 100dvh;
      overflow-y: auto;
      background:
        radial-gradient(circle at top left, rgba(242, 177, 52, 0.08), transparent 22%),
        linear-gradient(180deg, #f6fbf7 0%, #eef7f1 100%);
    }

    .public-qr-main {
      width: min(100%, 1100px);
      max-width: 1100px;
      box-sizing: border-box;
      margin: 0 auto;
      padding: 2rem clamp(1rem, 2vw, 1.75rem) 3rem;
    }

    .public-qr-brand {
      display: flex;
      justify-content: center;
      margin-bottom: 1rem;
    }

    .public-qr-brand-logo {
      width: auto;
      max-width: min(220px, 72vw);
      max-height: 92px;
      object-fit: contain;
      display: block;
    }

    .public-qr-flash-stack {
      display: grid;
      gap: 0.85rem;
      margin-bottom: 0.95rem;
    }

    .public-qr-flash {
      margin: 0;
      padding: 0.9rem 1.1rem;
      border-radius: 18px;
      border-width: 1px;
      box-shadow: 0 12px 28px rgba(26, 58, 42, 0.06);
    }

    @media (max-width: 768px) {
      .public-qr-main {
        width: 100%;
        padding: 1rem 0.85rem 2rem;
      }
    }
  </style>
</head>

<body class="public-qr-page">
  <main class="public-qr-main">
    <% public_stakeholder = @stakeholder_category || @invitation&.stakeholder_category %>
    <div class="public-qr-brand">
      <%= image_tag stakeholder_logo_source(public_stakeholder), alt: stakeholder_logo_alt(public_stakeholder), class: "public-qr-brand-logo" %>
    </div>

    <div class="public-qr-flash-stack">
      <% if notice %>
        <div class="alert alert-success public-qr-flash"><%= notice %></div>
      <% end %>

      <% if alert %>
        <div class="alert alert-danger public-qr-flash"><%= alert %></div>
      <% end %>
    </div>

    <%= yield %>
  </main>
</body>
</html>
