<div class="app-hero-card">
  <div class="app-hero-copy">
    <span class="app-hero-eyebrow">Access Setup</span>
    <h1 class="app-hero-title">Role Based Access Control</h1>
    <p class="app-hero-text">Stakeholder aur designation select karke exactly decide karein ki sidebar aur page access me kya visible hoga.</p>
  </div>
  <div class="app-hero-meta">
    <div class="app-hero-stat">
      <strong><%= MenuPermission::SIDEBAR_MENUS.size %></strong>
      <span>Total Menus</span>
    </div>
    <div class="app-hero-stat">
      <strong><%= StakeholderCategory.count %></strong>
      <span>Stakeholders</span>
    </div>
  </div>
</div>

<div class="app-form-card app-form-card-wide app-admin-panel">
  <div class="app-admin-panel-header">
    <div>
      <h2 class="app-admin-panel-title">Role Context</h2>
      <p class="app-section-note mb-0">Pehle stakeholder category aur designation choose karein, phir permission matrix auto load hogi.</p>
    </div>
  </div>

  <%= form_with url: menu_permissions_path, method: :get, local: true, class: "app-form-grid two-col" do |f| %>
    <div class="app-form-field">
      <%= f.label :stakeholder_category_id, "Stakeholder Category <span class='text-danger'>*</span>".html_safe %>
      <% options = StakeholderCategory.order(:name).map { |s| ["#{s.name} (ID: #{s.id})", s.id] } %>
      <%= f.select :stakeholder_category_id, options, { prompt: "Select Stakeholder Category", selected: params[:stakeholder_category_id] }, { class: "form-control", onchange: "this.form.submit()" } %>
    </div>

    <div class="app-form-field">
      <%= f.label :designation, "Role (Designation) <span class='text-danger'>*</span>".html_safe %>
      <% designations = EmployeeMaster.where.not(designation: [nil, ""]).pluck(:designation).uniq.sort %>
      <%= f.select :designation, designations, { prompt: "Select Role", selected: params[:designation] }, { class: "form-control", onchange: "this.form.submit()" } %>
    </div>
  <% end %>
</div>

<% if @current_stakeholder && @current_designation %>
  <div class="app-context-banner">
    <div class="app-context-pill app-context-pill-success">Stakeholder: <%= @current_stakeholder.name %></div>
    <div class="app-context-pill app-context-pill-info">Role: <%= @current_designation %></div>
    <div class="app-context-pill">Menus: <%= MenuPermission::SIDEBAR_MENUS.size %></div>
    <div class="app-context-note">Checked items sidebar aur permitted pages dono me visible rahenge.</div>
  </div>

  <%= form_with url: menu_permissions_path, method: :post, local: true do |f| %>
    <%= f.hidden_field :stakeholder_category_id, value: @current_stakeholder.id %>
    <%= f.hidden_field :designation, value: @current_designation %>

    <div class="app-admin-panel">
      <div class="app-admin-panel-header">
        <div>
          <h2 class="app-admin-panel-title">Permission Matrix</h2>
          <p class="app-section-note mb-0">Primary menu aur uske sub-menu items ko role ke hisaab se enable ya disable karein.</p>
        </div>
      </div>

      <div class="app-permission-list">
        <% MenuPermission::SIDEBAR_MENUS.each do |label, value| %>
          <div class="app-permission-card">
            <% if value.is_a?(Hash) %>
              <div class="app-permission-head">
                <label class="app-permission-main">
                  <%= check_box_tag "menu_ids[]", value["main"], @permissions[value["main"]], id: "menu_#{value["main"]}", class: "form-check-input" %>
                  <span><%= label %></span>
                </label>
                <span class="app-permission-tag">Parent + Submenu</span>
              </div>
              <div class="app-permission-subgrid">
                <% value.each do |sub_label, sub_id| %>
                  <% next if sub_label == "main" %>
                  <label for="menu_<%= sub_id %>" class="app-permission-chip">
                    <%= check_box_tag "menu_ids[]", sub_id, @permissions[sub_id], id: "menu_#{sub_id}", class: "form-check-input" %>
                    <span><%= sub_label %></span>
                  </label>
                <% end %>
              </div>
            <% else %>
              <div class="app-permission-head">
                <label class="app-permission-main">
                  <%= check_box_tag "menu_ids[]", value, @permissions[value], id: "menu_#{value}", class: "form-check-input" %>
                  <span><%= label %></span>
                </label>
                <span class="app-permission-tag">Single Menu</span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="app-form-actions app-form-actions-sticky">
        <button type="submit" class="app-form-submit px-5 shadow-sm">Save Access Control</button>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="app-empty-state">
    <div class="app-empty-icon"><%= app_icon(:people, size: 30) %></div>
    <h3>Select Role Context</h3>
    <p>Choose a stakeholder category and designation first, then the permission matrix will load here.</p>
  </div>
<% end %>
