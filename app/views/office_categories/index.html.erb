<div class="app-toolbar">
  <div>
    <h1>Office Structure</h1>
    <p class="app-section-note">Map office structure, category, parent office, and location for each stakeholder.</p>
  </div>
  <%= link_to "Add Office Structure", new_office_category_path, class: "app-primary-btn" %>
</div>

<div class="app-form-card app-form-card-wide mb-3">
  <%= form_with url: import_office_categories_path, multipart: true, local: true do |form| %>
    <div class="app-form-grid two-col">
      <div class="app-form-field">
        <%= form.label :file, "Upload Office Structure Excel / CSV" %>
        <%= form.file_field :file, accept: ".csv,.xls,.xlsx" %>
      </div>

      <div class="app-form-actions">
        <%= form.submit "Upload File", class: "app-form-submit" %>
      </div>
    </div>
  <% end %>
</div>

<div class="app-form-actions mb-2">
  <%= form_with url: destroy_selected_office_categories_path, method: :delete, local: true, id: "bulk-delete-office-structures", data: { bulk_delete_form: true } do %>
    <%= submit_tag "Delete Selected", class: "app-danger-btn", data: { turbo_confirm: "Delete selected office structures?" } %>
  <% end %>
</div>

<div class="app-table-wrap">
  <table class="table app-table">
    <thead>
      <tr>
        <th>
          <label class="app-bulk-select-all">
            <%= check_box_tag :select_all_office_structures, "1", false, data: { bulk_delete_select_all: true }, form: "bulk-delete-office-structures" %>
            <span>Select All</span>
          </label>
        </th>
        <th>Stakeholder</th>
        <th>Category Name</th>
        <th>Parent Office</th>
        <th>State</th>
        <th>District</th>
        <th>Block</th>
        <th>Name</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% @office_categories.each do |office_category| %>
        <tr>
          <td><%= check_box_tag "office_category_ids[]", office_category.id, false, data: { bulk_delete_checkbox: true }, form: "bulk-delete-office-structures" %></td>
          <td><%= office_category.stakeholder_category&.name || "-" %></td>
          <td><%= office_category.office_category_master_name || "-" %></td>
          <td><%= office_category.parent&.display_name || "-" %></td>
          <td><%= office_category.state&.name || "-" %></td>
          <td><%= office_category.district&.name || "-" %></td>
          <td><%= office_category.block&.name || "-" %></td>
          <td><%= office_category.name.presence || "-" %></td>
          <td class="app-row-actions">
            <%= link_to "Edit", edit_office_category_path(office_category) %> |
            <%= button_to "Delete", office_category_path(office_category), method: :delete, data: { turbo_confirm: "Delete this office structure?" }, class: "app-action-button app-delete-button" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
