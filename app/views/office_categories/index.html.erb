<div class="app-toolbar">
  <div>
    <h1>Office Structure</h1>
    <p class="app-section-note">Map office structure, category, parent office, and location for each stakeholder.</p>
  </div>
  <%= link_to "Add Office Structure", new_office_category_path, class: "app-primary-btn" %>
</div>

<div class="app-list-controls" style="display:flex!important;align-items:center!important;gap:8px!important;flex-wrap:nowrap!important;margin-bottom:8px!important;padding:8px 10px!important;overflow:hidden!important;">
  <div class="app-list-control-upload" style="display:inline-flex!important;flex:0 0 auto!important;width:auto!important;">
    <%= form_with url: import_office_categories_path, multipart: true, local: true, html: { style: "display:inline-flex!important;align-items:center!important;width:auto!important;margin:0!important;" } do |form| %>
      <div class="app-list-upload-inline" style="display:inline-flex!important;align-items:center!important;gap:8px!important;width:auto!important;">
        <%= form.file_field :file, accept: ".csv,.xls,.xlsx", class: "app-list-file-input", style: "width:170px!important;max-width:170px!important;min-height:36px!important;font-size:13px!important;" %>
        <%= form.submit "Upload File", class: "app-form-submit", style: "min-height:36px!important;padding:6px 12px!important;font-size:14px!important;white-space:nowrap!important;" %>
      </div>
    <% end %>
  </div>

  <div class="app-list-control-action" style="display:inline-flex!important;flex:0 0 auto!important;width:auto!important;">
    <%= form_with url: destroy_selected_office_categories_path, method: :delete, local: true, id: "bulk-delete-office-structures", data: { bulk_delete_form: true }, html: { style: "display:inline-flex!important;margin:0!important;" } do %>
      <%= submit_tag "Delete Selected", class: "app-danger-btn", data: { turbo_confirm: "Delete selected office structures?" }, style: "min-height:36px!important;padding:6px 12px!important;font-size:14px!important;white-space:nowrap!important;" %>
    <% end %>
  </div>

  <div class="app-list-control-search" data-table-search-slot="office-structure-records" style="display:inline-flex!important;flex:0 1 380px!important;width:380px!important;margin-left:0!important;">
    <%= render "shared/table_search", placeholder: "Search office structures..." %>
  </div>
</div>

<div class="app-table-wrap" data-search-placeholder="Search office structures..." data-search-slot="office-structure-records" data-server-search="true" data-table-search="false">
  <table class="table app-table">
    <thead>
      <tr>
        <th>
          <label class="app-bulk-select-all">
            <%= check_box_tag :select_all_office_structures, "1", false, data: { bulk_delete_select_all: true }, form: "bulk-delete-office-structures" %>
            <span>Select All</span>
          </label>
        </th>
        <th>Stakeholder</th>
        <th>Category Name</th>
        <th>Parent Office</th>
        <th>State</th>
        <th>District</th>
        <th>Block</th>
        <th>Name</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% @office_categories.each do |office_category| %>
        <tr>
          <td><%= check_box_tag "office_category_ids[]", office_category.id, false, data: { bulk_delete_checkbox: true }, form: "bulk-delete-office-structures" %></td>
          <td><%= office_category.stakeholder_category&.name || "-" %></td>
          <td><%= office_category.office_category_master_name || "-" %></td>
          <td><%= office_category.parent&.display_name || "-" %></td>
          <td><%= office_category.state&.name || "-" %></td>
          <td><%= office_category.district&.name || "-" %></td>
          <td><%= office_category.block&.name || "-" %></td>
          <td><%= office_category.name.presence || "-" %></td>
          <td class="app-row-actions">
            <%= link_to "Edit", edit_office_category_path(office_category) %> |
            <%= button_to "Delete", office_category_path(office_category), method: :delete, data: { turbo_confirm: "Delete this office structure?" }, class: "app-action-button app-delete-button" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render "shared/table_pagination", pagination: @pagination %>
