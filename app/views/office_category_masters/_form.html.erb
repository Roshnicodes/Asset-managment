<%= form_with(model: office_category_master) do |form| %>
  <div class="app-form-card">
    <% if office_category_master.errors.any? %>
      <div class="app-form-errors">
        <h2><%= pluralize(office_category_master.errors.count, "error") %> found</h2>
        <ul>
          <% office_category_master.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="app-form-grid two-col">
      <div class="app-form-field">
        <%= form.label :stakeholder_category_id, "Stakeholder" %>
        <%= form.collection_select :stakeholder_category_id, @stakeholders, :id, :name, { prompt: "Select stakeholder" } %>
      </div>

      <div class="app-form-field">
        <%= form.label :name, "Category Name" %>
        <%= form.text_field :name, placeholder: "PMU / FCO / TO / Cluster" %>
      </div>
    </div>

    <div class="app-form-actions">
      <%= form.submit "Save Office Category Master", class: "app-form-submit" %>
    </div>
  </div>
<% end %>
