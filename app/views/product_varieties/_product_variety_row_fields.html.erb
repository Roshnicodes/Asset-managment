<div class="product-batch-row" data-product-row>
  <div class="product-batch-row-header">
    <div class="product-batch-row-title">
      <span>Product Type</span>
      <strong data-product-row-number><%= index.to_i + 1 unless index.to_s == "NEW_RECORD" %></strong>
    </div>
    <button type="button" class="product-batch-remove-button" data-remove-product-row>Remove</button>
  </div>

  <% if product_variety.errors.any? %>
    <div class="product-batch-row-errors">
      <%= product_variety.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="app-form-grid two-col">
    <div class="app-form-field <%= "has-error" if product_variety.errors[:product_type_code].any? %>">
      <%= label_tag "product_varieties_#{index}_product_type_code", "Product Type Code" %>
      <%= text_field_tag "product_varieties[#{index}][product_type_code]", product_variety.product_type_code, id: "product_varieties_#{index}_product_type_code", class: "form-control", placeholder: "Enter product type code" %>
    </div>

    <div class="app-form-field <%= "has-error" if product_variety.errors[:name].any? %>">
      <%= label_tag "product_varieties_#{index}_name", "Product Company" %>
      <%= text_field_tag "product_varieties[#{index}][name]", product_variety.name, id: "product_varieties_#{index}_name", class: "form-control" %>
    </div>
  </div>
</div>
