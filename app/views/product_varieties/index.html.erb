<section class="catalog-index-page">
  <div class="app-toolbar catalog-toolbar">
    <h1>Product Type Entry</h1>
    <%= link_to "Add Product Type", new_product_variety_path, class: "app-primary-btn" %>
  </div>

  <div class="app-table-wrap catalog-table-wrap">
    <table class="table app-table catalog-table">
      <thead>
        <tr>
          <th>Thematic Type</th>
          <th>Product</th>
          <th>Product Type Code</th>
          <th>Product Company</th>
          <% if admin_user? %>
            <th>Action</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @product_varieties.each do |product_variety| %>
          <tr>
            <td><%= product_variety.theme&.name %></td>
            <td><%= product_variety.product&.name %></td>
            <td><%= product_variety.product_type_code.presence || "-" %></td>
            <td><%= product_variety.name %></td>
            <% if admin_user? %>
              <td class="app-row-actions">
                <%= link_to "Edit", edit_product_variety_path(product_variety) %> |
                <%= button_to "Delete", product_variety_path(product_variety), method: :delete, data: { turbo_confirm: "Delete this product type?" }, class: "app-action-button app-delete-button" %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
