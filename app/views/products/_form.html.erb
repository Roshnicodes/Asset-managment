<% if product.persisted? %>
  <%= form_with(model: product, local: true) do |f| %>
    <div class="app-form-card">
      <div class="app-form-grid two-col">
        <div class="app-form-field">
          <%= f.label :stakeholder_category_id, "Stakeholder" %>
          <% if admin_user? && current_employee_master&.stakeholder_category_id.blank? %>
            <%= f.collection_select :stakeholder_category_id, @stakeholders, :id, :name, { prompt: "Select stakeholder" }, class: "form-control" %>
          <% else %>
            <div class="app-readonly-value"><%= current_employee_master&.stakeholder_category&.name || "-" %></div>
            <%= f.hidden_field :stakeholder_category_id, value: current_employee_master&.stakeholder_category_id %>
          <% end %>
        </div>

        <div class="app-form-field">
          <%= f.label :theme_id, "Thematic Type" %>
          <%= f.collection_select :theme_id, @themes, :id, :name, { prompt: "Select thematic type" }, class: "form-control" %>
        </div>

        <div class="app-form-field">
          <%= f.label :name, "Product Name" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="app-form-field">
          <%= f.label :product_code, "Product Code" %>
          <%= f.text_field :product_code, class: "form-control", placeholder: "Enter product code" %>
        </div>

        <div class="app-form-field">
          <%= f.label :description, "Description" %>
          <%= f.text_area :description, class: "form-control", rows: 3 %>
        </div>
      </div>

      <div class="app-form-actions">
        <%= f.submit "Save Product", class: "app-form-submit" %>
      </div>
    </div>
  <% end %>
<% else %>
  <% product_rows = Array(@products.presence || [product]) %>
  <% batch_context = (@product_batch_context || {}).to_h.with_indifferent_access %>
  <% batch_stakeholder_id = batch_context[:stakeholder_category_id].presence || current_employee_master&.stakeholder_category_id %>
  <% batch_theme_id = batch_context[:theme_id].presence || product_rows.find { |row| row.theme_id.present? }&.theme_id %>
  <%= form_with(url: products_path, method: :post, local: true, class: "product-batch-form", data: { product_batch_form: true }) do %>
  <div class="app-form-card product-batch-card">
    <div class="product-batch-toolbar">
      <div class="product-batch-toolbar-title">
        <strong>Products</strong>
        <span data-product-row-count><%= product_rows.size %></span>
      </div>
    </div>

    <div class="product-batch-context">
      <div class="app-form-field">
        <%= label_tag "product_batch_stakeholder_category_id", "Stakeholder" %>
        <% if admin_user? && current_employee_master&.stakeholder_category_id.blank? %>
          <%= select_tag "product_batch[stakeholder_category_id]",
                options_from_collection_for_select(@stakeholders, :id, :name, batch_stakeholder_id),
                include_blank: "Select stakeholder",
                id: "product_batch_stakeholder_category_id",
                class: "form-control" %>
        <% else %>
          <div class="app-readonly-value"><%= current_employee_master&.stakeholder_category&.name || "-" %></div>
          <%= hidden_field_tag "product_batch[stakeholder_category_id]", batch_stakeholder_id, id: "product_batch_stakeholder_category_id" %>
        <% end %>
      </div>

      <div class="app-form-field">
        <%= label_tag "product_batch_theme_id", "Thematic Type" %>
        <%= select_tag "product_batch[theme_id]",
              options_from_collection_for_select(@themes, :id, :name, batch_theme_id),
              include_blank: "Select thematic type",
              id: "product_batch_theme_id",
              required: true,
              class: "form-control" %>
      </div>
    </div>

    <div class="product-batch-rows" data-product-rows>
      <% product_rows.each_with_index do |product_row, index| %>
        <%= render "products/product_row_fields", product: product_row, index: index %>
      <% end %>
    </div>

    <template data-product-row-template>
      <%= render "products/product_row_fields", product: Product.new, index: "NEW_RECORD" %>
    </template>

    <div class="app-form-actions product-batch-actions">
      <button type="button" class="app-secondary-btn product-batch-add-button" data-add-product-row>+ Add New</button>
      <%= submit_tag "Save Products", class: "app-form-submit" %>
    </div>
  </div>
  <% end %>

  <style>
    .product-batch-form .product-batch-card {
      padding: 0 !important;
      overflow: hidden !important;
      border: 1px solid rgba(11, 74, 79, 0.18) !important;
      border-radius: 8px !important;
      background: #ffffff !important;
      box-shadow: none !important;
    }

    .product-batch-form .product-batch-toolbar {
      display: flex !important;
      align-items: center !important;
      justify-content: flex-start !important;
      gap: 1rem !important;
      padding: 0.75rem 1rem !important;
      border-bottom: 1px solid rgba(11, 74, 79, 0.12) !important;
      background: #f8fbf9 !important;
    }

    .product-batch-form .product-batch-toolbar-title {
      display: inline-flex !important;
      align-items: center !important;
      gap: 0.7rem !important;
      min-width: 0 !important;
    }

    .product-batch-form .product-batch-toolbar-title strong {
      color: var(--brand-deep) !important;
      font-size: 1rem !important;
      font-weight: 800 !important;
    }

    .product-batch-form .product-batch-toolbar-title span {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      min-width: 2rem !important;
      height: 1.8rem !important;
      padding: 0 0.6rem !important;
      border-radius: 999px !important;
      background: rgba(242, 177, 52, 0.2) !important;
      color: #6b4500 !important;
      font-size: 0.86rem !important;
      font-weight: 800 !important;
    }

    .product-batch-form .product-batch-add-button {
      min-height: 2.45rem !important;
      padding: 0.62rem 1rem !important;
      border: 1px solid rgba(11, 74, 79, 0.24) !important;
      border-radius: 8px !important;
      background: #ffffff !important;
      color: var(--brand-deep) !important;
      font-weight: 800 !important;
      white-space: nowrap !important;
    }

    .product-batch-form .product-batch-add-button:hover {
      background: rgba(11, 74, 79, 0.06) !important;
    }

    .product-batch-form .product-batch-rows {
      display: grid !important;
      gap: 0.65rem !important;
      padding: 0.75rem 1rem !important;
      background: #fbfdfc !important;
    }

    .product-batch-form .product-batch-context {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
      gap: 0.75rem 1rem !important;
      padding: 0.75rem 1rem !important;
      border-bottom: 1px solid rgba(11, 74, 79, 0.1) !important;
      background: #ffffff !important;
    }

    .product-batch-form .product-batch-row {
      display: grid !important;
      gap: 0.72rem !important;
      border: 1px solid rgba(11, 74, 79, 0.14) !important;
      border-left: 4px solid var(--brand-accent) !important;
      border-radius: 8px !important;
      padding: 0.8rem 0.95rem !important;
      background: #ffffff !important;
      box-shadow: 0 8px 20px rgba(11, 74, 79, 0.05) !important;
    }

    .product-batch-form .product-batch-row-header {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 1rem !important;
    }

    .product-batch-form .product-batch-row-title {
      display: inline-flex !important;
      align-items: center !important;
      gap: 0.55rem !important;
      color: var(--brand-deep) !important;
      font-weight: 800 !important;
    }

    .product-batch-form .product-batch-row-title strong {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      min-width: 1.9rem !important;
      height: 1.9rem !important;
      border-radius: 999px !important;
      background: rgba(11, 74, 79, 0.1) !important;
      color: var(--brand-deep) !important;
      font-size: 0.9rem !important;
    }

    .product-batch-form .product-batch-remove-button {
      border: 1px solid rgba(185, 28, 28, 0.18) !important;
      border-radius: 8px !important;
      padding: 0.58rem 0.85rem !important;
      background: #fff7f7 !important;
      color: #9f1d1d !important;
      font: inherit !important;
      font-size: 0.9rem !important;
      font-weight: 800 !important;
      line-height: 1 !important;
    }

    .product-batch-form .product-batch-remove-button:hover {
      background: #fee2e2 !important;
    }

    .product-batch-form .product-batch-rows > .product-batch-row:only-child .product-batch-remove-button,
    .product-batch-form .product-batch-remove-button[hidden] {
      display: none !important;
    }

    .product-batch-form .product-batch-row .app-form-grid.two-col {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
      gap: 0.65rem 1rem !important;
    }

    .product-batch-form .product-batch-description-field {
      grid-column: 1 / -1 !important;
    }

    .product-batch-form .product-batch-description-field textarea.form-control {
      height: 58px !important;
      min-height: 58px !important;
      max-height: 90px !important;
      resize: vertical !important;
    }

    .product-batch-form .product-batch-row-errors {
      padding: 0.75rem 0.9rem !important;
      border: 1px solid rgba(185, 28, 28, 0.22) !important;
      border-radius: 8px !important;
      background: rgba(254, 242, 242, 0.88) !important;
      color: #991b1b !important;
      font-size: 0.95rem !important;
      font-weight: 700 !important;
    }

    .product-batch-form .product-batch-actions {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 1rem !important;
      margin: 0 !important;
      padding: 0.75rem 1rem !important;
      border-top: 1px solid rgba(11, 74, 79, 0.12) !important;
      background: #ffffff !important;
    }

    @media screen and (max-width: 820px) {
      .product-batch-form .product-batch-toolbar,
      .product-batch-form .product-batch-row-header {
        align-items: stretch !important;
        flex-direction: column !important;
      }

      .product-batch-form .product-batch-add-button,
      .product-batch-form .product-batch-remove-button,
      .product-batch-form .product-batch-actions .app-form-submit {
        width: 100% !important;
      }

      .product-batch-form .product-batch-actions {
        align-items: stretch !important;
        flex-direction: column !important;
      }

      .product-batch-form .product-batch-row .app-form-grid.two-col {
        grid-template-columns: 1fr !important;
      }

      .product-batch-form .product-batch-context {
        grid-template-columns: 1fr !important;
      }

      .product-batch-form .product-batch-description-field {
        grid-column: auto !important;
      }
    }
  </style>

  <script>
    (function() {
      function setupProductBatchForm() {
        document.querySelectorAll("[data-product-batch-form]").forEach(function(form) {
          if (form.dataset.productBatchReady === "true") return;

          var rowsContainer = form.querySelector("[data-product-rows]");
          var template = form.querySelector("[data-product-row-template]");
          var addButton = form.querySelector("[data-add-product-row]");
          var rowCount = form.querySelector("[data-product-row-count]");

          if (!rowsContainer || !template || !addButton) return;

          var nextIndex = rowsContainer.querySelectorAll("[data-product-row]").length;

          function syncRows() {
            var rows = Array.prototype.slice.call(rowsContainer.querySelectorAll("[data-product-row]"));

            if (rowCount) rowCount.textContent = String(rows.length);

            rows.forEach(function(row, index) {
              var number = row.querySelector("[data-product-row-number]");
              var removeButton = row.querySelector("[data-remove-product-row]");

              if (number) number.textContent = String(index + 1);
              if (removeButton) removeButton.hidden = rows.length === 1;
            });
          }

          addButton.addEventListener("click", function() {
            var html = template.innerHTML.split("NEW_RECORD").join(String(nextIndex));
            nextIndex += 1;

            rowsContainer.insertAdjacentHTML("beforeend", html);
            syncRows();

            var lastRow = rowsContainer.querySelector("[data-product-row]:last-child");
            var firstField = lastRow && lastRow.querySelector("select, input[type='text'], textarea");
            if (firstField) firstField.focus();
          });

          rowsContainer.addEventListener("click", function(event) {
            var target = event.target;
            var removeButton = target && target.closest ? target.closest("[data-remove-product-row]") : null;
            if (!removeButton) return;

            var rows = rowsContainer.querySelectorAll("[data-product-row]");
            if (rows.length <= 1) return;

            var row = removeButton.closest("[data-product-row]");
            if (row) row.remove();
            syncRows();
          });

          form.dataset.productBatchReady = "true";
          syncRows();
        });
      }

      document.addEventListener("turbo:load", setupProductBatchForm);
      document.addEventListener("DOMContentLoaded", setupProductBatchForm);
      setupProductBatchForm();
    })();
  </script>
<% end %>
