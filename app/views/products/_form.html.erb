<%= form_with(model: product, local: true) do |f| %>
  <div class="app-form-card">
    <div class="app-form-grid two-col">
      <div class="app-form-field">
        <%= f.label :stakeholder_category_id, "Stakeholder" %>
        <% if admin_user? %>
          <%= f.collection_select :stakeholder_category_id, @stakeholders, :id, :name, { prompt: "Select stakeholder" }, class: "form-control" %>
        <% else %>
          <div class="app-readonly-value"><%= current_employee_master&.stakeholder_category&.name || "-" %></div>
          <%= f.hidden_field :stakeholder_category_id, value: current_employee_master&.stakeholder_category_id %>
        <% end %>
      </div>

      <div class="app-form-field">
        <%= f.label :theme_id, "Thematic Type" %>
        <%= f.collection_select :theme_id, @themes, :id, :name, { prompt: "Select thematic type" }, class: "form-control" %>
      </div>

      <div class="app-form-field">
        <%= f.label :name, "Product Name" %>
        <%= f.text_field :name, class: "form-control" %>
      </div>

      <div class="app-form-field">
        <%= f.label :product_code, "Product Code" %>
        <%= f.text_field :product_code, class: "form-control", placeholder: "Enter product code" %>
      </div>

      <div class="app-form-field">
        <%= f.label :description, "Description" %>
        <%= f.text_area :description, class: "form-control", rows: 3 %>
      </div>
    </div>

    <div class="app-form-actions">
      <%= f.submit "Save Product", class: "app-form-submit" %>
    </div>
  </div>
<% end %>
