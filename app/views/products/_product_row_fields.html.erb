<div class="product-batch-row" data-product-row>
  <div class="product-batch-row-header">
    <div class="product-batch-row-title">
      <span>Product</span>
      <strong data-product-row-number><%= index.to_i + 1 unless index.to_s == "NEW_RECORD" %></strong>
    </div>
    <button type="button" class="product-batch-remove-button" data-remove-product-row>Remove</button>
  </div>

  <% if product.errors.any? %>
    <div class="product-batch-row-errors">
      <%= product.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="app-form-grid two-col">
    <div class="app-form-field <%= "has-error" if product.errors[:name].any? %>">
      <%= label_tag "products_#{index}_name", "Product Name" %>
      <%= text_field_tag "products[#{index}][name]", product.name, id: "products_#{index}_name", class: "form-control" %>
    </div>

    <div class="app-form-field <%= "has-error" if product.errors[:product_code].any? %>">
      <%= label_tag "products_#{index}_product_code", "Product Code" %>
      <%= text_field_tag "products[#{index}][product_code]", product.product_code, id: "products_#{index}_product_code", class: "form-control", placeholder: "Enter product code" %>
    </div>
  </div>
</div>
