<% otp_verified = @otp_verified_for_render || false %>

<style>
  .po-otp-shell {
    display: grid;
    gap: 1.25rem;
    width: 100%;
    max-width: 900px;
    margin: 2rem auto 0;
    padding: clamp(1rem, 2vw, 1.25rem);
    border: 1px solid #d7e5de;
    border-radius: 30px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(245, 250, 247, 0.96));
    box-shadow: 0 20px 46px rgba(20, 56, 43, 0.08);
  }

  .po-otp-card {
    display: grid;
    grid-template-columns: minmax(250px, 0.86fr) minmax(300px, 1.14fr);
    overflow: hidden;
    border: 1px solid #d8e7df;
    border-radius: 26px;
    background: #fff;
    box-shadow: 0 12px 30px rgba(17, 59, 37, 0.06);
  }

  .po-otp-side {
    position: relative;
    display: flex;
    min-height: 330px;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.35rem;
    padding: clamp(1.2rem, 3vw, 1.7rem);
    background:
      radial-gradient(circle at 86% 12%, rgba(216, 242, 226, 0.22), transparent 6rem),
      radial-gradient(circle at top left, rgba(255, 255, 255, 0.24), transparent 17rem),
      linear-gradient(145deg, #0f5f38, #174630);
    color: #fff;
  }

  .po-otp-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #d8f2e2;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .po-otp-eyebrow::before {
    content: "";
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: #d8f2e2;
    box-shadow: 0 0 0 0.35rem rgba(216, 242, 226, 0.13);
  }

  .po-otp-title {
    margin: 0.55rem 0 0;
    font-size: clamp(1.7rem, 3.6vw, 2.35rem);
    font-weight: 850;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .po-otp-copy {
    margin: 0.75rem 0 0;
    color: rgba(255, 255, 255, 0.84);
    line-height: 1.7;
  }

  .po-otp-mark {
    display: grid;
    width: 108px;
    height: 108px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      0 18px 36px rgba(6, 38, 22, 0.2);
    color: #ffffff;
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .po-otp-mini {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.45rem;
    padding: 0.58rem 0.82rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.82rem;
    font-weight: 750;
  }

  .po-otp-mini::before {
    content: "";
    width: 0.46rem;
    height: 0.46rem;
    border-radius: 50%;
    background: #b9f3cc;
  }

  .po-otp-form {
    display: grid;
    align-content: center;
    padding: clamp(1.2rem, 3vw, 1.7rem);
    background: linear-gradient(180deg, #ffffff, #fbfdfc);
  }

  .po-otp-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin-bottom: 1rem;
  }

  .po-otp-fact {
    min-width: 0;
    padding: 1rem;
    border: 1px solid #dbe8e1;
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 252, 249, 0.98));
    box-shadow: none;
  }

  .po-otp-field label {
    margin-bottom: 0.45rem;
    color: #18382a;
    font-weight: 800;
  }

  .po-otp-input {
    min-height: 54px;
    border-radius: 16px;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.25em;
    text-align: center;
  }

  .po-otp-input::placeholder {
    color: #9aaea2;
    letter-spacing: 0.08em;
  }

  .po-otp-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.85rem;
  }

  .po-otp-submit,
  .po-otp-resend {
    min-height: 50px;
    border-radius: 999px;
  }

  .po-otp-resend-wrap {
    margin-top: 0.75rem;
  }

  .po-otp-resend-wrap form {
    margin: 0;
  }

  <% if otp_verified || @purchase_order_expired %>
    .public-qr-main {
      width: min(100%, 1040px);
      max-width: 1040px;
      box-sizing: border-box;
      margin: 1.2rem auto 2rem;
      padding: clamp(0.85rem, 2vw, 1.2rem);
      border: 1px solid #d7e5de;
      border-radius: 26px;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(247, 251, 248, 0.98));
      box-shadow: 0 22px 50px rgba(20, 56, 43, 0.08);
    }

    .public-qr-flash-stack {
      margin-bottom: 0.85rem;
    }
  <% end %>

  .po-vendor-page-box {
    display: grid;
    gap: 1rem;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .po-vendor-sheet-frame {
    overflow-x: auto;
    overflow-y: visible;
    max-height: none;
    padding: 0.65rem;
    border: 1px solid #e0ebe5;
    border-radius: 18px;
    background: #f8fbf9;
  }

  .po-vendor-sheet-frame .po-sheet {
    margin: 0 auto;
  }

  .po-vendor-response-card {
    display: grid;
    gap: 0.85rem;
    width: min(100%, 820px);
    margin: 0 auto;
    padding: 1rem;
    border: 1px solid #d7e5de;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: none;
  }

  .po-vendor-response-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #e1eee7;
  }

  .po-vendor-response-title {
    margin: 0;
    color: #122f23;
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .po-vendor-response-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    justify-content: flex-end;
  }

  .po-vendor-response-pill {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0.36rem 0.68rem;
    border: 1px solid #dbe8e1;
    border-radius: 999px;
    background: #f7fbf8;
    color: #314a3b;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .po-vendor-response-section {
    padding: 0.85rem;
    border: 1px solid #dbe8e1;
    border-radius: 16px;
    background: #fbfdfc;
  }

  .po-vendor-response-section--danger {
    border-color: #f0d6d6;
    background: #fff8f8;
    color: #8a2f2f;
  }

  .po-vendor-response-section-title {
    margin: 0 0 0.65rem;
    color: #173c28;
    font-size: 1rem;
    font-weight: 800;
  }

  .po-vendor-response-form textarea {
    min-height: 96px;
    border-radius: 14px;
  }

  .po-vendor-response-actions {
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .po-vendor-response-actions .app-form-submit,
  .po-vendor-response-actions .app-secondary-btn {
    min-height: 42px;
    padding: 0.58rem 1rem;
    border-radius: 999px;
  }

  .po-vendor-timeline {
    overflow: hidden;
    border: 1px solid #dbe8e1;
    border-radius: 16px;
    background: #ffffff;
  }

  .po-vendor-timeline-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.82rem 0.9rem;
    cursor: pointer;
    list-style: none;
    background: #f4faf6;
    color: #173c28;
    font-weight: 800;
  }

  .po-vendor-timeline-summary::-webkit-details-marker {
    display: none;
  }

  .po-vendor-timeline-summary::after {
    content: "Show";
    padding: 0.22rem 0.55rem;
    border: 1px solid #cfe0d6;
    border-radius: 999px;
    background: #ffffff;
    color: #38654b;
    font-size: 0.76rem;
    font-weight: 800;
  }

  .po-vendor-timeline[open] .po-vendor-timeline-summary::after {
    content: "Hide";
  }

  .po-vendor-timeline-count {
    margin-left: auto;
    color: #66786d;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .po-vendor-timeline-list {
    display: grid;
    gap: 0.55rem;
    padding: 0.75rem;
  }

  .po-vendor-timeline-item {
    padding: 0.75rem 0.85rem;
    border: 1px solid #e0ebe5;
    border-radius: 14px;
    background: #fbfdfc;
  }

  .po-vendor-timeline-head {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .po-vendor-timeline-actor {
    color: #173c28;
    font-weight: 800;
  }

  .po-vendor-timeline-action {
    margin-top: 0.35rem;
    color: #1d2c23;
    font-weight: 700;
  }

  .po-vendor-timeline-note {
    margin-top: 0.35rem;
    color: #5f7167;
    white-space: pre-wrap;
  }

  @media (max-width: 900px) {
    .po-otp-card,
    .po-otp-facts {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .po-otp-shell {
      padding: 0.9rem;
      border-radius: 24px;
    }

    .po-otp-side,
    .po-otp-form {
      padding: 1rem;
    }

    .po-otp-side {
      min-height: auto;
      align-items: flex-start;
      border-radius: 22px 22px 0 0;
    }

    .po-otp-mark {
      width: 78px;
      height: 78px;
      border-radius: 24px;
      font-size: 1rem;
    }

    .po-otp-title {
      font-size: clamp(1.45rem, 8vw, 1.9rem);
    }

    .po-otp-mini,
    .po-otp-actions,
    .po-otp-resend-wrap form,
    .po-otp-submit,
    .po-otp-resend {
      width: 100%;
    }

    .po-otp-mini,
    .po-otp-submit,
    .po-otp-resend {
      justify-content: center;
    }

    .po-vendor-response-card {
      padding: 0.8rem;
      border-radius: 18px;
    }

    .po-vendor-page-box {
      gap: 0.75rem;
    }

    .public-qr-main {
      margin-top: 0.85rem;
      padding: 0.65rem;
      border-radius: 20px;
    }

    .po-vendor-sheet-frame {
      padding: 0.45rem;
      border-radius: 16px;
    }

    .po-vendor-response-header,
    .po-vendor-response-meta,
    .po-vendor-response-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .po-vendor-response-actions .app-form-submit,
    .po-vendor-response-actions .app-secondary-btn {
      width: 100%;
    }
  }
</style>

<% if otp_verified || @purchase_order_expired %>
  <div class="po-vendor-page-box">
    <div class="po-vendor-sheet-frame">
      <%= render "quotation_proposals/purchase_order_sheet",
            proposal_vendor: @quotation_proposal_vendor,
            quotation_proposal: @quotation_proposal,
            purchase_order_year_label: @purchase_order_year_label,
            authorized_by: @quotation_proposal_vendor.purchase_order_authorized_by,
            po_payment_terms: @po_payment_terms,
            po_completion_terms: @po_completion_terms,
            po_warranty_terms: @po_warranty_terms,
            po_earnest_money_terms: @po_earnest_money_terms,
            show_terms_acceptance_checkbox: !@purchase_order_expired && @quotation_proposal_vendor.purchase_order_status.in?(%w[sent returned]),
            purchase_order_form_id: "purchase_order_response_form" %>
    </div>

    <div class="po-vendor-response-card">
      <div class="po-vendor-response-header">
        <h2 class="po-vendor-response-title">Response Workspace</h2>
        <div class="po-vendor-response-meta">
          <span class="po-vendor-response-pill">Status: <%= @quotation_proposal_vendor.purchase_order_status.to_s.humanize %></span>
          <span class="po-vendor-response-pill">Sent: <%= @quotation_proposal_vendor.purchase_order_sent_at&.strftime("%d-%m-%Y %H:%M") || "-" %></span>
          <span class="po-vendor-response-pill">Action: <%= @quotation_proposal_vendor.purchase_order_actioned_at&.strftime("%d-%m-%Y %H:%M") || "-" %></span>
          <span class="po-vendor-response-pill">Last date: <%= @quotation_proposal_vendor.purchase_order_due_date&.strftime("%d-%m-%Y") || "-" %></span>
        </div>
      </div>

      <% if @purchase_order_expired %>
        <div class="po-vendor-response-section po-vendor-response-section--danger">
          <div class="po-vendor-response-section-title">Response Closed</div>
          <div class="mt-1">The vendor response window closed on <%= @quotation_proposal_vendor.purchase_order_due_date&.strftime("%d-%m-%Y") || "-" %>.</div>
        </div>
      <% elsif @quotation_proposal_vendor.purchase_order_status.in?(%w[sent returned]) %>
        <div class="po-vendor-response-section">

          <%= form_with url: purchase_order_vendor_qr_path(@quotation_proposal_vendor.po_token, verified: 1), method: :patch, local: true, html: { id: "purchase_order_response_form", class: "po-vendor-response-form" } do %>
            <div class="mb-3">
              <label for="purchase_order_remark" class="form-label" style="font-weight: 700;">Remark</label>
              <%= text_area_tag :purchase_order_remark, @quotation_proposal_vendor.purchase_order_remark, rows: 4, class: "form-control", placeholder: "Add your detailed response remark here." %>
            </div>
            <div class="po-vendor-response-actions">
              <%= button_tag "Accept", name: :purchase_order_decision, value: "accepted", class: "app-form-submit", disabled: true, data: { vendor_terms_submit_button: true } %>
              <% unless @quotation_proposal_vendor.purchase_order_returned_once? %>
                <%= button_tag "Return", name: :purchase_order_decision, value: "returned", class: "app-secondary-btn", disabled: true, data: { vendor_terms_submit_button: true } %>
              <% end %>
              <%= button_tag "Reject", name: :purchase_order_decision, value: "rejected", class: "app-secondary-btn", style: "border-color: #dc3545; color: #dc3545;", disabled: true, data: { vendor_terms_submit_button: true } %>
            </div>
            <% if @quotation_proposal_vendor.purchase_order_returned_once? %>
              <div class="small text-muted mt-2">Return has already been used once. You can now accept or reject.</div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="po-vendor-response-section">
          <div class="d-flex gap-2 flex-wrap align-items-center">
            <strong>Status:</strong>
            <span class="badge border <%= @quotation_proposal_vendor.purchase_order_status == "accepted" ? "bg-success bg-opacity-10 text-success" : @quotation_proposal_vendor.purchase_order_status == "returned" ? "bg-warning bg-opacity-10 text-warning" : "bg-danger bg-opacity-10 text-danger" %>">
              <%= @quotation_proposal_vendor.purchase_order_status.humanize %>
            </span>
            <span class="small text-muted">Action at: <%= @quotation_proposal_vendor.purchase_order_actioned_at&.strftime("%d-%m-%Y %H:%M") || "-" %></span>
          </div>
          <% if @quotation_proposal_vendor.purchase_order_remark.present? %>
            <div class="mt-2"><strong>Remark:</strong> <%= @quotation_proposal_vendor.purchase_order_remark %></div>
          <% end %>
        </div>
      <% end %>

      <% if @quotation_proposal_vendor.purchase_order_reply.present? %>
        <div class="po-vendor-response-section">
          <div class="po-vendor-response-section-title">Reply From ASA</div>
          <div style="white-space: pre-wrap;"><%= @quotation_proposal_vendor.purchase_order_reply %></div>
          <div class="small text-muted mt-2">
            Updated by <%= @quotation_proposal_vendor.purchase_order_reply_updated_by&.name.presence || "ASA team" %> on
            <%= @quotation_proposal_vendor.purchase_order_reply_updated_at&.strftime("%d-%m-%Y %H:%M") || "-" %>
          </div>
        </div>
      <% end %>

      <% if @quotation_proposal_vendor.purchase_order_activities.any? %>
        <details class="po-vendor-timeline">
          <summary class="po-vendor-timeline-summary">
            <span>Response Timeline</span>
            <span class="po-vendor-timeline-count"><%= @quotation_proposal_vendor.purchase_order_activities.size %> updates</span>
          </summary>
          <div class="po-vendor-timeline-list">
            <% @quotation_proposal_vendor.purchase_order_activities.recent_first.each do |activity| %>
              <div class="po-vendor-timeline-item">
                <div class="po-vendor-timeline-head">
                  <div>
                    <strong class="po-vendor-timeline-actor"><%= activity.actor_name %></strong>
                    <span class="text-muted">(<%= activity.actor_role.presence || "Update" %>)</span>
                  </div>
                  <div class="small text-muted"><%= activity.occurred_at.strftime("%d-%m-%Y %H:%M") %></div>
                </div>
                <div class="po-vendor-timeline-action"><%= activity.action_type.to_s.humanize %></div>
                <% if activity.note.present? %>
                  <div class="po-vendor-timeline-note"><%= activity.note %></div>
                <% end %>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
  </div>

  <%= render "shared/vendor_terms_gate_script" %>
<% else %>
  <div class="po-otp-shell">
    <%= render "quotation_vendor_qrs/document_branding",
          vendor_name: (@vendor_registration.firm_name.presence || @vendor_registration.display_name),
          stakeholder_category: @stakeholder_category %>

    <section class="po-otp-card">
      <div class="po-otp-side">
        <div>
          <div class="po-otp-eyebrow">Secure Verification</div>
          <h1 class="po-otp-title">Purchase Order OTP Verification</h1>
          <p class="po-otp-copy">Enter the OTP sent to your registered mobile number to review the purchase order securely and continue.</p>
        </div>
        <div class="po-otp-mark">OTP</div>
        <div class="po-otp-mini">Protected purchase order access</div>
      </div>

      <div class="po-otp-form">
        <div class="po-otp-facts">
          <div class="app-detail-item po-otp-fact">
            <div class="app-detail-label">Mobile Number</div>
            <div class="app-detail-value"><%= @vendor_registration.mobile_no.presence || "-" %></div>
          </div>
          <div class="app-detail-item po-otp-fact">
            <div class="app-detail-label">Last OTP Sent At</div>
            <div class="app-detail-value"><%= @quotation_vendor_dispatch.latest_active_otp&.sent_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
          </div>
        </div>

        <%= form_with url: verify_purchase_order_vendor_qr_otp_path(@quotation_proposal_vendor.po_token), method: :post, local: true, data: { turbo: false } do |form| %>
          <div class="app-form-field po-otp-field">
            <%= form.label :otp_code, "Enter OTP" %>
            <%= form.text_field :otp_code, maxlength: 6, required: true, class: "form-control po-otp-input", inputmode: "numeric", autocomplete: "one-time-code", placeholder: "------" %>
          </div>
          <div class="po-otp-actions">
            <%= form.submit "Verify OTP", class: "app-form-submit po-otp-submit" %>
          </div>
        <% end %>

        <div class="po-otp-resend-wrap">
          <%= button_to "Send New OTP", send_purchase_order_vendor_qr_otp_path(@quotation_proposal_vendor.po_token), method: :post, class: "app-secondary-btn po-otp-resend", data: { turbo: false } %>
        </div>
      </div>
    </section>
  </div>
<% end %>
