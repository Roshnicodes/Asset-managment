<% step_level = form.object.level.to_i.positive? ? form.object.level.to_i : 1 %>
<% required_level = step_level <= 3 %>
<div class="app-form-field <%= "has-error" if form.object.errors[:employee_master].any? || form.object.errors[:employee_master_id].any? %>" data-quotation-committee-row style="<%= "display: none;" if form.object.marked_for_destruction? %>">
  <%= form.hidden_field :id if form.object.persisted? %>
  <%= form.hidden_field :_destroy, value: (form.object.marked_for_destruction? ? "1" : "false"), data: { committee_destroy: true } %>
  <%= form.hidden_field :level, value: form.object.level, data: { committee_level: true } %>

  <label data-committee-label><%= WorkflowLevelNaming.humanize_level_label(form.object.level || 1) %></label>
  <%= form.collection_select :employee_master_id, @committee_members, :id, :name, { prompt: "Select committee member" }, { required: required_level, data: { committee_member_select: true, validation_label: WorkflowLevelNaming.humanize_level_label(step_level) } } %>
  <% (form.object.errors[:employee_master] + form.object.errors[:employee_master_id]).uniq.each do |message| %>
    <div class="app-form-error"><%= message %></div>
  <% end %>
  <div class="app-form-error app-form-error-client" data-field-error="true"></div>

  <div class="app-approval-step-row-actions">
    <button type="button" class="app-action-button app-delete-button" data-remove-committee-step data-required-committee-level="<%= required_level %>">Remove Member</button>
  </div>
</div>
