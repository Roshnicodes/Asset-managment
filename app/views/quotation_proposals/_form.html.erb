<style>
  .app-static-paged-form { display: flex !important; flex-direction: column !important; height: 100% !important; max-height: 100% !important; min-height: 0 !important; overflow: hidden !important; }
  .app-static-page-toggle { position: absolute !important; opacity: 0 !important; pointer-events: none !important; }
  .app-static-page { display: none !important; flex: 1 1 auto !important; min-height: 0 !important; overflow: auto !important; padding-right: .35rem !important; }
  .app-rfp-table-wrap { max-height: 64vh; overflow: auto; border: 1px solid #dce8e2; border-radius: 14px; background: #fff; }
  .app-rfp-table-wrap table { margin-bottom: 0; }
  .app-rfp-table-wrap thead th { position: sticky; top: 0; z-index: 2; background: #f7fbf8; color: #064f45; font-weight: 800; }
  .app-rfp-form-table .app-rfp-table-label { width: 220px; padding: 0.95rem 1rem; background: #f7fbf8; font-weight: 800; color: #064f45; vertical-align: top; white-space: nowrap; }
  .app-rfp-form-table .app-rfp-table-value { padding: 0.85rem 1rem; vertical-align: top; }
  .app-rfp-form-table .app-rfp-cell-field { gap: 0.25rem; }
  .app-rfp-form-table .app-rfp-cell-field > label { font-size: 0.82rem; }
  .app-rfp-items-table tbody tr + tr td,
  .app-rfp-committee-table tbody tr + tr td { border-top: 1px solid #edf3ef; }
  .app-rfp-items-table .app-rfp-table-cell,
  .app-rfp-committee-table .app-rfp-table-cell { padding: 0.85rem 0.95rem; vertical-align: top; }
  .app-rfp-committee-table .app-rfp-table-cell--level { width: 180px; background: #f7fbf8; font-weight: 800; color: #064f45; }
  .app-rfp-items-table .app-rfp-table-cell--action,
  .app-rfp-committee-table .app-rfp-table-cell--action { width: 140px; text-align: center; vertical-align: middle; }
  .app-rfp-items-table .app-rfp-cell-field,
  .app-rfp-committee-table .app-rfp-cell-field { margin: 0; padding: 0; border: 0; background: transparent; box-shadow: none; }
  .app-rfp-items-table .app-rfp-cell-field input:not([type="checkbox"]):not([type="radio"]),
  .app-rfp-items-table .app-rfp-cell-field select,
  .app-rfp-items-table .app-rfp-cell-field textarea,
  .app-rfp-committee-table .app-rfp-cell-field input:not([type="checkbox"]):not([type="radio"]),
  .app-rfp-committee-table .app-rfp-cell-field select,
  .app-rfp-committee-table .app-rfp-cell-field textarea { border-radius: 10px; }
  .app-rfp-items-table .app-rfp-table-cell--action .app-action-button,
  .app-rfp-committee-table .app-rfp-table-cell--action .app-action-button { width: 100%; }
  .app-static-pager-nav { flex: 0 0 auto !important; margin-top: 1rem !important; padding-top: 1rem !important; border-top: 1px solid #e2ece6 !important; background: rgba(255,255,255,.98) !important; }
  .app-static-pager-row { display: none !important; align-items: center !important; justify-content: space-between !important; gap: .8rem !important; flex-wrap: wrap !important; }
  .app-static-pager-status { color: var(--brand-deep) !important; font-weight: 800 !important; }
  .app-static-pager-actions { display: inline-flex !important; align-items: center !important; gap: .65rem !important; flex-wrap: wrap !important; margin-left: auto !important; }
  .app-static-pager-button { display: inline-flex !important; align-items: center !important; justify-content: center !important; min-width: 96px !important; min-height: 42px !important; padding: .65rem 1rem !important; border: 1px solid var(--border-soft) !important; border-radius: 10px !important; background: #fff !important; color: var(--brand-deep) !important; font-weight: 800 !important; cursor: pointer !important; }
  .app-static-pager-button-primary { border-color: #0f5f52 !important; background: #0f5f52 !important; color: #fff !important; }
  #quotation-step-1:checked ~ .quotation-page-1, #quotation-step-2:checked ~ .quotation-page-2, #quotation-step-3:checked ~ .quotation-page-3, #quotation-step-4:checked ~ .quotation-page-4, #quotation-step-5:checked ~ .quotation-page-5 { display: flex !important; flex-direction: column !important; }
  #quotation-step-1:checked ~ .app-static-pager-nav .quotation-nav-1, #quotation-step-2:checked ~ .app-static-pager-nav .quotation-nav-2, #quotation-step-3:checked ~ .app-static-pager-nav .quotation-nav-3, #quotation-step-4:checked ~ .app-static-pager-nav .quotation-nav-4, #quotation-step-5:checked ~ .app-static-pager-nav .quotation-nav-5 { display: flex !important; }
</style>

<%= form_with(model: quotation_proposal, html: { class: "app-rfp-form", data: { quotation_validation_form: true, ui_form_pager: true }, novalidate: true }) do |form| %>
  <% approval_request = quotation_proposal.approval_request %>
  <% field_errors = ->(field_name) { quotation_proposal.errors.full_messages_for(field_name) } %>
  <% selected_criterion_ids = Array(@selected_vendor_selection_criterion_ids).map(&:to_i) %>

  <% if approval_request&.employee_return_pending? %>
    <div class="app-form-card" style="margin-bottom: 1.5rem;">
      <div class="app-page-header app-subsection-header-tight">
        <div>
          <h3 style="margin-bottom: 0.35rem;">Returned To Employee</h3>
          <p class="app-section-note mb-0">Review the return remark, update the quotation, and save to restart the same approval chain.</p>
        </div>
      </div>

      <div class="app-detail-grid">
        <div class="app-detail-item">
          <div class="app-detail-label">Returned By</div>
          <div class="app-detail-value"><%= approval_request.employee_return_actor_label %></div>
        </div>

        <div class="app-detail-item app-detail-item-full">
          <div class="app-detail-label">Return Remark</div>
          <div class="app-detail-value" style="white-space: pre-wrap;"><%= approval_request.employee_return_remark.presence || "No remark was added." %></div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="app-form-card app-form-card-wide app-rfp-card app-static-paged-form">
    <input type="radio" name="quotation_proposal_form_step" id="quotation-step-1" class="app-static-page-toggle" checked>
    <input type="radio" name="quotation_proposal_form_step" id="quotation-step-2" class="app-static-page-toggle">
    <input type="radio" name="quotation_proposal_form_step" id="quotation-step-3" class="app-static-page-toggle">
    <input type="radio" name="quotation_proposal_form_step" id="quotation-step-4" class="app-static-page-toggle">
    <input type="radio" name="quotation_proposal_form_step" id="quotation-step-5" class="app-static-page-toggle">
    <div class="app-static-page quotation-page-1">
    <% if quotation_proposal.errors.any? %>
      <div class="app-form-errors">
        <h2><%= pluralize(quotation_proposal.errors.count, "error") %> found</h2>
        <ul>
          <% quotation_proposal.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="app-rfp-table-wrap">
      <table class="table app-table app-rfp-form-table">
        <tbody>
          <tr>
            <th scope="row" class="app-rfp-table-label">Quotation Value</th>
            <td class="app-rfp-table-value">
              <div class="app-form-field app-rfp-cell-field">
                <%= form.label :procurement_amount_bucket, "Quotation Value", class: "visually-hidden" %>
                <%= form.select :procurement_amount_bucket, [["Above 10K", "above_10k"], ["Below 10K", "below_10k"]], {}, class: "form-control", id: "quotation_proposal_procurement_amount_bucket" %>
              </div>
            </td>
          </tr>

          <tr>
            <th scope="row" class="app-rfp-table-label">Select Theme</th>
            <td class="app-rfp-table-value">
              <div class="app-form-field app-rfp-cell-field">
                <%= form.label :theme_id, "Select Theme", class: "visually-hidden" %>
                <%= form.select :theme_id,
                                options_for_select(
                                  @themes.map do |theme|
                                    stakeholder_name = theme.stakeholder_category&.name.to_s.strip.presence
                                    theme_label = stakeholder_name.present? ? "#{theme.name} (#{stakeholder_name})" : theme.name
                                    [theme_label, theme.id, { "data-stakeholder-id": theme.stakeholder_category_id }]
                                  end,
                                  quotation_proposal.theme_id
                                ),
                                { prompt: "Select theme" },
                                { id: "quotation_proposal_theme_id", required: true, data: { validation_label: "Select Theme" } } %>
                <% (field_errors.call(:theme) + field_errors.call(:theme_id)).uniq.each do |message| %>
                  <div class="app-form-error"><%= message %></div>
                <% end %>
                <div class="app-form-error app-form-error-client" data-field-error="true"></div>
              </div>
            </td>
          </tr>

          <tr>
            <th scope="row" class="app-rfp-table-label">Quotation Subject</th>
            <td class="app-rfp-table-value">
              <div class="app-form-field app-rfp-cell-field <%= "has-error" if field_errors.call(:subject).any? %>">
                <%= form.label :subject, "Quotation Subject", class: "visually-hidden" %>
                <%= form.text_field :subject, required: true, data: { validation_label: "Quotation Subject" } %>
                <% field_errors.call(:subject).each do |message| %>
                  <div class="app-form-error"><%= message %></div>
                <% end %>
                <div class="app-form-error app-form-error-client" data-field-error="true"></div>
              </div>
            </td>
          </tr>

          <tr>
            <th scope="row" class="app-rfp-table-label">Proposal Ending Date</th>
            <td class="app-rfp-table-value">
              <div class="app-form-field app-rfp-cell-field <%= "has-error" if field_errors.call(:proposal_end_date).any? %>">
                <%= form.label :proposal_end_date, "Proposal Ending Date", class: "visually-hidden" %>
                <%= form.date_field :proposal_end_date, required: true, data: { validation_label: "Proposal Ending Date" } %>
                <% field_errors.call(:proposal_end_date).each do |message| %>
                  <div class="app-form-error"><%= message %></div>
                <% end %>
                <div class="app-form-error app-form-error-client" data-field-error="true"></div>
              </div>
            </td>
          </tr>

          <tr>
            <th scope="row" class="app-rfp-table-label">Proposal Remark</th>
            <td class="app-rfp-table-value">
              <div class="app-form-field app-rfp-cell-field <%= "has-error" if field_errors.call(:remark).any? %>">
                <%= form.label :remark, "Proposal Remark", class: "visually-hidden" %>
                <%= form.text_area :remark, rows: 3, required: true, data: { validation_label: "Proposal Remark" } %>
                <% field_errors.call(:remark).each do |message| %>
                  <div class="app-form-error"><%= message %></div>
                <% end %>
                <div class="app-form-error app-form-error-client" data-field-error="true"></div>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    </div>

    <div class="app-static-page quotation-page-2">
    <div class="app-page-header app-subsection-header">
      <div>
        <h3>Select Vendors</h3>
        <p class="app-section-note mb-0" data-vendor-selection-note>After you select a theme, only vendors registered for that theme appear here.</p>
      </div>
    </div>

    <div class="app-form-field app-rfp-vendor-field" data-vendor-selection-field>
      <label>Vendor List</label>
      <div class="app-multiselect-dropdown" data-quotation-vendor-dropdown>
        <div class="app-multiselect-trigger" data-quotation-vendor-trigger role="button" tabindex="0" aria-expanded="false">
          <div class="app-selected-vendors" data-quotation-vendor-selected></div>
          <span class="app-multiselect-placeholder" data-quotation-vendor-label>Select vendors</span>
        </div>

        <div class="app-multiselect-panel" data-quotation-vendor-panel>
          <input type="search" class="app-multiselect-search" placeholder="Search vendor..." data-quotation-vendor-search>

          <div class="app-multiselect-options">
            <% @vendors.each do |vendor| %>
              <% theme_ids = vendor.themes.map(&:id).join(",") %>
              <label class="app-multiselect-option"
                     data-theme-ids="<%= theme_ids %>"
                     data-stakeholder-id="<%= vendor.stakeholder_category_id %>"
                     data-vendor-option>
                <%= check_box_tag "quotation_proposal[vendor_registration_ids][]", vendor.id, quotation_proposal.vendor_registration_ids.include?(vendor.id), class: "quotation-vendor-checkbox" %>
                <span>
                  <strong><%= vendor.display_name %></strong><br>
                  <small><%= [vendor.email, vendor.stakeholder_category&.name].compact.join(" | ") %></small>
                </span>
              </label>
            <% end %>
          </div>

          <p class="app-multiselect-empty is-hidden" data-quotation-vendor-empty>No vendor matches the selected theme or search.</p>
        </div>
      </div>
      <div class="app-form-error app-form-error-client" data-vendor-selection-error="true"></div>
      <% if quotation_proposal.vendor_registrations.any? %>
        <p class="app-section-note mb-0" style="margin-top: 0.65rem;">
          Selected vendors:
          <%= quotation_proposal.vendor_registrations.map { |vendor|
                stakeholder_name = vendor.stakeholder_category&.name.to_s.strip.presence || "No stakeholder"
                "#{vendor.display_name} (#{stakeholder_name})"
              }.join(", ") %>
        </p>
      <% end %>
    </div>

    </div>

    <div class="app-static-page quotation-page-3">
    <div class="app-page-header app-subsection-header">
      <div>
        <h3>Proposal Items</h3>
        <p class="app-section-note mb-0">Add each required item with clear item-wise details. You can add more rows below.</p>
      </div>
    </div>

    <div class="app-rfp-section-panel" data-quotation-items>
      <div class="app-rfp-table-wrap" data-table-search="false" data-table-pagination="false">
        <table class="table app-table app-rfp-items-table">
          <thead>
            <tr>
              <th>Item Name</th>
              <th>Unit</th>
              <th>Quantity</th>
              <th>Max Rate</th>
              <th>Remark</th>
              <th style="width: 140px;">Action</th>
            </tr>
          </thead>
          <tbody data-quotation-item-list>
        <%= form.fields_for :quotation_proposal_items do |item_form| %>
          <%= render "quotation_proposal_item_fields", form: item_form %>
        <% end %>
          </tbody>
        </table>
      </div>

      <template data-quotation-item-template>
        <%= form.fields_for :quotation_proposal_items, QuotationProposalItem.new, child_index: "NEW_ITEM" do |item_form| %>
          <%= render "quotation_proposal_item_fields", form: item_form %>
        <% end %>
      </template>

      <div class="app-quotation-toolbar">
        <button type="button" class="app-secondary-btn app-secondary-btn-soft" data-add-quotation-item>Add Item</button>
      </div>

      <div class="app-form-error app-form-error-client" data-quotation-items-error="true"></div>
    </div>

    </div>

    <div class="app-static-page quotation-page-4">
    <div class="app-page-header app-subsection-header app-subsection-header-spacious">
      <div>
        <h3>Vendor Selection Criteria</h3>
        <p class="app-section-note mb-0">
          Choose the criteria that the committee should use for vendor comparison. If no criteria are selected, the existing manual score flow remains available.
        </p>
      </div>
    </div>

    <div class="app-rfp-section-panel app-rfp-criteria-panel" data-quotation-criteria-section>
      <div class="app-rfp-criteria-toolbar">
        <div class="app-rfp-criteria-toolbar-copy">
          <p class="app-rfp-criteria-summary" data-quotation-criteria-summary></p>
          <p class="app-rfp-criteria-selected-preview" data-quotation-criteria-selected-preview></p>
        </div>

        <div class="app-rfp-criteria-toolbar-actions">
          <label class="app-rfp-criteria-search">
            <input type="search" class="form-control" placeholder="Search criteria" data-quotation-criteria-search>
          </label>
          <button type="button" class="app-secondary-btn app-secondary-btn-soft app-rfp-criteria-toggle" data-quotation-criteria-toggle>
            Show Criteria
          </button>
        </div>
      </div>

      <p class="app-rfp-criteria-empty is-hidden" data-quotation-criteria-empty>
        Select a theme to view vendor selection criteria.
      </p>

      <div class="app-rfp-criteria-grid-wrap" data-quotation-criteria-list-wrap>
        <div class="app-rfp-criteria-grid">
          <% @vendor_selection_criteria.each do |criterion| %>
            <label class="app-rfp-criteria-option" data-quotation-criteria-option data-theme-id="<%= criterion.theme_id %>">
              <%= check_box_tag "quotation_proposal[vendor_selection_criterion_ids][]",
                                criterion.id,
                                selected_criterion_ids.include?(criterion.id),
                                data: { quotation_criteria_checkbox: true } %>
              <span>
                <strong><%= criterion.criteria %></strong>
              </span>
            </label>
          <% end %>
        </div>
      </div>
    </div>

    </div>

    <div class="app-static-page quotation-page-5">
    <div class="app-page-header app-subsection-header app-subsection-header-spacious">
      <div>
        <h3>Approval Committee</h3>
        <p class="app-section-note mb-0">
          Add more members with `Add Committee Member` if needed.
        </p>
      </div>
    </div>

    <div class="app-rfp-section-panel" data-quotation-committee data-min-committee-members="<%= QuotationProposal::MIN_COMMITTEE_MEMBERS %>">
      <div class="app-rfp-table-wrap" data-table-search="false" data-table-pagination="false">
        <table class="table app-table app-rfp-committee-table">
          <thead>
            <tr>
              <th style="width: 180px;">Level</th>
              <th>Committee Member</th>
              <th style="width: 140px;">Action</th>
            </tr>
          </thead>
          <tbody data-quotation-committee-list>
        <%= form.fields_for :committee_steps, quotation_proposal.committee_steps.sort_by(&:level) do |committee_form| %>
          <%= render "committee_step_fields", form: committee_form %>
        <% end %>
          </tbody>
        </table>
      </div>

      <template data-quotation-committee-template>
        <%= form.fields_for :committee_steps, QuotationProposalCommitteeStep.new(status: "waiting"), child_index: "NEW_COMMITTEE_STEP" do |committee_form| %>
          <%= render "committee_step_fields", form: committee_form %>
        <% end %>
      </template>

      <div class="app-quotation-toolbar">
        <button type="button" class="app-secondary-btn app-secondary-btn-soft" data-add-committee-step>Add Committee Member</button>
      </div>
    </div>

    <div class="app-form-actions">
      <%= form.submit "Save Request for Proposal", class: "app-form-submit" %>
    </div>
    </div>

    <div class="app-static-pager-nav">
      <div class="app-static-pager-row quotation-nav-1">
        <span class="app-static-pager-status">Step 1 of 5 - Quotation Details</span>
        <div class="app-static-pager-actions">
          <label for="quotation-step-2" class="app-static-pager-button app-static-pager-button-primary">Next</label>
        </div>
      </div>
      <div class="app-static-pager-row quotation-nav-2">
        <span class="app-static-pager-status">Step 2 of 5 - Select Vendors</span>
        <div class="app-static-pager-actions">
          <label for="quotation-step-1" class="app-static-pager-button">Previous</label>
          <label for="quotation-step-3" class="app-static-pager-button app-static-pager-button-primary">Next</label>
        </div>
      </div>
      <div class="app-static-pager-row quotation-nav-3">
        <span class="app-static-pager-status">Step 3 of 5 - Proposal Items</span>
        <div class="app-static-pager-actions">
          <label for="quotation-step-2" class="app-static-pager-button">Previous</label>
          <label for="quotation-step-4" class="app-static-pager-button app-static-pager-button-primary">Next</label>
        </div>
      </div>
      <div class="app-static-pager-row quotation-nav-4">
        <span class="app-static-pager-status">Step 4 of 5 - Selection Criteria</span>
        <div class="app-static-pager-actions">
          <label for="quotation-step-3" class="app-static-pager-button">Previous</label>
          <label for="quotation-step-5" class="app-static-pager-button app-static-pager-button-primary">Next</label>
        </div>
      </div>
      <div class="app-static-pager-row quotation-nav-5">
        <span class="app-static-pager-status">Step 5 of 5 - Approval Committee</span>
        <div class="app-static-pager-actions">
          <label for="quotation-step-4" class="app-static-pager-button">Previous</label>
        </div>
      </div>
    </div>
  </div>
<% end %>
