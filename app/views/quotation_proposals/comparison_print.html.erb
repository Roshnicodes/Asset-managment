<style>
  .comparison-print-page { padding: 24px; color: #172033; }
  .comparison-print-toolbar { display: flex; justify-content: flex-end; gap: 12px; margin-bottom: 16px; }
  .comparison-print-title { margin: 0 0 4px; font-size: 24px; color: #125f38; }
  .comparison-print-subtitle { margin: 0 0 16px; color: #52665a; }
  .comparison-print-table-wrap { overflow-x: auto; }
  .comparison-print-table { width: 100%; min-width: 900px; border-collapse: collapse; }
  .comparison-print-table th, .comparison-print-table td { border: 1px solid #d9e8dd; padding: 8px; text-align: left; vertical-align: top; }
  .comparison-print-table th { background: #f6faf7; color: #125f38; }
  .comparison-print-field { width: 220px; font-weight: 700; background: #fbfdfb; }
  .comparison-print-selected { background: #effaf3; }
  @media print { .comparison-print-toolbar { display: none !important; } .comparison-print-page { padding: 0; } .comparison-print-table { font-size: 11px; } }
</style>

<% selected_vendor_registration_id = @quotation_proposal.selected_vendor_registration_id %>
<% lowest_amount_vendor_id = @responded_vendors.min_by { |vendor| vendor.total_quoted_amount.to_d }&.id %>
<% lowest_grand_total_vendor_id = @responded_vendors.min_by { |vendor| vendor.grand_total_amount.to_d }&.id %>
<% top_rank_vendor_id = @responded_vendors.find { |vendor| vendor.rank_position == 1 }&.id %>
<% committee_score_members = @committee_score_members || @quotation_proposal.committee_steps.includes(:employee_master).map(&:employee_master).compact %>

<div class="comparison-print-page">
  <div class="comparison-print-toolbar print-hide">
    <button type="button" class="app-form-submit" onclick="window.print()">Print / Save PDF</button>
  </div>

  <h1 class="comparison-print-title">Committee Vendor Rate Comparison</h1>
  <p class="comparison-print-subtitle"><%= @quotation_proposal.subject %></p>

  <% if @selected_criteria_selections.any? %>
    <p><strong>Criteria:</strong> <%= @selected_criteria_selections.map(&:display_label).join(", ") %></p>
  <% end %>

  <div class="comparison-print-table-wrap">
    <table class="comparison-print-table">
      <thead>
        <tr>
          <th class="comparison-print-field">Compare Field</th>
          <% @comparison_vendors.each do |proposal_vendor| %>
            <th class="<%= 'comparison-print-selected' if selected_vendor_registration_id == proposal_vendor.vendor_registration_id %>">
              <%= proposal_vendor.vendor_registration.display_name %>
              <% if proposal_vendor.id == top_rank_vendor_id %><div>Top Rank</div><% end %>
              <% if selected_vendor_registration_id == proposal_vendor.vendor_registration_id %><div>Selected</div><% end %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="comparison-print-field">Rank</td>
          <% @comparison_vendors.each do |proposal_vendor| %><td><%= proposal_vendor.rank_position || "-" %></td><% end %>
        </tr>
        <tr>
          <td class="comparison-print-field">Committee Score</td>
          <% @comparison_vendors.each do |proposal_vendor| %>
            <td>
              <strong><%= proposal_vendor.committee_score_value.presence || "Not scored" %></strong>
              <div>Scored by: <%= proposal_vendor.committee_score_count %>/<%= @quotation_proposal.committee_steps.size %></div>
              <% missing_score_members = proposal_vendor.response_submitted? ? proposal_vendor.missing_committee_score_members(committee_score_members) : [] %>
              <% if missing_score_members.any? %>
                <div>Pending score from: <strong><%= missing_score_members.map { |member| member.name.presence || member.email_id.presence || "Committee Member" }.join(", ") %></strong></div>
              <% end %>
              <% if proposal_vendor.score_remarks.any? %>
                <% proposal_vendor.score_remarks.each do |author_name, remark_text| %>
                  <div><strong><%= author_name %>:</strong> <%= remark_text %></div>
                <% end %>
              <% end %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td class="comparison-print-field">Amount Total</td>
          <% @comparison_vendors.each do |proposal_vendor| %>
            <td class="<%= 'comparison-print-selected' if proposal_vendor.id == lowest_amount_vendor_id %>"><%= number_with_precision(proposal_vendor.total_quoted_amount, precision: 2) %></td>
          <% end %>
        </tr>
        <tr>
          <td class="comparison-print-field">Grand Total</td>
          <% @comparison_vendors.each do |proposal_vendor| %>
            <td class="<%= 'comparison-print-selected' if proposal_vendor.id == lowest_grand_total_vendor_id %>"><%= number_with_precision(proposal_vendor.grand_total_amount, precision: 2) %></td>
          <% end %>
        </tr>
        <tr>
          <td class="comparison-print-field">Purchase Order</td>
          <% @comparison_vendors.each do |proposal_vendor| %>
            <td>
              <%= proposal_vendor.purchase_order_status.to_s.humanize.presence || "Draft" %>
              <div>Sent: <%= proposal_vendor.purchase_order_sent_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
              <div>Response: <%= proposal_vendor.purchase_order_actioned_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
            </td>
          <% end %>
        </tr>
        <% @quotation_proposal.quotation_proposal_items.includes(:unit).each do |proposal_item| %>
          <tr>
            <td class="comparison-print-field">
              <%= quotation_item_display_name(proposal_item.item_name) %>
              <div>Qty: <%= proposal_item.quantity %> <%= proposal_item.unit&.name %></div>
              <div>Remark: <%= proposal_item.remark.presence || "-" %></div>
            </td>
            <% @comparison_vendors.each do |proposal_vendor| %>
              <% vendor_item = proposal_vendor.vendor_items.find { |item| item.quotation_proposal_item_id == proposal_item.id } %>
              <td class="<%= 'comparison-print-selected' if selected_vendor_registration_id == proposal_vendor.vendor_registration_id %>">
                <div><strong>Rate:</strong> <%= vendor_item&.quoted_rate.present? ? number_with_precision(vendor_item.quoted_rate, precision: 2) : "-" %></div>
                <div><strong>Amount:</strong> <%= vendor_item&.line_total.present? ? number_with_precision(vendor_item.line_total, precision: 2) : "-" %></div>
                <div><strong>GST %:</strong> <%= vendor_item&.gst_percentage.present? ? number_with_precision(vendor_item.gst_percentage, precision: 2) : "-" %></div>
                <div><strong>Grand Total:</strong> <%= vendor_item&.grand_total.present? ? number_with_precision(vendor_item.grand_total, precision: 2) : "-" %></div>
                <div><strong>Remark:</strong> <%= vendor_item&.remark.presence || "-" %></div>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<script>window.addEventListener("load", function () { window.print(); });</script>
