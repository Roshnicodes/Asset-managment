<style>
  .sticky-top { position: sticky; top: 0; z-index: 100; }
  .app-table thead th { background: #f8fcf9 !important; border-bottom: 2px solid #eef3ef !important; }
  .app-table-wrap { height: calc(100vh - 300px); max-height: none; overflow-y: auto; overflow-x: auto; background: white; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
  .quotation-inline-pager { display:flex; align-items:center; justify-content:space-between; gap:.8rem; flex-wrap:wrap; margin-top:.8rem; padding:.85rem 1rem; border:1px solid #dce7dd; border-radius:14px; background:#fff; }
  .quotation-inline-pager button { min-width:96px; min-height:40px; border:1px solid #dce7dd; border-radius:10px; background:#fff; color:#0b4a4f; font-weight:800; }
  .quotation-inline-pager button:last-child { background:#0f5f52; color:#fff; border-color:#0f5f52; }
  .quotation-inline-pager button:disabled { opacity:.5; cursor:not-allowed; }
</style>

<div class="app-toolbar">
  <div class="d-flex align-items-center gap-3" style="width: 100%">
    <div>
      <h1 class="mb-0" style="white-space: nowrap;">Quotation Proposals</h1>
      <p class="app-section-note mb-0">Create drafts, submit them for approval, and monitor proposal workflow in one place.</p>
    </div>
    <div style="margin-left:auto; display:flex; gap:.5rem; align-items:center;">
      <% if can_view_menu?("quotation_proposal_form") %>
        <%= link_to "Request for Proposal", new_quotation_proposal_path, class: "app-primary-btn" %>
      <% end %>
    </div>
  </div>
</div>

<div class="app-table-wrap" data-inline-table-pager="true" data-page-size="10">
  <table class="table app-table">
    <thead class="sticky-top">
      <tr>
        <th></th>
        <th>View</th>
        <th>Subject</th>
        <th>Theme</th>
        <th>Vendors</th>
        <th>End Date</th>
        <th>Items</th>
        <th>Workflow Status</th>
        <th>Latest Remark</th>
        <th>Committee Trail</th>
        <th>Created By</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% @quotation_proposals.each do |quotation_proposal| %>
        <tr>
          <td></td>
          <td>
            <%= link_to quotation_proposal_path(quotation_proposal), class: "app-action-icon text-primary", title: "View" do %>
              <%= app_icon(:eye, size: 18) %>
            <% end %>
          </td>
          <td><%= quotation_proposal.subject %></td>
          <td><%= quotation_proposal.theme.name %></td>
          <td><%= quotation_proposal.vendor_registrations.map(&:display_name).join(", ") %></td>
          <td><%= quotation_proposal.proposal_end_date.strftime("%d-%m-%Y") %></td>
          <td><%= quotation_proposal.quotation_proposal_items.size %></td>
          <td>
            <% status_class = case quotation_proposal.workflow_status
               when 'vendor_selected' then 'bg-success bg-opacity-10 text-success border-success'
               when 'responses_received' then 'bg-primary bg-opacity-10 text-primary border-primary'
               when 'sent_to_vendors' then 'bg-info bg-opacity-10 text-info border-info'
               when 'committee_approved' then 'bg-success bg-opacity-10 text-success border-success'
               when 'rejected' then 'bg-danger bg-opacity-10 text-danger border-danger'
               when 'returned' then 'bg-danger bg-opacity-10 text-danger border-danger'
               else 'bg-warning bg-opacity-10 text-warning border-warning'
               end %>
            <span class="badge border <%= status_class %> fw-semibold px-2 py-1">
              <%= quotation_proposal.workflow_status.humanize %>
            </span>
          </td>
          <td><%= quotation_proposal.approval_request&.latest_remark.presence || quotation_proposal.committee_steps.where.not(remark: [nil, ""]).order(actioned_at: :desc).pick(:remark).presence || "-" %></td>
          <td>
            <div class="d-flex flex-column gap-1" style="min-width: 250px;">
              <% approval_started = quotation_proposal.approval_request.present? %>
              <% trail_steps = quotation_proposal.approval_request&.trail_steps || quotation_proposal.committee_steps %>
              <% if trail_steps.any? %>
                <% trail_steps.each do |step| %>
                  <% step_status = if approval_started
                       step.respond_to?(:effective_status) ? step.effective_status : step.status
                     else
                       "waiting"
                     end %>
                  <% step_label = if approval_started
                       step.respond_to?(:effective_status_label) ? step.effective_status_label : step.status_label
                     else
                       "Not Started"
                     end %>
                  <div class="d-flex align-items-center gap-2 small lh-sm">
                    <% dot_class = case step_status
                       when 'approved' then 'text-success'
                       when 'returned' then 'text-warning'
                       when 'rejected' then 'text-danger'
                       when 'pending' then 'text-info'
                       else 'text-muted opacity-50'
                       end %>
                    <span class="<%= dot_class %>" style="font-size: 1.2rem;">●</span>
                    <div class="text-truncate" style="max-width: 240px;">
                      <span class="fw-bold">L<%= step.level %> - <%= step.employee_master.name %></span>
                      <span class="<%= dot_class %> fw-semibold">: <%= step_label %></span>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <span class="text-muted">-</span>
              <% end %>
            </div>
          </td>
          <td><%= quotation_proposal.user&.email || "-" %></td>
          <td class="app-row-actions">
            <div class="d-flex align-items-center gap-2">
              <% unless quotation_proposal.approval_locked? %>
                <%= link_to edit_quotation_proposal_path(quotation_proposal), class: "app-action-icon text-warning", title: "Edit" do %>
                  <%= app_icon(:pencil, size: 18) %>
                <% end %>
                <%= button_to quotation_proposal_path(quotation_proposal), method: :delete, data: { turbo_confirm: "Delete this quotation proposal?" }, class: "app-action-icon text-danger", title: "Delete" do %>
                  <%= app_icon(:trash, size: 18) %>
                <% end %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<script>
  (function () {
    function setupQuotationInlinePager() {
      document.querySelectorAll("[data-inline-table-pager='true']").forEach(function (wrap) {
        if (wrap.dataset.inlinePagerReady === "true") return;
        var tbody = wrap.querySelector("tbody");
        if (!tbody) return;
        var rows = Array.from(tbody.querySelectorAll("tr"));
        var pageSize = parseInt(wrap.dataset.pageSize || "10", 10);
        if (rows.length <= pageSize) return;
        var page = 0;
        var pager = document.createElement("div");
        pager.className = "quotation-inline-pager";
        pager.innerHTML = '<strong data-inline-page-info></strong><div><button type="button" data-inline-prev>Previous</button> <button type="button" data-inline-next>Next</button></div>';
        wrap.insertAdjacentElement("afterend", pager);
        var info = pager.querySelector("[data-inline-page-info]");
        var prev = pager.querySelector("[data-inline-prev]");
        var next = pager.querySelector("[data-inline-next]");
        function render() {
          var totalPages = Math.ceil(rows.length / pageSize);
          rows.forEach(function (row, index) {
            row.style.display = index >= page * pageSize && index < (page + 1) * pageSize ? "" : "none";
          });
          info.textContent = "Page " + (page + 1) + " of " + totalPages + " - Showing " + Math.min(rows.length, pageSize) + " records per page";
          prev.disabled = page === 0;
          next.disabled = page >= totalPages - 1;
        }
        prev.addEventListener("click", function () { page -= 1; render(); });
        next.addEventListener("click", function () { page += 1; render(); });
        render();
        wrap.dataset.inlinePagerReady = "true";
      });
    }
    document.addEventListener("DOMContentLoaded", setupQuotationInlinePager);
    document.addEventListener("turbo:load", setupQuotationInlinePager);
    setupQuotationInlinePager();
  })();
</script>
