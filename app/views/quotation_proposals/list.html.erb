<% can_manage_quotation_proposals = can_view_menu?("quotation_proposal_form") && quotation_proposal_maker? %>
<% sendable_quotation_proposals = can_manage_quotation_proposals ? @quotation_proposals.select { |quotation_proposal| quotation_proposal.approval_request.blank? && (admin_user? || quotation_proposal.user_id == current_user.id) } : [] %>
<% pending_actions = quotation_pending_actions %>
<%# Anything waiting on this user is listed first so it cannot be missed. %>
<% ordered_quotation_proposals = @quotation_proposals.sort_by { |proposal| [pending_actions.key?(proposal.id) ? 0 : 1, -proposal.id] } %>
<% stages = @quotation_proposals.map { |quotation_proposal| quotation_stage(quotation_proposal).label }.uniq.sort %>

<div class="rl">
  <section class="rl-head">
    <span class="rl-head__icon"><%= app_icon(:layers, size: 28) %></span>
    <div class="rl-head__title">
      <h1>Quotation Proposal List</h1>
      <p>All quotations you can see; anything waiting on you is shown first.</p>
    </div>
    <div class="rl-head__actions">
      <% if pending_actions.any? %>
        <span class="rl-pending-chip">
          <% QuotationPendingHelper::QUOTATION_PENDING_LABELS.each do |kind, label| %>
            <% count = pending_actions.count { |_id, pending_kind| pending_kind == kind } %>
            <% next if count.zero? %>
            <b><%= count %></b> <%= label.downcase %>
          <% end %>
        </span>
      <% end %>
      <% if can_manage_quotation_proposals %>
        <%= form_tag send_for_approval_quotation_proposals_path, method: :post, id: "send-quotation-approval-form", class: "d-inline" do %>
          <button type="submit" class="rl-btn rl-btn--primary d-none" id="send_quotation_for_approval_button"><%= app_icon(:approval, size: 16) %> Send for Approval</button>
        <% end %>
      <% end %>
    </div>
  </section>

  <div class="rl-card" data-rlist>
    <%= render "shared/rlist_toolbar",
               placeholder: "Search by subject, QTN number, theme, vendor...",
               filters: [
                 ["theme", "Theme", @quotation_proposals.filter_map { |q| q.theme&.name }.uniq.sort],
                 ["status", "Status", stages],
                 ["creator", "Created By", @quotation_proposals.filter_map { |q| q.user&.employee_master&.name.presence || q.user&.email }.uniq.sort]
               ] %>

    <div class="app-table-wrap rl-table-wrap" data-table-search="false" data-table-pagination="false">
      <table class="table app-table rl-table" data-min-width-ready="true">
        <thead>
          <tr>
            <% if can_manage_quotation_proposals %>
              <th class="rl-col-check">
                <% if sendable_quotation_proposals.any? %>
                  <input type="checkbox" id="quotation_select_all_checkbox" aria-label="Select all">
                <% end %>
              </th>
            <% end %>
            <th class="rl-col-num">#</th>
            <th class="rl-col-view">View</th>
            <th>Subject</th>
            <th>Theme</th>
            <th>Vendors</th>
            <th>End Date</th>
            <th>Status</th>
            <th class="rl-optional">Created By</th>
            <% if can_manage_quotation_proposals %>
              <th class="rl-col-actions">Action</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% ordered_quotation_proposals.each do |quotation_proposal| %>
            <%= render "rlist_row", quotation_proposal: quotation_proposal, show_check: can_manage_quotation_proposals,
                                    show_actions: can_manage_quotation_proposals, pending_label: quotation_pending_label(quotation_proposal) %>
          <% end %>
        </tbody>
      </table>
      <div class="rl-empty" data-rlist-empty hidden>No quotation matches the filters.</div>
    </div>
    <div class="rl-footer" data-rlist-footer></div>
  </div>
</div>
