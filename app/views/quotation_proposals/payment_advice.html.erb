<div class="app-page-shell">
  <div class="app-page-header">
    <div>
      <h1 style="margin-bottom: 0.35rem;">Finance Payment Queue</h1>
    </div>
  </div>

  <div class="app-card mt-4" style="padding: 1.35rem 1.45rem;">
    <% if @payment_advice_requests.any? %>
      <%= form_with url: update_payment_advice_quotation_proposals_path, method: :patch, local: true, data: { finance_bulk_form: true } do %>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th style="width: 60px;">
                  <%= check_box_tag :select_all_finance_rows, "1", false, class: "form-check-input", data: { finance_select_all: true } %>
                </th>
                <th>Invoice</th>
                <th>Quotation</th>
                <th>Vendor</th>
                <th>PDO No</th>
                <th>RFP No</th>
                <th>RFP Date</th>
                <th>Received Items</th>
                <th>Invoice Files</th>
                <th>Moved To Finance</th>
              </tr>
            </thead>
            <tbody>
              <% @payment_advice_requests.each do |invoice_request| %>
                <% proposal_vendor = invoice_request.quotation_proposal_vendor %>
                <% quotation_proposal = proposal_vendor.quotation_proposal %>
                <% vendor = proposal_vendor.vendor_registration %>
                <tr>
                  <td>
                    <%= check_box_tag "invoice_request_ids[]", invoice_request.id, false, class: "form-check-input", data: { finance_row_checkbox: true } %>
                  </td>
                  <td>
                    <strong>Request <%= invoice_request.id %></strong>
                    <% if invoice_request.assets_created? %>
                      <div class="small text-info mt-1"><%= pluralize(invoice_request.assets.count, "asset") %> linked</div>
                    <% end %>
                  </td>
                  <td><%= quotation_proposal.subject %></td>
                  <td>
                    <div><strong><%= vendor.display_name %></strong></div>
                    <div class="small text-muted"><%= vendor.mobile_no.presence || "-" %></div>
                  </td>
                  <td><%= invoice_request.pdo_no %></td>
                  <td><%= invoice_request.rfp_no %></td>
                  <td><%= invoice_request.rfp_created_on&.strftime("%d-%m-%Y") || "-" %></td>
                  <td>
                    <div class="d-flex gap-1 flex-wrap">
                      <% invoice_request.snapshot_items.each do |item| %>
                        <span class="badge border bg-light text-dark">
                          <%= quotation_item_display_name(item[:item_name]) %>: <%= number_with_precision(item[:received_quantity], precision: 2, strip_insignificant_zeros: true) %>
                        </span>
                      <% end %>
                    </div>
                  </td>
                  <td>
                    <% if invoice_request.vendor_invoices.attached? %>
                      <div class="d-flex gap-1 flex-wrap">
                        <% invoice_request.vendor_invoices.each_with_index do |document, index| %>
                          <%= link_to "Invoice #{index + 1}", rails_blob_path(document, disposition: "attachment"), class: "app-secondary-btn", style: "padding: .35rem .55rem; font-size: .78rem;" %>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="small text-muted">No files</span>
                    <% end %>
                  </td>
                  <td>
                    <div><%= invoice_request.payment_reference_marked_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
                    <div class="small text-muted"><%= invoice_request.payment_reference_marked_by&.name.presence || "System" %></div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="mt-4" style="border-top: 1px solid #e2ece6; padding-top: 1rem;">
          <div class="d-flex justify-content-between gap-3 flex-wrap align-items-start mb-3">
            <div>
              <div style="font-weight: 700; color: #154734;">Common Transaction Details</div>
            </div>
            <div class="d-flex gap-2 flex-wrap align-items-center">
              <span class="badge border bg-info bg-opacity-10 text-info">Selected: <span data-finance-selected-count>0</span></span>
              <span class="badge border bg-warning bg-opacity-10 text-warning">Vendor message API pending</span>
            </div>
          </div>

          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label" style="font-weight: 700;">Transaction Type</label>
              <%= select_tag :transaction_type,
                    options_for_select(QuotationProposalVendorInvoiceRequest::TRANSACTION_TYPES),
                    prompt: "Select transaction type",
                    class: "form-select",
                    required: true %>
            </div>
            <div class="col-md-4">
              <label class="form-label" style="font-weight: 700;">Transaction No</label>
              <%= text_field_tag :transaction_no, nil, class: "form-control", placeholder: "Enter transaction reference number", required: true %>
            </div>
            <div class="col-md-4">
              <label class="form-label" style="font-weight: 700;">Transaction Date</label>
              <%= date_field_tag :transaction_date, nil, class: "form-control", required: true %>
            </div>
          </div>

          <div class="d-flex justify-content-end mt-3">
            <%= submit_tag "Save Selected Finance Payment", class: "app-form-submit" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="text-muted">No invoice has been moved to the finance queue yet.</div>
    <% end %>
  </div>
</div>
