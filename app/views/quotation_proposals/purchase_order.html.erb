<style>
  .po-toolbar {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
</style>

<div class="po-toolbar print-hide">
  <%= form_with url: purchase_order_quotation_proposal_path(@quotation_proposal), method: :get, local: true, html: { style: "display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;" } do %>
    <label for="authorized_by_id"><strong>Authorized by</strong></label>
    <%= select_tag :authorized_by_id,
          options_from_collection_for_select(@authorized_by_options, :id, :name, @authorized_by&.id),
          include_blank: "Select authorized person",
          id: "authorized_by_id",
          onchange: (@purchase_order_authorized_by_locked ? nil : "this.form.submit()"),
          disabled: @purchase_order_authorized_by_locked,
          style: "min-width: 220px; padding: 0.55rem 0.8rem; border-radius: 10px; border: 1px solid #b7cfc6; background: #{@purchase_order_authorized_by_locked ? '#f4f7f5' : '#fff'};" %>
    <% if @purchase_order_authorized_by_locked %>
      <span class="small text-muted">Locked after sending to vendor</span>
    <% end %>
  <% end %>

  <% unless @selected_proposal_vendor.purchase_order_status.in?(%w[accepted rejected]) %>
    <%= form_with url: send_purchase_order_quotation_proposal_path(@quotation_proposal), method: :post, local: true, html: { style: "margin: 0; display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;" } do %>
      <%= hidden_field_tag :authorized_by_id, @authorized_by&.id %>
      <label for="purchase_order_due_date"><strong>Last Date</strong></label>
      <%= date_field_tag :purchase_order_due_date,
            @purchase_order_due_date,
            min: Date.current.iso8601,
            id: "purchase_order_due_date",
            style: "min-width: 180px; padding: 0.55rem 0.8rem; border-radius: 10px; border: 1px solid #b7cfc6; background: #fff;" %>
      <%= submit_tag(@selected_proposal_vendor.purchase_order_status == "returned" ? "Resend to Vendor" : "Send to Vendor", class: "app-form-submit") %>
    <% end %>
  <% end %>

  <button type="button" class="app-form-submit" onclick="window.print()">Print Purchase Order</button>
  <%= link_to "Back to Quotation", quotation_proposal_path(@quotation_proposal), class: "app-secondary-btn" %>
</div>

<% if @selected_proposal_vendor.purchase_order_status.in?(%w[sent accepted returned rejected]) %>
  <div class="app-card mb-3" style="padding: 1rem 1.2rem;">
    <div class="d-flex gap-2 flex-wrap align-items-center">
      <strong>Purchase Order Status:</strong>
      <span class="badge border <%= @selected_proposal_vendor.purchase_order_status == "accepted" ? "bg-success bg-opacity-10 text-success" : @selected_proposal_vendor.purchase_order_status == "returned" ? "bg-warning bg-opacity-10 text-warning" : @selected_proposal_vendor.purchase_order_status == "rejected" ? "bg-danger bg-opacity-10 text-danger" : "bg-primary bg-opacity-10 text-primary" %>">
        <%= @selected_proposal_vendor.purchase_order_status.humanize %>
      </span>
      <% if @selected_proposal_vendor.purchase_order_sent_at.present? %>
        <span class="text-muted small">Sent at <%= @selected_proposal_vendor.purchase_order_sent_at.strftime("%d-%m-%Y %H:%M") %></span>
      <% end %>
      <% if @selected_proposal_vendor.purchase_order_actioned_at.present? %>
        <span class="text-muted small">Vendor action at <%= @selected_proposal_vendor.purchase_order_actioned_at.strftime("%d-%m-%Y %H:%M") %></span>
      <% end %>
      <% if @selected_proposal_vendor.purchase_order_due_date.present? %>
        <span class="text-muted small">Last date <%= @selected_proposal_vendor.purchase_order_due_date.strftime("%d-%m-%Y") %></span>
      <% end %>
    </div>
    <% if @selected_proposal_vendor.purchase_order_remark.present? %>
      <div class="mt-2"><strong>Vendor Remark:</strong> <%= @selected_proposal_vendor.purchase_order_remark %></div>
    <% end %>
  </div>
<% end %>

<%= render "purchase_order_sheet",
      proposal_vendor: @selected_proposal_vendor,
      quotation_proposal: @quotation_proposal,
      purchase_order_year_label: @purchase_order_year_label,
      authorized_by: @authorized_by,
      po_payment_terms: @po_payment_terms,
      po_completion_terms: @po_completion_terms,
      po_warranty_terms: @po_warranty_terms,
      po_earnest_money_terms: @po_earnest_money_terms %>
