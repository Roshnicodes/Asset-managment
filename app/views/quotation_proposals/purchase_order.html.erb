<%
  purchase_order_status = @selected_proposal_vendor.purchase_order_status.to_s
  selected_vendor = @selected_proposal_vendor.vendor_registration
  purchase_order_status_label = purchase_order_status.present? ? purchase_order_status.humanize : "Draft"
  purchase_order_status_class =
    case purchase_order_status
    when "accepted"
      "po-status-badge--accepted"
    when "returned"
      "po-status-badge--returned"
    when "rejected"
      "po-status-badge--rejected"
    when "sent"
      "po-status-badge--sent"
    else
      "po-status-badge--draft"
    end
%>

<div class="po-page">
  <div class="app-page-header app-page-header-top po-page-header print-hide">
    <div>
      <h1 class="app-page-title">Purchase Order Preview</h1>
      <div class="po-page-meta">
        <span>PO No. <%= @purchase_order_number %></span>
        <span><%= selected_vendor.display_name %></span>
        <span><%= @selected_proposal_vendor.vendor_items.size %> Items</span>
        <span class="po-status-badge <%= purchase_order_status_class %>"><%= purchase_order_status_label %></span>
      </div>
    </div>
    <div class="po-header-actions">
      <%= link_to "Print Purchase Order", purchase_order_print_quotation_proposal_path(@quotation_proposal), class: "app-form-submit", target: "_blank", rel: "noopener" %>
      <%= link_to "Back to Quotation", quotation_proposal_path(@quotation_proposal), class: "po-back-link" %>
    </div>
  </div>

  <section class="po-control-strip print-hide">
    <%= form_with url: purchase_order_quotation_proposal_path(@quotation_proposal), method: :get, local: true, html: { class: "po-toolbar-form po-toolbar-form--signatory" } do %>
      <div class="app-form-field po-toolbar-field">
        <label for="authorized_by_id">Authorized by</label>
        <%= select_tag :authorized_by_id,
              options_from_collection_for_select(@authorized_by_options, :id, :name, @authorized_by&.id),
              include_blank: "Select authorized person",
              id: "authorized_by_id",
              class: "po-form-input",
              onchange: (@purchase_order_authorized_by_locked ? nil : "this.form.submit()"),
              disabled: @purchase_order_authorized_by_locked %>
      </div>
      <% if @purchase_order_authorized_by_locked %>
        <span class="po-control-lock">Locked</span>
      <% end %>
    <% end %>

    <% unless @selected_proposal_vendor.purchase_order_status.in?(%w[accepted rejected]) %>
      <%= form_with url: send_purchase_order_quotation_proposal_path(@quotation_proposal), method: :post, local: true, html: { class: "po-toolbar-form po-toolbar-form--dispatch" } do %>
        <%= hidden_field_tag :authorized_by_id, @authorized_by&.id %>

        <div class="app-form-field po-toolbar-field">
          <label for="purchase_order_due_date">Last date</label>
          <%= date_field_tag :purchase_order_due_date,
                @purchase_order_due_date,
                min: Date.current.iso8601,
                id: "purchase_order_due_date",
                class: "po-form-input" %>
        </div>

        <%= submit_tag(@selected_proposal_vendor.purchase_order_status == "returned" ? "Resend to Vendor" : "Send to Vendor", class: "app-form-submit") %>
      <% end %>
    <% end %>
  </section>

  <% if @selected_proposal_vendor.purchase_order_status.in?(%w[sent accepted returned rejected]) %>
    <section class="po-status-strip print-hide">
      <% if @selected_proposal_vendor.purchase_order_sent_at.present? %>
        <span class="po-status-pill">Sent <%= @selected_proposal_vendor.purchase_order_sent_at.strftime("%d-%m-%Y %H:%M") %></span>
      <% end %>
      <% if @selected_proposal_vendor.purchase_order_actioned_at.present? %>
        <span class="po-status-pill">Vendor action <%= @selected_proposal_vendor.purchase_order_actioned_at.strftime("%d-%m-%Y %H:%M") %></span>
      <% end %>
      <% if @selected_proposal_vendor.purchase_order_due_date.present? %>
        <span class="po-status-pill">Last date <%= @selected_proposal_vendor.purchase_order_due_date.strftime("%d-%m-%Y") %></span>
      <% end %>

      <% if @selected_proposal_vendor.purchase_order_remark.present? %>
        <div class="po-status-remark po-status-remark--compact">
          <span class="po-status-remark-label">Vendor Remark</span>
          <p><%= @selected_proposal_vendor.purchase_order_remark %></p>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="po-preview-frame">
    <div class="po-preview-sheet">
      <%= render "purchase_order_sheet",
            proposal_vendor: @selected_proposal_vendor,
            quotation_proposal: @quotation_proposal,
            purchase_order_year_label: @purchase_order_year_label,
            authorized_by: @authorized_by,
            po_payment_terms: @po_payment_terms,
            po_completion_terms: @po_completion_terms,
            po_warranty_terms: @po_warranty_terms,
            po_earnest_money_terms: @po_earnest_money_terms %>
    </div>
  </section>
</div>
