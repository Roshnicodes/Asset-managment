<%
  approval_request = @quotation_proposal.approval_request
  viewer_committee_steps = viewer_approval_steps_for(approval_request)
  user_pending_step = viewer_committee_steps.find { |step| step.status == "pending" }
  current_step = user_pending_step || approval_request&.current_step
  approver_view = approval_request.present? && user_pending_step.present? && approval_request.status == "pending"
  committee_approval_started = approval_request.present?
  owner_or_admin = current_user == @quotation_proposal.user || admin_user?
  creator_can_dispatch = current_user == @quotation_proposal.user
  editable_by_owner = !@quotation_proposal.approval_locked? && (approval_request.blank? || approval_request.employee_return_pending? || @quotation_proposal.missing_max_rates?)
  committee_trail_steps = approval_request.present? ? approval_request.trail_steps : @quotation_proposal.committee_steps
  pending_approval_count = approval_request.present? ? approval_request.approval_steps.where(status: "pending").count : 0
  committee_scoring_allowed = @committee_scoring_allowed
  selected_criteria_selections = @quotation_proposal.criteria_selections.to_a
  criteria_based_scoring = selected_criteria_selections.any?
  direct_response_mode = @quotation_proposal.below_10k?
  proposal_items_count = @quotation_proposal.quotation_proposal_items.size
  show_edit_action = owner_or_admin && (current_user == @quotation_proposal.user ? editable_by_owner : true)
  show_start_approval_action = owner_or_admin && @quotation_proposal.approval_request.blank? && @quotation_proposal.sent_to_vendors_at.blank? && !@quotation_proposal.committee_completed?
  show_send_vendor_action = creator_can_dispatch && @quotation_proposal.committee_completed? && !@quotation_proposal.vendor_responses_received?
  status_actions_present = show_edit_action || show_start_approval_action || show_send_vendor_action
  trail_should_open = approver_view || pending_approval_count.positive? || committee_trail_steps.size <= 2
  trail_completed_count = if committee_approval_started
    committee_trail_steps.count do |step|
      step_status = step.respond_to?(:effective_status) ? step.effective_status : step.status
      step_status.in?(%w[approved returned rejected])
    end
  else
    0
  end
  workflow_class = case @quotation_proposal.workflow_status
                   when "vendor_selected" then "bg-success bg-opacity-10 text-success border-success"
                   when "responses_received" then "bg-primary bg-opacity-10 text-primary border-primary"
                   when "sent_to_vendors" then "bg-info bg-opacity-10 text-info border-info"
                   when "committee_approved" then "bg-success bg-opacity-10 text-success border-success"
                   when "rejected" then "bg-danger bg-opacity-10 text-danger border-danger"
                   when "returned" then "bg-danger bg-opacity-10 text-danger border-danger"
                   else "bg-warning bg-opacity-10 text-warning border-warning"
                   end
%>

<style>
  .quotation-proposal-show[data-ui-page-pager="true"] {
    display: flex !important;
    flex-direction: column !important;
    height: auto !important;
    max-height: none !important;
    min-height: 0 !important;
    overflow: visible !important;
  }

  .quotation-proposal-show[data-ui-page-pager="true"]:not(.app-page-paged) {
    overflow-y: auto !important;
  }

  .quotation-proposal-show[data-ui-page-pager="true"] > .app-page-header,
  .quotation-proposal-show[data-ui-page-pager="true"] > .app-detail-actions,
  .quotation-proposal-show[data-ui-page-pager="true"] > .app-form-pager {
    flex: 0 0 auto !important;
  }

  .quotation-proposal-show[data-ui-page-pager="true"].app-page-paged > :not(.app-page-header):not(.app-detail-actions):not(.app-form-pager) {
    flex: 1 1 auto !important;
    min-height: 0 !important;
    overflow-y: auto !important;
  }

  .quotation-proposal-show details > summary {
    cursor: default !important;
    pointer-events: none !important;
  }

  .quotation-proposal-show__section-summary::after {
    display: none !important;
    content: none !important;
  }
</style>

<div class="quotation-proposal-show" data-ui-page-pager="true">
  <div class="app-page-header app-page-header-top quotation-proposal-show__hero">
    <div>
      <h2 class="app-page-title quotation-proposal-show__title">Quotation Proposal Details</h2>
      <p class="app-page-subtitle quotation-proposal-show__subtitle"><%= @quotation_proposal.subject %></p>
    </div>
    <%= link_to "Back", quotation_proposals_path, class: "app-back-link quotation-proposal-show__back-link" %>
  </div>

  <div class="app-detail-actions app-detail-actions-spread quotation-proposal-show__status-bar <%= "quotation-proposal-show__status-bar--single" unless status_actions_present %>">
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <span class="badge border <%= workflow_class %> fw-semibold px-3 py-2" style="font-size: 0.9rem;">
        <%= @quotation_proposal.workflow_status.humanize %>
      </span>

      <% viewer_committee_steps.each do |viewer_step| %>
        <span class="badge border <%= approval_status_css_class_for(viewer_step.effective_status) %> px-3 py-2" style="font-size: 0.9rem;">
          L<%= viewer_step.level %>: <%= viewer_step.effective_status_label %>
        </span>
      <% end %>

      <% if pending_approval_count.positive? %>
        <span class="badge border bg-light text-dark px-3 py-2" style="font-size: 0.9rem;">
          Pending Approvals: <%= pending_approval_count %>
        </span>
      <% end %>

      <span class="badge border bg-light text-dark px-3 py-2" style="font-size: 0.9rem;">
        Vendors: <%= @quotation_proposal.vendor_registrations.size %>
      </span>
    </div>

    <% if status_actions_present %>
      <div class="d-flex align-items-center gap-2 flex-wrap quotation-proposal-show__status-actions">
      <% if show_edit_action %>
        <%= link_to "Edit", edit_quotation_proposal_path(@quotation_proposal), class: "app-secondary-btn" %>
      <% end %>
      <% if show_start_approval_action %>
        <%= button_to "Start Committee Approval", send_for_approval_quotation_proposal_path(@quotation_proposal), method: :post, class: "app-secondary-btn" %>
      <% end %>
      <% if show_send_vendor_action %>
        <% send_button_label = if direct_response_mode
             @quotation_proposal.sent_to_vendors_at.present? ? "Reopen Direct Form" : "Open Direct Form"
           else
             @quotation_proposal.sent_to_vendors_at.present? ? "Resend To Vendor" : "Send To Vendor"
           end %>
        <%= button_to send_button_label, send_to_vendors_quotation_proposal_path(@quotation_proposal), method: :post, class: "app-form-submit" %>
      <% end %>
      </div>
    <% end %>
  </div>

  <% if approval_request&.employee_return_pending? %>
    <div class="app-form-card" style="margin-bottom: 2rem;">
      <div class="app-page-header app-subsection-header-tight">
        <div>
          <h3 style="margin-bottom: 0.35rem;">Returned To Employee</h3>
          <p class="app-section-note mb-0">Review the returned remark, update the quotation, and save to restart the same approval chain from Committee Member 1.</p>
        </div>
      </div>

      <div class="app-detail-grid">
        <div class="app-detail-item">
          <div class="app-detail-label">Returned By</div>
          <div class="app-detail-value"><%= approval_request.employee_return_actor_label %></div>
        </div>

        <div class="app-detail-item app-detail-item-full">
          <div class="app-detail-label">Return Remark</div>
          <div class="app-detail-value" style="white-space: pre-wrap;"><%= approval_request.employee_return_remark.presence || "No remark was added." %></div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="app-detail-card quotation-proposal-show__overview-card">
    <div class="app-detail-grid quotation-proposal-show__detail-grid quotation-proposal-show__detail-grid--primary">
      <div class="app-detail-item">
        <div class="app-detail-label">Subject</div>
        <div class="app-detail-value"><%= @quotation_proposal.subject %></div>
      </div>

      <div class="app-detail-item">
        <div class="app-detail-label">Theme</div>
        <div class="app-detail-value"><%= @quotation_proposal.theme.name %></div>
      </div>

      <div class="app-detail-item">
        <div class="app-detail-label">Proposal End Date</div>
        <div class="app-detail-value"><%= @quotation_proposal.proposal_end_date.strftime("%d-%m-%Y") %></div>
      </div>

      <div class="app-detail-item">
        <div class="app-detail-label">Quotation Value</div>
        <div class="app-detail-value"><%= @quotation_proposal.procurement_amount_bucket_label %></div>
      </div>
    </div>

    <details class="quotation-proposal-show__nested-details quotation-proposal-show__section-details quotation-proposal-show__overview-details" open>
      <summary class="quotation-proposal-show__nested-summary quotation-proposal-show__section-summary">
        <div class="quotation-proposal-show__summary-copy">
          <span class="quotation-proposal-show__summary-title">More Overview Details</span>
          <span class="quotation-proposal-show__summary-note">Workflow fields, selected vendors, and criteria</span>
        </div>
        <div class="quotation-proposal-show__summary-meta">
          <span class="badge border bg-light text-dark">4 more fields</span>
          <span class="badge border bg-light text-dark"><%= @quotation_proposal.vendor_registrations.size %> vendors</span>
          <% if selected_criteria_selections.any? %>
            <span class="badge border bg-light text-dark"><%= selected_criteria_selections.size %> criteria</span>
          <% end %>
        </div>
      </summary>

      <div class="quotation-proposal-show__nested-body quotation-proposal-show__section-body">
        <div class="app-detail-grid quotation-proposal-show__detail-grid quotation-proposal-show__detail-grid--secondary">
          <div class="app-detail-item">
            <div class="app-detail-label">Workflow Status</div>
            <div class="app-detail-value"><%= @quotation_proposal.workflow_status.humanize %></div>
          </div>

          <div class="app-detail-item">
            <div class="app-detail-label">Sent To Vendor At</div>
            <div class="app-detail-value"><%= @quotation_proposal.sent_to_vendors_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
          </div>

          <div class="app-detail-item">
            <div class="app-detail-label">Selected Vendor</div>
            <div class="app-detail-value"><%= @quotation_proposal.selected_vendor_registration&.display_name || "-" %></div>
          </div>

          <div class="app-detail-item">
            <div class="app-detail-label">Remark</div>
            <div class="app-detail-value"><%= @quotation_proposal.remark.presence || "-" %></div>
          </div>

          <div class="app-detail-item app-detail-item-full">
            <div class="app-detail-label">Selected Vendors</div>
            <div class="app-detail-value">
              <div class="d-flex flex-wrap gap-2">
                <% @quotation_proposal.vendor_registrations.each do |vendor| %>
                  <span class="badge border bg-light text-dark px-3 py-2 quotation-proposal-show__tag">
                    <%= vendor.display_name %>
                  </span>
                <% end %>
              </div>
            </div>
          </div>

          <% if selected_criteria_selections.any? %>
            <div class="app-detail-item app-detail-item-full">
              <div class="app-detail-label">Vendor Selection Criteria</div>
              <div class="app-detail-value">
                <div class="quotation-proposal-show__tag-list">
                  <% selected_criteria_selections.each do |criterion_selection| %>
                    <span class="badge border bg-light text-dark px-3 py-2 quotation-proposal-show__tag">
                      <%= criterion_selection.display_label %>
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </details>
  </div>

<% if creator_can_dispatch && direct_response_mode && @quotation_proposal.committee_completed? %>
  <div class="app-detail-card app-stack-gap-lg">
    <div class="app-page-header app-subsection-header-tight">
      <div>
        <h3 style="margin-bottom: 0.25rem;">Direct Response Forms</h3>
        <p class="app-section-note mb-0">
          For below 10K cases, no mobile link is sent to the vendor.
          After approval, the maker can open the vendor form directly from here and fill in the details.
        </p>
      </div>
    </div>

    <% if @quotation_proposal.sent_to_vendors_at.present? %>
      <div class="d-flex flex-wrap gap-2">
        <% @quotation_proposal.quotation_proposal_vendors.includes(:vendor_registration).each do |proposal_vendor| %>
          <%= link_to "Open #{proposal_vendor.vendor_registration.display_name} Form", quotation_vendor_qr_path(proposal_vendor.qr_token, verified: 1, direct_access: 1), class: "app-secondary-btn" %>
        <% end %>
      </div>
    <% else %>
      <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
        <p class="app-section-note mb-0">Committee approval is complete. Use the button below to open the direct vendor form.</p>
        <%= button_to "Open Vendor Form", send_to_vendors_quotation_proposal_path(@quotation_proposal), method: :post, class: "app-form-submit" %>
      </div>
    <% end %>
  </div>
<% end %>

  <div class="app-detail-card app-stack-gap-lg">
    <details class="quotation-proposal-show__nested-details quotation-proposal-show__section-details" open>
      <summary class="quotation-proposal-show__nested-summary quotation-proposal-show__section-summary">
        <div class="quotation-proposal-show__summary-copy">
          <span class="quotation-proposal-show__summary-title">Committee Approval Trail</span>
          <span class="quotation-proposal-show__summary-note">Approval levels, timestamps, and remarks</span>
        </div>
        <div class="quotation-proposal-show__summary-meta">
          <span class="badge border bg-light text-dark"><%= trail_completed_count %>/<%= committee_trail_steps.size %> updated</span>
          <% if pending_approval_count.positive? %>
            <span class="badge border bg-warning bg-opacity-10 text-warning"><%= pending_approval_count %> pending</span>
          <% end %>
        </div>
      </summary>

      <div class="quotation-proposal-show__nested-body quotation-proposal-show__section-body">
        <div class="row g-3">
    <% committee_trail_steps.each do |step| %>
      <% step_status = if committee_approval_started
           step.respond_to?(:effective_status) ? step.effective_status : step.status
         else
           "waiting"
         end %>
      <% step_label = if committee_approval_started
           step.respond_to?(:effective_status_label) ? step.effective_status_label : step.status_label
         else
           "Not Started"
         end %>
      <% step_class = case step_status
         when "approved" then "border-success bg-success bg-opacity-10 text-success"
         when "returned" then "border-warning bg-warning bg-opacity-10 text-warning"
         when "rejected" then "border-danger bg-danger bg-opacity-10 text-danger"
         when "pending" then "border-info bg-info bg-opacity-10 text-info"
         else "border-secondary bg-light text-secondary"
         end %>
      <div class="col-md-6 col-xl-3">
        <div class="app-detail-item h-100 border <%= step_class %>">
          <div class="app-detail-label">L<%= step.level %></div>
          <div class="app-detail-value fw-semibold"><%= step.employee_master.name %></div>
          <div class="small text-muted mt-1"><%= step.employee_master.designation.presence || WorkflowLevelNaming.humanize_level_label(step.level) %></div>
          <div class="mt-2"><strong>Status:</strong> <%= step_label %></div>
          <div class="mt-1"><strong>Time:</strong> <%= committee_approval_started ? (step.actioned_at&.strftime("%d-%m-%Y %H:%M") || "-") : "-" %></div>
          <div class="mt-1"><strong>Remark:</strong> <%= committee_approval_started ? (step.remark.presence || "-") : "-" %></div>
        </div>
      </div>
    <% end %>
        </div>
      </div>
    </details>
  </div>

<% if approver_view %>
  <div class="app-form-card app-stack-gap-lg">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div>
        <h3 style="margin-bottom: 0.35rem;">Committee Action</h3>
        <p class="app-section-note mb-0">Once committee approval starts, each pending member can approve, return, or reject from their own login. A return goes directly to the employee, and resubmission syncs the approval chain again.</p>
      </div>
      <span class="badge border bg-info bg-opacity-10 text-info px-3 py-2" style="font-size: 0.9rem;">
        Pending For You: L<%= current_step.level %>
      </span>
    </div>

    <div class="d-flex align-items-center gap-3 flex-wrap mt-3">
      <%= render "approval_requests/approve_modal",
        approval_request: approval_request,
        modal_id: "approve-approval-request-#{approval_request.id}",
        trigger_label: "Approve",
        trigger_class: "app-primary-btn px-4" %>

      <%= render "approval_requests/return_modal",
        approval_request: approval_request,
        current_step: user_pending_step,
        modal_id: "return-approval-request-#{approval_request.id}",
        trigger_label: "Return",
        trigger_class: "app-secondary-btn px-4" %>

      <%= render "approval_requests/reject_modal",
        approval_request: approval_request,
        modal_id: "reject-approval-request-#{approval_request.id}",
        trigger_label: "Reject",
        trigger_class: "app-danger-btn px-4" %>
    </div>
  </div>
<% end %>

  <div class="app-detail-card app-stack-gap-lg">
    <details class="quotation-proposal-show__nested-details quotation-proposal-show__section-details" open>
      <summary class="quotation-proposal-show__nested-summary quotation-proposal-show__section-summary">
        <div class="quotation-proposal-show__summary-copy">
          <span class="quotation-proposal-show__summary-title">Proposal Items</span>
          <span class="quotation-proposal-show__summary-note">Requested items, quantities, max rates, and remarks</span>
        </div>
        <div class="quotation-proposal-show__summary-meta">
          <span class="badge border bg-light text-dark">Total Items: <%= proposal_items_count %></span>
        </div>
      </summary>

      <div class="quotation-proposal-show__nested-body quotation-proposal-show__section-body">
        <div class="app-table-wrap quotation-proposal-show__table-wrap">
          <table class="table app-table">
          <thead>
            <tr>
              <th>Item Name</th>
              <th>Unit</th>
              <th>Quantity</th>
              <th>Max Rate</th>
              <th>Remark</th>
            </tr>
          </thead>
          <tbody>
            <% @quotation_proposal.quotation_proposal_items.each do |item| %>
              <tr>
                <td><%= quotation_item_display_name(item.item_name) %></td>
                <td><%= item.unit.name %></td>
                <td><%= item.quantity %></td>
                <td><%= item.max_rate.present? ? number_with_precision(item.max_rate, precision: 2) : "-" %></td>
                <td><%= item.remark.presence || "-" %></td>
              </tr>
            <% end %>
          </tbody>
          </table>
        </div>
      </div>
    </details>
  </div>

<% if @quotation_proposal.vendor_responses_received? && @quotation_proposal.missing_max_rates? %>
  <div class="app-detail-card app-stack-gap-lg">
    <div class="app-page-header app-subsection-header-tight">
      <div>
        <h3 style="margin-bottom: 0.25rem;">Max Rate Pending</h3>
        <p class="app-section-note mb-0">
          Complete the max rate for all missing items before starting committee comparison.
          Missing items: <%= @quotation_proposal.missing_max_rate_items.map { |item| quotation_item_display_name(item.item_name) }.join(", ") %>
        </p>
      </div>
    </div>

    <% if current_user == @quotation_proposal.user %>
      <div>
        <%= link_to "Fill Max Rate", edit_quotation_proposal_path(@quotation_proposal), class: "app-form-submit" %>
      </div>
    <% end %>
  </div>
<% end %>

<% if @quotation_proposal.vendor_responses_received? && !direct_response_mode && @quotation_proposal.all_max_rates_present? %>
  <div class="app-detail-card app-stack-gap-lg">
    <div class="app-page-header app-subsection-header-tight">
      <div>
        <h3 style="margin-bottom: 0.25rem;">Committee Comparison</h3>
      </div>
      <span class="badge border bg-light text-dark px-3 py-2" style="font-size: 0.9rem;">
        <%= committee_scoring_allowed ? "Committee scoring access" : "View only" %>
      </span>
    </div>

    <% comparison_vendors = QuotationProposalVendor.where(quotation_proposal_id: @quotation_proposal.id).includes(vendor_registration: [], committee_member_scores: :employee_master, committee_criteria_scores: :quotation_proposal_criteria_selection, vendor_items: { quotation_proposal_item: :unit }) %>
    <% responded_vendors = comparison_vendors.select(&:response_submitted?) %>
    <% committee_scoring_complete = @quotation_proposal.committee_scoring_complete? %>
    <% selected_vendor_registration_id = @quotation_proposal.selected_vendor_registration_id %>
    <% lowest_amount_vendor_id = responded_vendors.min_by { |vendor| vendor.total_quoted_amount.to_d }&.id %>
    <% lowest_grand_total_vendor_id = responded_vendors.min_by { |vendor| vendor.grand_total_amount.to_d }&.id %>
    <% top_rank_vendor_id = responded_vendors.find { |vendor| vendor.rank_position == 1 }&.id %>
    <% criteria_selection_ids = selected_criteria_selections.map(&:id) %>
    <% current_employee_criteria_map = if criteria_based_scoring && @current_scoring_employee.present?
         comparison_vendors.each_with_object({}) do |proposal_vendor, memo|
           memo[proposal_vendor.id] = proposal_vendor.criteria_scores_for(@current_scoring_employee)
         end
       else
         {}
       end %>
    <% criteria_total_scores_map = if criteria_based_scoring
         comparison_vendors.each_with_object({}) do |proposal_vendor, memo|
           memo[proposal_vendor.id] = proposal_vendor.criteria_score_totals_for_selection_ids(criteria_selection_ids)
         end
       else
         {}
       end %>
    <% if criteria_based_scoring %>
      <div class="quotation-proposal-show__criteria-panel">
        <div>
          <h4 class="quotation-proposal-show__criteria-title">Committee Evaluation Criteria</h4>
          <p class="quotation-proposal-show__criteria-note">Committee members assign marks from 0 to 10 for every selected criterion. Vendor ranking is based on the overall marks total.</p>
        </div>

        <% unless committee_scoring_allowed %>
          <div class="quotation-proposal-show__criteria-help">
            This screen is in view-only mode for your current login. Use an assigned committee member login to enter marks.
          </div>
        <% end %>

        <div class="quotation-proposal-show__tag-list">
          <% selected_criteria_selections.each do |criterion_selection| %>
            <span class="badge border bg-light text-dark px-3 py-2 quotation-proposal-show__tag">
              <%= criterion_selection.display_label %>
            </span>
          <% end %>
        </div>
      </div>
    <% end %>
    <%= form_with url: score_vendors_quotation_proposal_path(@quotation_proposal), method: :patch, local: true do %>
      <div class="app-table-wrap" style="overflow-x: auto; overflow-y: visible;">
        <table class="table app-table" style="min-width: <%= 320 + (comparison_vendors.size * 280) %>px;">
        <thead>
          <tr>
            <th class="quotation-proposal-show__comparison-sticky quotation-proposal-show__comparison-sticky--head" style="min-width: 240px;">Compare Field</th>
            <% comparison_vendors.each do |proposal_vendor| %>
              <% proposal_vendor_selected = selected_vendor_registration_id.present? && proposal_vendor.vendor_registration_id == selected_vendor_registration_id %>
              <% header_style = if proposal_vendor_selected
                "background: linear-gradient(180deg, #effaf3 0%, #ffffff 100%); border-bottom: 2px solid #198754;"
              elsif proposal_vendor.id == top_rank_vendor_id
                "background: linear-gradient(180deg, #fff8e8 0%, #ffffff 100%); border-bottom: 2px solid #f0ad00;"
              else
                "background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);"
              end %>
              <th style="min-width: 280px; vertical-align: top; <%= header_style %>">
                <div style="display: flex; flex-direction: column; gap: 0.45rem;">
                <div class="fw-semibold" style="font-size: 1rem;"><%= proposal_vendor.vendor_registration.display_name %></div>
                <div class="small text-muted"><%= proposal_vendor.response_status.humanize %></div>
                <div class="d-flex gap-2 flex-wrap">
                    <% if proposal_vendor_selected %>
                      <span class="badge border bg-success bg-opacity-10 text-success">Selected</span>
                      <% if creator_can_dispatch %>
                        <div style="display: flex; gap: 0.45rem; align-items: center; flex-wrap: wrap; margin: 0;">
                          <%= link_to "Create Purchase Order",
                                purchase_order_quotation_proposal_path(@quotation_proposal),
                                class: "app-secondary-btn",
                                style: "padding: 0.35rem 0.8rem; font-size: 0.82rem;" %>
                        </div>
                      <% end %>
                      <% if proposal_vendor.purchase_order_status.present? && proposal_vendor.purchase_order_status != "draft" %>
                        <span class="badge border <%= proposal_vendor.purchase_order_status == "accepted" ? "bg-success bg-opacity-10 text-success" : proposal_vendor.purchase_order_status == "returned" ? "bg-warning bg-opacity-10 text-warning" : proposal_vendor.purchase_order_status == "rejected" ? "bg-danger bg-opacity-10 text-danger" : "bg-primary bg-opacity-10 text-primary" %>">
                          PO <%= proposal_vendor.purchase_order_status.humanize %>
                        </span>
                      <% end %>
                    <% end %>
                    <% if proposal_vendor.id == top_rank_vendor_id %>
                      <span class="badge border bg-warning bg-opacity-10 text-warning">Top Rank</span>
                    <% end %>
                    <% if proposal_vendor.id == lowest_grand_total_vendor_id %>
                      <span class="badge border bg-primary bg-opacity-10 text-primary">Best Price</span>
                    <% end %>
                  </div>
                </div>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="quotation-proposal-show__comparison-sticky">
              <strong><%= criteria_based_scoring ? "Criteria Marks" : "Your Committee Score" %></strong>
              <% if criteria_based_scoring %>
                <div class="small text-muted mt-1">Enter marks for every criterion. A vendor is fully scored only after all selected criteria receive marks.</div>
              <% end %>
            </td>
            <% comparison_vendors.each do |proposal_vendor| %>
              <td>
                <% if proposal_vendor.response_submitted? %>
                  <% member_score_value = @current_scoring_employee.present? ? proposal_vendor.score_for(@current_scoring_employee) : nil %>
                  <% member_remark_value = @current_scoring_employee.present? ? proposal_vendor.remark_for(@current_scoring_employee) : nil %>
                  <% saved_score_remarks = proposal_vendor.score_remarks %>
                  <% if criteria_based_scoring %>
                    <% if committee_scoring_allowed %>
                      <div class="quotation-proposal-show__criteria-checklist">
                        <% selected_criteria_selections.each do |criterion_selection| %>
                          <% saved_score = current_employee_criteria_map.fetch(proposal_vendor.id, {}).fetch(criterion_selection.id, nil) %>
                          <label class="quotation-proposal-show__criteria-check quotation-proposal-show__criteria-check--score">
                            <span class="quotation-proposal-show__criteria-check-label"><%= criterion_selection.display_label %></span>
                            <span class="quotation-proposal-show__criteria-score-wrap">
                              <%= number_field_tag "committee_criteria_scores[#{proposal_vendor.id}][#{criterion_selection.id}]",
                                                   saved_score,
                                                   min: 0,
                                                   max: 10,
                                                   step: 1,
                                                   placeholder: "0",
                                                   class: "form-control quotation-proposal-show__criteria-score-input" %>
                              <span class="quotation-proposal-show__criteria-score-scale">/10</span>
                            </span>
                          </label>
                        <% end %>
                      </div>
                      <div class="quotation-proposal-show__criteria-remark">
                        <label class="quotation-proposal-show__criteria-remark-label">Your Remark</label>
                        <%= text_area_tag "committee_remarks[#{proposal_vendor.id}]",
                                          member_remark_value,
                                          rows: 3,
                                          class: "form-control quotation-proposal-show__criteria-remark-input",
                                          placeholder: "Add a short committee remark for this vendor" %>
                      </div>
                    <% else %>
                      <div class="quotation-proposal-show__criteria-list">
                        <% selected_criteria_selections.each do |criterion_selection| %>
                          <% criterion_total = criteria_total_scores_map.fetch(proposal_vendor.id, {}).fetch(criterion_selection.id, 0) %>
                          <div class="quotation-proposal-show__criteria-check quotation-proposal-show__criteria-check--read-only">
                            <span class="quotation-proposal-show__criteria-check-label"><%= criterion_selection.display_label %></span>
                            <strong class="quotation-proposal-show__criteria-score-badge"><%= criterion_total %></strong>
                          </div>
                        <% end %>
                      </div>
                      <% if saved_score_remarks.any? %>
                        <div class="quotation-proposal-show__criteria-remarks-list">
                          <% saved_score_remarks.each do |author_name, remark_text| %>
                            <div class="quotation-proposal-show__criteria-remark-card">
                              <strong><%= author_name %></strong>
                              <span><%= remark_text %></span>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    <% end %>
                    <div class="small text-muted mt-2">
                      <% if committee_scoring_allowed %>
                        Scored criteria: <strong><%= current_employee_criteria_map.fetch(proposal_vendor.id, {}).size %>/<%= selected_criteria_selections.size %></strong>
                        | Your total marks: <strong><%= member_score_value.nil? ? "Incomplete" : member_score_value %>/<%= selected_criteria_selections.size * 10 %></strong>
                      <% else %>
                        Overall criterion-wise marks awarded by the committee are shown above.
                      <% end %>
                    </div>
                  <% elsif committee_scoring_allowed %>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                      <span class="quotation-proposal-show__criteria-score-wrap quotation-proposal-show__criteria-score-wrap--manual">
                        <%= number_field_tag "committee_scores[#{proposal_vendor.id}]",
                                             member_score_value,
                                             min: 0,
                                             placeholder: "0",
                                             class: "form-control quotation-proposal-show__criteria-score-input quotation-proposal-show__criteria-score-input--manual" %>
                        <span class="quotation-proposal-show__criteria-score-scale quotation-proposal-show__criteria-score-scale--manual">Score</span>
                      </span>
                    </div>
                    <div class="quotation-proposal-show__criteria-remark">
                      <label class="quotation-proposal-show__criteria-remark-label">Your Remark</label>
                      <%= text_area_tag "committee_remarks[#{proposal_vendor.id}]",
                                        member_remark_value,
                                        rows: 3,
                                        class: "form-control quotation-proposal-show__criteria-remark-input",
                                        placeholder: "Add a short committee remark for this vendor" %>
                    </div>
                  <% else %>
                    <span class="text-muted">Committee members can update score</span>
                    <% if saved_score_remarks.any? %>
                      <div class="quotation-proposal-show__criteria-remarks-list">
                        <% saved_score_remarks.each do |author_name, remark_text| %>
                          <div class="quotation-proposal-show__criteria-remark-card">
                            <strong><%= author_name %></strong>
                            <span><%= remark_text %></span>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  <% end %>
                  <% unless criteria_based_scoring %>
                    <div class="small text-muted mt-2">
                      Your saved score: <strong><%= member_score_value.nil? ? "Not scored yet" : member_score_value %></strong>
                    </div>
                  <% end %>
                  <div class="small text-muted mt-1">
                    <% if criteria_based_scoring && committee_scoring_allowed %>
                      Saved score from criteria: <strong><%= member_score_value.nil? ? "Incomplete" : member_score_value %></strong>
                      |
                    <% end %>
                    Total score: <strong><%= proposal_vendor.committee_score_value.presence || "Not scored yet" %></strong>
                    | Scored by: <strong><%= proposal_vendor.committee_score_count %>/<%= @committee_member_count %></strong>
                  </div>
                <% else %>
                  <span class="text-muted">Awaiting vendor response</span>
                <% end %>
              </td>
            <% end %>
          </tr>
          <% if committee_scoring_allowed %>
            <tr>
              <td class="quotation-proposal-show__comparison-sticky"><strong><%= criteria_based_scoring ? "Save Criteria Marks" : "Save Scores" %></strong></td>
              <td colspan="<%= comparison_vendors.size %>">
                <div class="d-flex justify-content-end">
                  <%= submit_tag(criteria_based_scoring ? "Save Criteria-Based Marks" : "Save All Committee Scores", class: "app-form-submit") %>
                </div>
              </td>
            </tr>
          <% end %>
          <tr>
            <td style="position: sticky; left: 0; z-index: 2; background: #fdfefe; box-shadow: 8px 0 18px rgba(26, 58, 42, 0.03);"><strong>Rank</strong></td>
            <% comparison_vendors.each do |proposal_vendor| %>
              <td style="<%= 'background: #fff8e8;' if proposal_vendor.id == top_rank_vendor_id %>">
                <%= proposal_vendor.rank_position || "-" %>
              </td>
            <% end %>
          </tr>
          <tr>
            <td style="position: sticky; left: 0; z-index: 2; background: #fdfefe; box-shadow: 8px 0 18px rgba(26, 58, 42, 0.03);"><strong>Selected</strong></td>
            <% comparison_vendors.each do |proposal_vendor| %>
              <% proposal_vendor_selected = selected_vendor_registration_id.present? && proposal_vendor.vendor_registration_id == selected_vendor_registration_id %>
              <td style="<%= 'background: #effaf3;' if proposal_vendor_selected %>"><%= proposal_vendor_selected ? "Yes" : "No" %></td>
            <% end %>
          </tr>
          <tr>
            <td style="position: sticky; left: 0; z-index: 2; background: #fdfefe; box-shadow: 8px 0 18px rgba(26, 58, 42, 0.03);"><strong>Purchase Order</strong></td>
            <% comparison_vendors.each do |proposal_vendor| %>
              <td>
                <%= proposal_vendor.purchase_order_status.to_s.humanize.presence || "Draft" %>
                <div class="small text-muted mt-1">Sent: <%= proposal_vendor.purchase_order_sent_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
                <div class="small text-muted mt-1">Response: <%= proposal_vendor.purchase_order_actioned_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
                <% if proposal_vendor.purchase_order_remark.present? %>
                  <div class="small text-muted mt-1"><strong>Remark:</strong> <%= proposal_vendor.purchase_order_remark %></div>
                <% end %>
              </td>
            <% end %>
          </tr>
          <tr>
            <td style="position: sticky; left: 0; z-index: 2; background: #fdfefe; box-shadow: 8px 0 18px rgba(26, 58, 42, 0.03);"><strong>Amount Total</strong></td>
            <% comparison_vendors.each do |proposal_vendor| %>
              <td style="<%= 'background: #f5fbf7;' if proposal_vendor.id == lowest_amount_vendor_id %>">
                <%= number_with_precision(proposal_vendor.total_quoted_amount, precision: 2) %>
              </td>
            <% end %>
          </tr>
          <tr>
            <td style="position: sticky; left: 0; z-index: 2; background: #fdfefe; box-shadow: 8px 0 18px rgba(26, 58, 42, 0.03);"><strong>Grand Total</strong></td>
            <% comparison_vendors.each do |proposal_vendor| %>
              <td style="<%= 'background: #eef8ff;' if proposal_vendor.id == lowest_grand_total_vendor_id %>">
                <%= number_with_precision(proposal_vendor.grand_total_amount, precision: 2) %>
              </td>
            <% end %>
          </tr>
          <tr>
            <td style="position: sticky; left: 0; z-index: 2; background: #fdfefe; box-shadow: 8px 0 18px rgba(26, 58, 42, 0.03);"><strong>Selection Status</strong></td>
            <% comparison_vendors.each do |proposal_vendor| %>
              <% proposal_vendor_selected = selected_vendor_registration_id.present? && proposal_vendor.vendor_registration_id == selected_vendor_registration_id %>
              <td>
                <% if committee_scoring_complete && proposal_vendor_selected %>
                  <span class="badge border bg-success bg-opacity-10 text-success">Auto selected by top rank</span>
                <% elsif proposal_vendor.response_submitted? && proposal_vendor.committee_score_value.present? && !committee_scoring_complete %>
                  <span class="text-muted">Waiting for all committee scores</span>
                <% elsif proposal_vendor.response_submitted? && proposal_vendor.committee_score_value.present? %>
                  <span class="text-muted">Selection follows rank order</span>
                <% else %>
                  <span class="text-muted">Selection pending score</span>
                <% end %>
              </td>
            <% end %>
          </tr>
          <% @quotation_proposal.quotation_proposal_items.includes(:unit).each do |proposal_item| %>
            <tr>
              <td style="position: sticky; left: 0; z-index: 2; background: #fdfefe; box-shadow: 8px 0 18px rgba(26, 58, 42, 0.03);">
                <strong><%= quotation_item_display_name(proposal_item.item_name) %></strong>
                <div class="small text-muted mt-1">
                  Qty: <%= proposal_item.quantity %> <%= proposal_item.unit.name %>
                </div>
                <div class="small text-muted">
                  Proposal Remark: <%= proposal_item.remark.presence || "-" %>
                </div>
              </td>
              <% comparison_vendors.each do |proposal_vendor| %>
                <% vendor_item = proposal_vendor.vendor_items.find { |item| item.quotation_proposal_item_id == proposal_item.id } %>
                <% proposal_vendor_selected = selected_vendor_registration_id.present? && proposal_vendor.vendor_registration_id == selected_vendor_registration_id %>
                <td style="<%= 'background: #fbfff7;' if proposal_vendor_selected %>">
                  <div><strong>Rate:</strong> <%= vendor_item&.quoted_rate.present? ? number_with_precision(vendor_item.quoted_rate, precision: 2) : "-" %></div>
                  <div class="mt-1"><strong>Amount:</strong> <%= vendor_item&.line_total.present? ? number_with_precision(vendor_item.line_total, precision: 2) : "-" %></div>
                  <div class="mt-1"><strong>GST %:</strong> <%= vendor_item&.gst_percentage.present? ? number_with_precision(vendor_item.gst_percentage, precision: 2) : "-" %></div>
                  <div class="mt-1"><strong>Grand Total:</strong> <%= vendor_item&.grand_total.present? ? number_with_precision(vendor_item.grand_total, precision: 2) : "-" %></div>
                  <div class="mt-1"><strong>Remark:</strong> <%= vendor_item&.remark.presence || "-" %></div>
                </td>
              <% end %>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% if @selected_vendor_response.present? %>
      <div class="app-card mt-4 quotation-proposal-show__workflow-card">
        <details class="quotation-proposal-show__nested-details quotation-proposal-show__section-details" open>
          <summary class="quotation-proposal-show__nested-summary quotation-proposal-show__section-summary">
            <div class="quotation-proposal-show__summary-copy">
              <span class="quotation-proposal-show__summary-title">Selected Vendor PO Workflow</span>
              <span class="quotation-proposal-show__summary-note">Vendor reply, PO updates, invoice requests, and activity trail</span>
            </div>
            <div class="quotation-proposal-show__summary-meta">
              <span class="badge border bg-light text-dark"><%= @selected_vendor_response.invoice_requests.size %> invoice requests</span>
              <span class="badge border bg-light text-dark"><%= @selected_vendor_response.purchase_order_activities.size %> updates</span>
              <span class="badge border <%= @selected_vendor_response.purchase_order_status == "accepted" ? "bg-success bg-opacity-10 text-success" : @selected_vendor_response.purchase_order_status == "returned" ? "bg-warning bg-opacity-10 text-warning" : @selected_vendor_response.purchase_order_status == "rejected" ? "bg-danger bg-opacity-10 text-danger" : "bg-primary bg-opacity-10 text-primary" %>">
                <%= @selected_vendor_response.purchase_order_status.to_s.humanize %>
              </span>
            </div>
          </summary>

          <div class="quotation-proposal-show__nested-body quotation-proposal-show__section-body quotation-proposal-show__section-body--workflow">
        <div class="d-flex justify-content-between gap-3 flex-wrap align-items-start quotation-proposal-show__workflow-header">
          <div class="quotation-proposal-show__workflow-header-copy">
            <p class="app-section-note mb-0">Maker and committee members can review vendor responses, reply updates, and the full dated timeline here.</p>
          </div>
          <div class="d-flex gap-2 flex-wrap quotation-proposal-show__workflow-badges">
            <% if current_user == @quotation_proposal.user && @selected_vendor_response.purchase_order_status == "accepted" %>
              <%= link_to "Goods Receive", goods_receive_quotation_proposal_path(@quotation_proposal), class: "app-form-submit" %>
            <% end %>
            <% if @selected_vendor_response.pending_invoice_requests? %>
              <span class="badge border bg-warning bg-opacity-10 text-warning">Invoice Pending</span>
            <% end %>
            <span class="badge border <%= @selected_vendor_response.purchase_order_status == "accepted" ? "bg-success bg-opacity-10 text-success" : @selected_vendor_response.purchase_order_status == "returned" ? "bg-warning bg-opacity-10 text-warning" : @selected_vendor_response.purchase_order_status == "rejected" ? "bg-danger bg-opacity-10 text-danger" : "bg-primary bg-opacity-10 text-primary" %>">
              <%= @selected_vendor_response.purchase_order_status.to_s.humanize %>
            </span>
            <span class="badge border bg-light text-dark">Sent: <%= @selected_vendor_response.purchase_order_sent_at&.strftime("%d-%m-%Y %H:%M") || "-" %></span>
            <span class="badge border bg-light text-dark">Response: <%= @selected_vendor_response.purchase_order_actioned_at&.strftime("%d-%m-%Y %H:%M") || "-" %></span>
          </div>
        </div>

        <div class="row g-3 mt-1">
          <div class="col-lg-6">
            <div class="app-detail-item h-100">
              <div class="app-detail-label">Vendor Response</div>
              <div class="app-detail-value"><%= @selected_vendor_response.purchase_order_status.to_s.humanize %></div>
              <div class="small text-muted mt-1">Action time: <%= @selected_vendor_response.purchase_order_actioned_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
              <div class="mt-2 quotation-proposal-show__prewrap"><%= @selected_vendor_response.purchase_order_remark.presence || "No vendor remark added." %></div>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="app-detail-item h-100">
              <div class="app-detail-label">ASA Reply</div>
              <div class="app-detail-value quotation-proposal-show__prewrap"><%= @selected_vendor_response.purchase_order_reply.presence || "No reply added yet." %></div>
              <div class="small text-muted mt-2">
                Updated by: <strong><%= @selected_vendor_response.purchase_order_reply_updated_by&.name.presence || "-" %></strong>
              </div>
              <div class="small text-muted mt-1">
                Updated at: <strong><%= @selected_vendor_response.purchase_order_reply_updated_at&.strftime("%d-%m-%Y %H:%M") || "-" %></strong>
              </div>
            </div>
          </div>
        </div>

        <% if current_user == @quotation_proposal.user || @quotation_proposal.committee_user?(current_user) %>
          <div class="mt-4">
            <%= form_with url: update_purchase_order_reply_quotation_proposal_path(@quotation_proposal, proposal_vendor_id: @selected_vendor_response.id), method: :patch, local: true do %>
              <div class="mb-2">
                <label class="form-label" style="font-weight: 700;">Reply / Update For Vendor</label>
                <%= text_area_tag :purchase_order_reply, @selected_vendor_response.purchase_order_reply, rows: 4, class: "form-control", placeholder: "Write the official reply here. Both maker and committee members can update it." %>
              </div>
              <div class="d-flex justify-content-end">
                <%= submit_tag "Save Reply Update", class: "app-form-submit" %>
              </div>
            <% end %>
          </div>
        <% end %>

        <div class="mt-4">
          <h4 style="margin-bottom: 0.85rem;">Goods Receive Invoice Requests</h4>
          <% finance_ready_requests = @selected_vendor_response.invoice_requests.recent_first.select { |request| request.accepted? && !request.payment_reference_assigned? } %>
          <% if current_user == @quotation_proposal.user %>
            <div class="quotation-proposal-show__finance-panel">
              <div class="d-flex justify-content-between gap-3 flex-wrap align-items-start">
                <div>
                  <div class="quotation-proposal-show__finance-panel-title">Send Accepted Invoices To Finance</div>
                  <div class="small text-muted mt-1">Select the accepted invoices to move them into the finance queue with the same PDO, RFP, and date details.</div>
                </div>
                <% if finance_queue_access? && @selected_vendor_response.invoice_requests.any?(&:payment_advice_pending?) %>
                  <%= link_to "Open Finance Queue", payment_advice_quotation_proposals_path, class: "app-secondary-btn" %>
                <% end %>
              </div>

              <% if finance_ready_requests.any? %>
                <%= form_with url: assign_payment_references_quotation_proposal_path(@quotation_proposal), method: :patch, local: true do %>
                  <div class="mt-3 d-flex gap-2 flex-wrap quotation-proposal-show__finance-panel-chips">
                    <% finance_ready_requests.each do |invoice_request| %>
                      <label class="quotation-proposal-show__finance-chip">
                        <%= check_box_tag "invoice_request_ids[]", invoice_request.id, false %>
                        <span>Invoice Request <%= invoice_request.id %></span>
                      </label>
                    <% end %>
                  </div>

                  <div class="row g-3 mt-2">
                    <div class="col-md-4">
                      <label class="form-label" style="font-weight: 700;">PDO No</label>
                      <%= text_field_tag :pdo_no, nil, class: "form-control", required: true %>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label" style="font-weight: 700;">RFP No</label>
                      <%= text_field_tag :rfp_no, nil, class: "form-control", required: true %>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label" style="font-weight: 700;">RFP Create Date</label>
                      <%= date_field_tag :rfp_created_on, nil, class: "form-control", required: true %>
                    </div>
                  </div>

                  <div class="d-flex justify-content-end mt-3">
                    <%= submit_tag "Move Selected Invoices To Finance", class: "app-form-submit" %>
                  </div>
                <% end %>
              <% else %>
                <div class="small text-muted mt-3">No accepted invoice request is pending for finance reference entry.</div>
              <% end %>
            </div>
          <% end %>

          <div class="d-grid gap-3 quotation-proposal-show__invoice-request-list">
            <% if @selected_vendor_response.invoice_requests.recent_first.any? %>
              <% @selected_vendor_response.invoice_requests.recent_first.each do |invoice_request| %>
                <%= render "invoice_request_card", invoice_request: invoice_request %>
              <% end %>
            <% else %>
              <div class="text-muted">Vendor invoice upload requests appear here after goods receive.</div>
            <% end %>
          </div>
        </div>

        <% if @selected_vendor_response.purchase_order_activities.any? %>
          <div class="mt-4 quotation-proposal-show__timeline-block">
            <div class="d-flex justify-content-between gap-3 flex-wrap align-items-end quotation-proposal-show__timeline-header" style="margin-bottom: 0.85rem;">
              <div>
                <h4 style="margin-bottom: 0.2rem;">Response Timeline</h4>
                <p class="app-section-note mb-0">All purchase order, invoice, finance, and asset updates in one compact trail.</p>
              </div>
              <span class="badge border bg-light text-dark"><%= @selected_vendor_response.purchase_order_activities.size %> updates</span>
            </div>
            <details class="quotation-proposal-show__timeline-details" open>
              <summary class="quotation-proposal-show__timeline-summary">
                <span>View Response Timeline</span>
                <span class="badge border bg-light text-dark"><%= @selected_vendor_response.purchase_order_activities.size %> updates</span>
              </summary>
              <div class="d-none d-md-grid quotation-proposal-show__timeline-grid quotation-proposal-show__timeline-grid--head">
                <div>Name</div>
                <div>Role</div>
                <div>Status</div>
                <div>Date & Time</div>
                <div>Invoice Details</div>
              </div>

              <% @selected_vendor_response.purchase_order_activities.recent_first.each_with_index do |activity, index| %>
                <div class="quotation-proposal-show__timeline-row <%= "quotation-proposal-show__timeline-row--last" if index == @selected_vendor_response.purchase_order_activities.size - 1 %>">
                  <div class="d-grid quotation-proposal-show__timeline-grid">
                    <div class="quotation-proposal-show__timeline-cell">
                      <div class="small text-muted d-md-none mb-1">Name</div>
                      <div class="quotation-proposal-show__timeline-actor"><%= activity.actor_name %></div>
                    </div>
                    <div class="quotation-proposal-show__timeline-cell">
                      <div class="small text-muted d-md-none mb-1">Role</div>
                      <span class="badge border bg-light text-dark"><%= activity.actor_role.presence || "Update" %></span>
                    </div>
                    <div class="quotation-proposal-show__timeline-cell">
                      <div class="small text-muted d-md-none mb-1">Status</div>
                      <span class="badge border bg-info bg-opacity-10 text-info quotation-proposal-show__timeline-status"><%= activity.action_type.to_s.humanize %></span>
                    </div>
                    <div class="quotation-proposal-show__timeline-cell">
                      <div class="small text-muted d-md-none mb-1">Date & Time</div>
                      <div class="small text-muted quotation-proposal-show__timeline-date"><%= activity.occurred_at.strftime("%d-%m-%Y %H:%M") %></div>
                    </div>
                    <div class="quotation-proposal-show__timeline-cell">
                      <div class="small text-muted d-md-none mb-1">Invoice Details</div>
                      <div class="quotation-proposal-show__timeline-note">
                        <% if activity.note.present? %>
                          <div class="text-muted quotation-proposal-show__timeline-note-text">
                            <%= simple_format(activity.note, {}, wrapper_tag: "div") %>
                          </div>
                        <% else %>
                          <div class="text-muted quotation-proposal-show__timeline-note-text">-</div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </details>
          </div>
        <% end %>
          </div>
        </details>
      </div>
    <% end %>
  </div>
<% end %>

</div>
