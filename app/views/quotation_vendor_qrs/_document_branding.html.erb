<%
  vendor_name = local_assigns[:vendor_name]
  stakeholder_category = local_assigns[:stakeholder_category] || @stakeholder_category
%>

<style>
  .doc-branding-shell {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 1.15rem 1.25rem;
    border: 1px solid #d4e8df;
    display: block;
    align-self: stretch;
    margin: 0 0 1rem !important;
    width: 100% !important;
    min-width: 0 !important;
    max-width: none !important;
    border-radius: 24px;
    background:
      radial-gradient(circle at top left, rgba(242, 177, 52, 0.14), transparent 26%),
      radial-gradient(circle at bottom right, rgba(11, 74, 79, 0.1), transparent 24%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(245, 250, 247, 0.98));
    box-shadow: 0 16px 40px rgba(26, 58, 42, 0.08);
    box-sizing: border-box;
    min-height: 124px;
  }

  .doc-branding-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.08), transparent 35%, rgba(255, 255, 255, 0.14));
    pointer-events: none;
  }

  .doc-branding-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 92px;
    padding: 0;
    box-sizing: border-box;
  }

  .doc-branding-left,
  .doc-branding-center,
  .doc-branding-right {
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
  }

  .doc-branding-left {
    justify-content: flex-start;
    order: 1;
  }

  .doc-branding-center {
    justify-content: center;
    text-align: center;
    padding: 0 1rem;
    min-width: 240px;
    order: 2;
  }

  .doc-branding-right {
    justify-content: flex-end;
    order: 3;
  }

  .doc-branding-vendor-wrap {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 1.25rem;
    border: 1px solid rgba(212, 232, 223, 0.86);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72);
  }

  .doc-branding-eyebrow {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #668578;
  }

  .doc-branding-vendor {
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    font-weight: 700;
    color: #18382a;
    line-height: 1.25;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .doc-branding-left img {
    max-height: 76px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
  }

  .doc-branding-right img {
    max-height: 68px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .doc-branding-shell {
      padding: 1rem;
    }

    .doc-branding-header {
      flex-direction: column;
      align-items: stretch;
      min-height: auto;
    }

    .doc-branding-left,
    .doc-branding-center,
    .doc-branding-right {
      width: 100%;
      justify-content: center;
      text-align: center;
      padding: 0;
    }

    .doc-branding-left {
      order: 1;
    }

    .doc-branding-center {
      order: 2;
    }

    .doc-branding-right {
      order: 3;
    }

    .doc-branding-vendor-wrap {
      width: 100%;
      padding: 0.85rem 1rem;
    }
  }

  @media print {
    .doc-branding-shell {
      box-shadow: none !important;
      page-break-inside: avoid;
    }
  }
</style>

<div class="doc-branding-shell">
  <div class="doc-branding-header">
    <div class="doc-branding-left">
      <%= image_tag "asset-logo.png", alt: "ASA Logo" %>
    </div>
    <div class="doc-branding-center">
      <% if vendor_name.present? %>
        <div class="doc-branding-vendor-wrap">
          <div class="doc-branding-eyebrow">Vendor Workspace</div>
          <div class="doc-branding-vendor"><%= vendor_name %></div>
        </div>
      <% end %>
    </div>
    <div class="doc-branding-right">
      <%= image_tag "rci-logo.png", alt: "RCI Logo" %>
    </div>
  </div>
</div>
