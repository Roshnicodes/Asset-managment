<%
  creator_employee = @quotation_proposal.user&.employee_master
  creator_name = creator_employee&.name.presence || @quotation_proposal.user&.email.presence || "Authorized Signatory"
  proposal_remark = @quotation_proposal.remark.presence || "-"
  project_district = creator_employee&.district&.name.presence || @vendor_registration&.district&.name.presence || "-"
  project_village = creator_employee&.village.presence || "-"
  project_block = creator_employee&.block&.name.presence || @vendor_registration&.block&.name.presence || "-"
  project_panchayat = creator_employee&.gram_panchayat.presence || "-"
  brief_work_description = @quotation_proposal.subject
  sent_date = @quotation_proposal.sent_to_vendors_at&.to_date
  reference_year = sent_date&.year || Time.current.year
  submission_deadline = @quotation_proposal.proposal_end_date
  submission_deadline_text = submission_deadline.present? ? "#{submission_deadline.day.ordinalize} #{submission_deadline.strftime("%B %Y")}" : "-"
  vendor_remark_lines = @quotation_proposal_vendor.vendor_remark.to_s.lines.map(&:strip).reject(&:blank?)
  payment_terms_value = vendor_remark_lines.find { |line| line.downcase.start_with?("payment terms and condition:") }&.split(":", 2)&.last.to_s.strip
  completion_value = vendor_remark_lines.find { |line| line.downcase.start_with?("date of completion:") }&.split(":", 2)&.last.to_s.strip
  warranty_value = vendor_remark_lines.find { |line| line.downcase.start_with?("warranty period:") }&.split(":", 2)&.last.to_s.strip
  earnest_money_value = vendor_remark_lines.find { |line| line.downcase.start_with?("earnest money deposit:") }&.split(":", 2)&.last.to_s.strip
%>

<style>
  .rfq-print-toolbar {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .rfq-doc {
    width: 210mm;
    max-width: 100%;
    margin: 0 auto;
    background: #fff;
    color: #111;
    border: 1px solid #aeb8b2;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
    font-family: "Times New Roman", serif;
    font-size: 15px;
    line-height: 1.25;
  }

  .rfq-doc-body {
    padding: 1.1rem 1.7rem 1.25rem;
  }

  .rfq-doc-refrow {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .rfq-doc-refrow div {
    width: 48%;
    font-size: 16px;
  }

  .rfq-doc-to {
    margin: 0.2rem 0 1.1rem 0;
    line-height: 1.6;
    font-size: 16px;
  }

  .rfq-doc-subject {
    margin: 1rem 0 0.7rem;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
    white-space: nowrap;
  }

  .rfq-doc-last-date {
    margin: 0 0 1rem;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
    white-space: nowrap;
  }

  .rfq-doc p {
    margin: 0 0 0.9rem;
    text-align: justify;
  }

  .rfq-project-table,
  .rfq-estimate-table,
  .rfq-summary-table,
  .rfq-terms-table {
    width: 100%;
    border-collapse: collapse;
    margin: 0.7rem 0 1rem;
  }

  .rfq-project-table th,
  .rfq-project-table td,
  .rfq-estimate-table th,
  .rfq-estimate-table td,
  .rfq-summary-table th,
  .rfq-summary-table td,
  .rfq-terms-table th,
  .rfq-terms-table td {
    border: 1px solid #5e5e5e;
    padding: 0.35rem 0.45rem;
    vertical-align: top;
  }

  .rfq-project-table th,
  .rfq-estimate-table th,
  .rfq-summary-table th,
  .rfq-terms-table th {
    font-weight: 700;
    background: #fff;
  }

  .rfq-note-list {
    margin: 0.25rem 0 0;
    padding-left: 1.1rem;
  }

  .rfq-note-list li {
    margin-bottom: 0.35rem;
  }

  .rfq-doc-signoff {
    margin-top: 1.4rem;
  }

  @media print {
    body {
      background: #fff !important;
    }

    main {
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .print-hide,
    .alert {
      display: none !important;
    }

    .rfq-doc {
      width: 100%;
      border: 0;
      box-shadow: none;
      margin: 0;
    }

    @page {
      size: A4;
      margin: 7mm;
    }
  }
</style>

<div class="rfq-print-toolbar print-hide">
  <button type="button" class="app-form-submit" onclick="window.print()">Print / Save PDF</button>
  <%= link_to "Back to Form", quotation_vendor_qr_path(@quotation_proposal_vendor.qr_token, verified: 1), class: "app-secondary-btn" %>
</div>

<div class="rfq-doc">
  <%= render "document_branding" %>

  <div class="rfq-doc-body">
    <div class="rfq-doc-refrow">
      <div style="white-space: nowrap;"><strong>Ref.</strong> ASA/<%= @quotation_proposal.id %>/<%= reference_year %></div>
      <div style="text-align: right; white-space: nowrap;"><strong>Date:</strong> <%= sent_date&.strftime("%d-%m-%Y") || "-" %></div>
    </div>

    <div class="rfq-doc-to">
      <div style="white-space: nowrap;"><strong>To,</strong></div>
      <div style="margin-top: 0.4rem; white-space: nowrap;"><strong><%= @vendor_registration.display_name %></strong></div>
    </div>

    <div class="rfq-doc-subject">
      <strong>Sub:</strong> Request for Quotation (RFQ) for <%= @quotation_proposal.subject %>
    </div>

    <div class="rfq-doc-last-date">
      Last date of Submission of RFQ is <%= submission_deadline_text %>
    </div>

    <p>Dear Sir/Madam</p>

    <p>
      Action for Social Advancement (ASA) is a National level NGO working for Farm based livelihood development of small farmers since 1996. Please visit our website <strong>www.asaindia.org</strong> for more information. ASA intends to construct Warehouse at
    </p>

    <table class="rfq-project-table">
      <thead>
        <tr>
          <th style="width: 6%;">S.</th>
          <th style="width: 11%;">District</th>
          <th style="width: 12%;">Village</th>
          <th style="width: 12%;">Block</th>
          <th style="width: 14%;">Panchayat</th>
          <th>Brief work description</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>1</td>
          <td><%= project_district %></td>
          <td><%= project_village %></td>
          <td><%= project_block %></td>
          <td><%= project_panchayat %></td>
          <td><%= brief_work_description %></td>
        </tr>
      </tbody>
    </table>

    <p>It requests your organization to submit quotations showing rates for the items mentioned below in the prescribed format as given below.</p>

    <table class="rfq-estimate-table">
      <tr>
        <th style="width: 8%;">S.No.</th>
        <th>Item Name</th>
        <th style="width: 10%;">Unit</th>
        <th style="width: 10%;">Qty.</th>
        <th style="width: 12%;">Rate</th>
        <th style="width: 12%;">Amount</th>
        <th style="width: 10%;">GST %</th>
        <th style="width: 14%;">Grand Total</th>
        <th style="width: 14%;">Remark</th>
      </tr>
      <% @quotation_proposal_vendor.vendor_items.includes(quotation_proposal_item: :unit).each_with_index do |vendor_item, index| %>
        <tr>
          <td style="text-align: center;"><%= index + 1 %></td>
          <td><%= vendor_item.quotation_proposal_item.item_name %></td>
          <td style="text-align: center;"><%= vendor_item.quotation_proposal_item.unit.name %></td>
          <td style="text-align: center;"><%= number_with_precision(vendor_item.quotation_proposal_item.quantity, precision: 2, strip_insignificant_zeros: true) %></td>
          <td style="text-align: center;"><%= vendor_item.quoted_rate.present? ? number_with_precision(vendor_item.quoted_rate, precision: 2) : "-" %></td>
          <td style="text-align: center;"><%= vendor_item.line_total.present? ? number_with_precision(vendor_item.line_total, precision: 2) : "-" %></td>
          <td style="text-align: center;"><%= vendor_item.gst_percentage.present? ? number_with_precision(vendor_item.gst_percentage, precision: 2) : "-" %></td>
          <td style="text-align: center;"><%= vendor_item.grand_total.present? ? number_with_precision(vendor_item.grand_total, precision: 2) : "-" %></td>
          <td><%= vendor_item.remark.presence || "-" %></td>
        </tr>
      <% end %>
    </table>

    <table class="rfq-summary-table">
      <tr>
        <th style="width: 20%;">Amount Total</th>
        <td style="width: 30%;"><%= number_with_precision(@quotation_proposal_vendor.total_quoted_amount, precision: 2) %></td>
        <th style="width: 20%;">Grand Total</th>
        <td style="width: 30%;"><%= number_with_precision(@quotation_proposal_vendor.grand_total_amount, precision: 2) %></td>
      </tr>
      <tr>
        <th>Amount in Words</th>
        <td colspan="3"><%= amount_in_words(@quotation_proposal_vendor.grand_total_amount) %></td>
      </tr>
    </table>

    <p><strong>Terms & Conditions:</strong></p>

    <table class="rfq-terms-table">
      <tr>
        <th style="width: 34%;">Payment Terms and condition</th>
        <td><%= payment_terms_value.presence || "-" %></td>
      </tr>
      <tr>
        <th>Date of completion:</th>
        <td><%= completion_value.presence || "-" %></td>
      </tr>
      <tr>
        <th>Warranty period:</th>
        <td><%= warranty_value.presence || "-" %></td>
      </tr>
      <tr>
        <th>Earnest Money deposit:</th>
        <td><%= earnest_money_value.presence || "-" %></td>
      </tr>
    </table>

    <p><strong>Note:</strong></p>
    <ul class="rfq-note-list">
      <li>Submit quotation in a sealed envelope in the above format to the ASA office, Bhopal.</li>
      <li>By E-mail to: Krishnanandan krishnanandan@asabhopal.org</li>
      <li>Incomplete quotations and also without seal/sign/letter head will not be accepted.</li>
      <li>Submit Quotation inclusive of all GST charges wherever applicable.</li>
      <li>All Statutory taxes shall be borne by the organization.</li>
      <li>You will be required to submit before the start of the work all necessary statutory permission for doing the work and engaging labourers.</li>
      <li>We shall provide the encumbrances free/ undisputed work location, all other work in relation to the completion will be in your account.</li>
      <li>The Organization shall be liable for settling any dispute/liabilities arisen for undertaking the construction work.</li>
    </ul>

    <div class="rfq-doc-signoff">
      <p>Best regards</p>
      <p style="margin-top: 3rem;"><%= creator_name %></p>
    </div>
  </div>

  <%= render "document_footer" %>
</div>
