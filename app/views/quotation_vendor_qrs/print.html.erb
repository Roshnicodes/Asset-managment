<%
  vendor_contact_person = @vendor_registration.contact_person_name.presence || @vendor_registration.display_name
  sent_date = @quotation_proposal.sent_to_vendors_at&.to_date
  reference_year = sent_date&.year || Time.current.year
  default_cover_note = "Dear Sir / Madam,\n\nWe are pleased to submit our quotation for your kind consideration. Please find our best rates and commercial details below."
  vendor_cover_note_value = @quotation_proposal_vendor.vendor_cover_note.presence || default_cover_note
  vendor_cover_note_lines = vendor_cover_note_value.to_s.lines.map(&:strip)
  vendor_cover_note_lines.shift if vendor_cover_note_lines.first.to_s.downcase.start_with?("dear sir / madam")
  vendor_cover_note_body = vendor_cover_note_lines.reject(&:blank?).join("\n")
  vendor_remark_lines = @quotation_proposal_vendor.vendor_remark.to_s.lines.map(&:strip).reject(&:blank?)
  payment_terms_value = vendor_remark_lines.find { |line| line.downcase.start_with?("payment terms and condition:") }&.split(":", 2)&.last.to_s.strip
  completion_value = vendor_remark_lines.find { |line| line.downcase.start_with?("date of completion:") }&.split(":", 2)&.last.to_s.strip
  warranty_value = vendor_remark_lines.find { |line| line.downcase.start_with?("warranty period:") }&.split(":", 2)&.last.to_s.strip
  earnest_money_value = vendor_remark_lines.find { |line| line.downcase.start_with?("ernest money deposit:") || line.downcase.start_with?("earnest money deposit:") }&.split(":", 2)&.last.to_s.strip
%>

<style>
  .rfq-print-toolbar {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .rfq-doc {
    width: 210mm;
    max-width: 100%;
    margin: 0 auto;
    background: #fff;
    color: #111;
    border: 1px solid #aeb8b2;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
    font-family: "Times New Roman", serif;
    font-size: 15px;
    line-height: 1.25;
  }

  .rfq-doc-body {
    padding: 1.1rem 1.7rem 1.25rem;
  }

  .rfq-doc-firm-name {
    padding: 1.2rem 1.7rem 0.3rem;
    text-align: center;
    font-size: 1.35rem;
    font-weight: 700;
    color: #18382a;
    letter-spacing: 0.01em;
  }

  .rfq-doc-refrow {
    display: grid;
    grid-template-columns: 1.2fr 1fr 0.9fr;
    gap: 0.9rem;
    margin-bottom: 1rem;
    padding: 0.8rem 0.95rem;
    border: 1px solid #c8d3cc;
    border-radius: 12px;
    background: #f8fbf8;
  }

  .rfq-doc-refrow div {
    font-size: 16px;
  }

  .rfq-doc-subject {
    margin: 0 0 0.9rem;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid #d7e1db;
  }

  .rfq-doc p {
    margin: 0 0 0.9rem;
    text-align: justify;
  }

  .rfq-estimate-table,
  .rfq-summary-table,
  .rfq-terms-table {
    width: 100%;
    border-collapse: collapse;
    margin: 0.7rem 0 1rem;
  }

  .rfq-estimate-table th,
  .rfq-estimate-table td,
  .rfq-summary-table th,
  .rfq-summary-table td,
  .rfq-terms-table th,
  .rfq-terms-table td {
    border: 1px solid #5e5e5e;
    padding: 0.35rem 0.45rem;
    vertical-align: top;
  }

  .rfq-estimate-table th,
  .rfq-summary-table th,
  .rfq-terms-table th {
    font-weight: 700;
    background: #fff;
  }

  .rfq-doc-signoff {
    margin-top: 1.4rem;
  }

  .rfq-doc-signoff-name {
    margin-top: 0.75rem !important;
  }

  .rfq-doc-section-title {
    margin: 1rem 0 0.55rem;
    font-size: 16px;
    font-weight: 700;
  }

  .rfq-general-terms {
    margin: 0.4rem 0 1rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid #5e5e5e;
  }

  .rfq-general-terms ol {
    margin: 0;
    padding-left: 1.2rem;
  }

  .rfq-general-terms li + li {
    margin-top: 0.35rem;
  }

  .rfq-general-terms-email {
    margin-top: 0.45rem;
    font-weight: 700;
  }

  @media print {
    body {
      background: #fff !important;
    }

    main {
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .print-hide,
    .alert {
      display: none !important;
    }

    .rfq-doc {
      width: 100%;
      border: 0;
      box-shadow: none;
      margin: 0;
    }

    @page {
      size: A4;
      margin: 7mm;
    }
  }
</style>

<script>
  window.addEventListener("load", function () {
    window.setTimeout(function () {
      window.print();
    }, 300);
  });
</script>

<div class="rfq-print-toolbar print-hide">
  <button type="button" class="app-form-submit" onclick="window.print()">Print / Save PDF</button>
  <%= link_to "Back to Form", quotation_vendor_qr_path(@quotation_proposal_vendor.qr_token, verified: 1), class: "app-secondary-btn" %>
</div>

<div class="rfq-doc">
  <div class="rfq-doc-firm-name"><%= @vendor_registration.firm_name.presence || @vendor_registration.display_name %></div>
  <div class="rfq-doc-body">
    <div class="rfq-doc-refrow">
      <div style="white-space: nowrap;">
        <strong>Ref.</strong> ASA/<%= @quotation_proposal.id %>/<%= reference_year %>
      </div>
      <div style="white-space: nowrap;">
        <strong>Vendor Ref.</strong>
        <%= @quotation_proposal_vendor.vendor_reference_no.presence || "-" %>
      </div>
      <div style="text-align: right; white-space: nowrap;">
        <strong>Submission Date:</strong> <%= sent_date&.strftime("%d-%m-%Y") || "-" %>
      </div>
    </div>

    <div class="rfq-doc-subject">
      <strong>Sub:</strong> Vendor Quotation for <%= @quotation_proposal.subject %>
    </div>

    <p><strong>Dear Sir / Madam,</strong></p>
    <% if vendor_cover_note_body.present? %>
      <p style="white-space: pre-line;"><%= vendor_cover_note_body %></p>
    <% end %>

    <div class="rfq-doc-section-title">Quoted Items</div>
    <table class="rfq-estimate-table">
      <tr>
        <th style="width: 8%;">S.No.</th>
        <th>Item Name</th>
        <th style="width: 10%;">Unit</th>
        <th style="width: 10%;">Qty.</th>
        <th style="width: 12%;">Rate</th>
        <th style="width: 12%;">Amount</th>
        <th style="width: 10%;">GST %</th>
        <th style="width: 14%;">Grand Total</th>
        <th style="width: 14%;">Remark</th>
      </tr>
      <% @quotation_proposal_vendor.vendor_items.includes(quotation_proposal_item: :unit).each_with_index do |vendor_item, index| %>
        <tr>
          <td style="text-align: center;"><%= index + 1 %></td>
          <td><%= quotation_item_display_name(vendor_item.quotation_proposal_item.item_name) %></td>
          <td style="text-align: center;"><%= vendor_item.quotation_proposal_item.unit.name %></td>
          <td style="text-align: center;"><%= number_with_precision(vendor_item.quotation_proposal_item.quantity, precision: 2, strip_insignificant_zeros: true) %></td>
          <td style="text-align: center;"><%= vendor_item.quoted_rate.present? ? number_with_precision(vendor_item.quoted_rate, precision: 2) : "-" %></td>
          <td style="text-align: center;"><%= vendor_item.line_total.present? ? number_with_precision(vendor_item.line_total, precision: 2) : "-" %></td>
          <td style="text-align: center;"><%= vendor_item.gst_percentage.present? ? number_with_precision(vendor_item.gst_percentage, precision: 2) : "-" %></td>
          <td style="text-align: center;"><%= vendor_item.grand_total.present? ? number_with_precision(vendor_item.grand_total, precision: 2) : "-" %></td>
          <td><%= vendor_item.remark.presence || "-" %></td>
        </tr>
      <% end %>
    </table>

    <table class="rfq-summary-table">
      <tr>
        <th style="width: 20%;">Amount Total</th>
        <td style="width: 30%;"><%= number_with_precision(@quotation_proposal_vendor.total_quoted_amount, precision: 2) %></td>
        <th style="width: 20%;">Grand Total</th>
        <td style="width: 30%;"><%= number_with_precision(@quotation_proposal_vendor.grand_total_amount, precision: 2) %></td>
      </tr>
      <tr>
        <th>Amount in Words</th>
        <td colspan="3"><%= amount_in_words(@quotation_proposal_vendor.grand_total_amount) %></td>
      </tr>
    </table>

    <div class="rfq-doc-section-title">Terms & Conditions</div>

    <table class="rfq-terms-table">
      <tr>
        <th style="width: 34%;">Payment Terms and condition</th>
        <td><%= payment_terms_value.presence || "-" %></td>
      </tr>
      <tr>
        <th>Date of completion:</th>
        <td><%= completion_value.presence || "-" %></td>
      </tr>
      <tr>
        <th>Warranty period:</th>
        <td><%= warranty_value.presence || "-" %></td>
      </tr>
      <tr>
        <th>Ernest Money deposit:</th>
        <td><%= earnest_money_value.presence || "-" %></td>
      </tr>
    </table>

    <div class="rfq-doc-section-title">General Terms and Conditions</div>
    <div class="rfq-general-terms">
      <ol>
        <% asa_general_terms_and_conditions.each do |term| %>
          <li><%= term %></li>
        <% end %>
      </ol>
      <div class="rfq-general-terms-email"><%= asa_general_terms_contact_email %></div>
    </div>

    <div class="rfq-doc-signoff">
      <p>Best regards</p>
      <p class="rfq-doc-signoff-name"><%= vendor_contact_person %></p>
    </div>

    <% if @quotation_proposal_vendor.vendor_documents.attached? %>
      <div class="rfq-doc-section-title">Uploaded Documents</div>
      <table class="rfq-terms-table">
        <% @quotation_proposal_vendor.vendor_documents.each_with_index do |document, index| %>
          <tr>
            <th style="width: 34%;">Document <%= index + 1 %></th>
            <td><%= document.filename.to_s %></td>
          </tr>
        <% end %>
      </table>
    <% end %>
  </div>

  <%= render "document_footer", vendor_registration: @vendor_registration %>
</div>
