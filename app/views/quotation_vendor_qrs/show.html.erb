  .vendor-quote-summary > .app-form-field {
    min-width: 0;
    height: 100%;
    padding: 1rem 1.05rem;
    border: 1px solid #d8e7df;
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(249, 252, 250, 0.98));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  .vendor-quote-summary > .app-detail-item:hover {
    border-color: #c7dcd0;
    box-shadow: 0 8px 18px rgba(26, 58, 42, 0.05);
  }

  .vendor-quote-summary .app-form-field label {
    margin-bottom: 0.2rem;
  }

  .vendor-quote-section-head {
    margin-bottom: 1rem;
  }

  .vendor-quote-section-head h3 {
    margin-bottom: 0.3rem !important;
  }

  .vendor-quote-inset {
    padding: 1rem;
    border: 1px solid #d8e7df;
    border-radius: 20px;
