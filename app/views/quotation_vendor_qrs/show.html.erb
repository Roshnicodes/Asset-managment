  }

  .vendor-quote-table-shell {
    padding: 0.9rem;
    border: 1px solid #d8e7df;
    border-radius: 22px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(244, 250, 246, 0.95));
  }

  .vendor-quote-table-wrap {
    overflow-x: auto;
    overflow-y: visible;
    border: 1px solid #e0ece5;
    border-radius: 18px;
    background: #fff;
  }

  .vendor-quote-table {
    margin-bottom: 0;
    min-width: 1320px;
    border-collapse: separate;
    border-spacing: 0;
  }

  .vendor-quote-table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 0.95rem 0.85rem;
    border-bottom: 1px solid #dce9e2;
    background: #f4faf6;
    color: #557569;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .vendor-quote-table td,
  .vendor-quote-table th {
    vertical-align: middle;
  }

  .vendor-quote-table tbody td {
    padding: 0.95rem 0.85rem;
    border-bottom: 1px solid #edf3ef;
    background: #fff;
    color: #1d3d2e;
  }

  .vendor-quote-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .vendor-quote-table tbody tr:hover td {
    background: #fbfdfb;
  }

  .vendor-quote-table input,
  .vendor-quote-table textarea {
    min-width: 120px;
    width: 100%;
  }

  .vendor-quote-table input[type="number"],
  .vendor-quote-table input[type="text"] {
    min-height: 44px;
    border-radius: 12px;
  }

  .vendor-quote-table td[data-label="Proposal Remark"],
  .vendor-quote-table td[data-label="Your Remark"] {
    min-width: 180px;
  }

  .vendor-quote-total-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .vendor-quote-total-card {
    padding: 1.05rem 1.1rem;
    border: 1px solid #d8e7df;
    border-radius: 20px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(246, 251, 247, 0.98));
  }

  .vendor-quote-total-card--accent {
    background:
      radial-gradient(circle at top right, rgba(242, 177, 52, 0.16), transparent 35%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(241, 248, 244, 0.98));
  }

  .vendor-quote-submit-card {
    position: sticky;
    bottom: 1rem;
    z-index: 3;
    padding: 1rem 1.1rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.99), rgba(243, 249, 245, 0.98)),
      radial-gradient(circle at bottom right, rgba(11, 74, 79, 0.08), transparent 30%);
  }

  .vendor-quote-actionbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .vendor-quote-actioncopy {
    min-width: 0;
    max-width: 520px;
  }

  .vendor-quote-actiontitle {
    margin: 0;
    color: #18382a;
    font-size: 1.05rem;
    font-weight: 800;
  }

  .vendor-quote-actiontext {
    margin: 0.25rem 0 0;
    color: #648173;
    font-size: 0.92rem;
  }

  .vendor-quote-actionbuttons {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .vendor-quote-actionbuttons .app-form-submit,
  .vendor-quote-actionbuttons .app-secondary-btn {
    min-width: 168px;
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.5rem;
    box-sizing: border-box;
    text-align: center;
  }

  .vendor-quote-otp-shell {
    display: grid;
    gap: 1.25rem;
    width: 100%;
    max-width: 900px;
    margin: 2rem auto 0;
    padding: clamp(1rem, 2vw, 1.25rem);
    border: 1px solid #d7e5de;
    border-radius: 30px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(245, 250, 247, 0.96));
    box-shadow: 0 20px 46px rgba(20, 56, 43, 0.08);
  }

  .vendor-quote-otp-card {
    display: grid;
    grid-template-columns: minmax(250px, 0.86fr) minmax(300px, 1.14fr);
    overflow: hidden;
    border: 1px solid #d8e7df;
    border-radius: 26px;
    background: #fff;
    box-shadow: 0 12px 30px rgba(17, 59, 37, 0.06);
  }

  .vendor-quote-otp-side {
    position: relative;
    display: flex;
    min-height: 330px;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.35rem;
    padding: clamp(1.2rem, 3vw, 1.7rem);
    background:
      radial-gradient(circle at 86% 12%, rgba(216, 242, 226, 0.22), transparent 6rem),
      radial-gradient(circle at top left, rgba(255, 255, 255, 0.24), transparent 17rem),
      linear-gradient(145deg, #0f5f38, #174630);
    color: #fff;
  }

  .vendor-quote-otp-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #d8f2e2;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .vendor-quote-otp-eyebrow::before {
    content: "";
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: #d8f2e2;
    box-shadow: 0 0 0 0.35rem rgba(216, 242, 226, 0.13);
  }

  .vendor-quote-otp-title {
    margin: 0.55rem 0 0;
    font-size: clamp(1.7rem, 3.6vw, 2.35rem);
    font-weight: 850;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .vendor-quote-otp-copy {
    margin: 0.75rem 0 0;
    color: rgba(255, 255, 255, 0.84);
    line-height: 1.7;
  }

  .vendor-quote-otp-mark {
    display: grid;
    width: 108px;
    height: 108px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      0 18px 36px rgba(6, 38, 22, 0.2);
    color: #ffffff;
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .vendor-quote-otp-mini {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.45rem;
    padding: 0.58rem 0.82rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.82rem;
    font-weight: 750;
  }

  .vendor-quote-otp-mini::before {
    content: "";
    width: 0.46rem;
    height: 0.46rem;
    border-radius: 50%;
    background: #b9f3cc;
  }

  .vendor-quote-otp-form {
    display: grid;
    align-content: center;
    padding: clamp(1.2rem, 3vw, 1.7rem);
    background: linear-gradient(180deg, #ffffff, #fbfdfc);
  }

  .vendor-quote-otp-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin-bottom: 1rem;
  }

  .vendor-quote-otp-fact {
    min-width: 0;
    padding: 1rem;
    border: 1px solid #dbe8e1;
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 252, 249, 0.98));
    box-shadow: none;
  }

  .vendor-quote-otp-field label {
    margin-bottom: 0.45rem;
    color: #18382a;
    font-weight: 800;
  }

  .vendor-quote-otp-input {
    min-height: 54px;
    border-radius: 16px;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.25em;
    text-align: center;
  }

  .vendor-quote-otp-input::placeholder {
    color: #9aaea2;
    letter-spacing: 0.08em;
  }

  .vendor-quote-otp-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.85rem;
  }

  .vendor-quote-otp-submit,
  .vendor-quote-otp-resend {
    min-height: 50px;
    border-radius: 999px;
  }

  .vendor-quote-otp-resend-wrap {
    margin-top: 0.75rem;
  }

  .vendor-quote-otp-resend-wrap form {
    margin: 0;
  }

  @media (max-width: 900px) {
    .vendor-quote-workspace {
      padding: 0.9rem;
      border-radius: 22px;
    }

    .vendor-quote-hero {
      align-items: flex-start;
    }

    .vendor-quote-hero-aside {
      justify-items: start;
    }

    .vendor-quote-hero-note {
      text-align: left;
    }

    .vendor-quote-summary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .vendor-quote-summary .is-wide {
      grid-column: span 1;
    }

    .vendor-quote-total-grid,
    .vendor-quote-otp-card,
    .vendor-quote-otp-facts {
      grid-template-columns: 1fr;
    }

    .vendor-quote-submit-card {
      position: static;
    }

    .vendor-quote-actionbar,
    .vendor-quote-actionbuttons {
      position: static;
      justify-content: flex-start;
      flex-direction: column;
      align-items: stretch;
    }

    .vendor-quote-actionbuttons .app-form-submit,
    .vendor-quote-actionbuttons .app-secondary-btn {
      width: 100%;
      min-width: 0;
    }

    .vendor-quote-table {
      min-width: 0 !important;
    }

    .vendor-quote-table thead {
      display: none;
    }

    .vendor-quote-table tbody {
      display: grid;
      gap: 1rem;
      padding: 1rem;
      background: #f6fbf7;
    }

    .vendor-quote-table tbody tr {
      display: grid;
      border: 1px solid #dce8e1;
      border-radius: 18px;
      overflow: hidden;
      background: #fff;
      box-shadow: 0 10px 22px rgba(26, 58, 42, 0.05);
    }

    .vendor-quote-table tbody td {
      display: grid;
      grid-template-columns: minmax(90px, 108px) 1fr;
      gap: 0.85rem;
      padding: 0.85rem 1rem;
      text-align: left !important;
      border-bottom: 1px solid #edf3ef;
    }

    .vendor-quote-table tbody td::before {
      content: attr(data-label);
      color: #6a867b;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .vendor-quote-table tbody td:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 640px) {
    .vendor-quote-summary {
      grid-template-columns: 1fr;
    }

    .vendor-quote-otp-shell {
      padding: 0.9rem;
      border-radius: 24px;
    }

    .vendor-quote-card,
    .vendor-quote-table-shell,
    .vendor-quote-inset,
    .vendor-quote-submit-card {
      border-radius: 18px;
    }

    .vendor-quote-table tbody {
      padding: 0.65rem;
    }

    .vendor-quote-table tbody td {
      grid-template-columns: 1fr;
      gap: 0.35rem;
      padding: 0.8rem 0.9rem;
    }

    .vendor-quote-otp-side,
    .vendor-quote-otp-form {
      padding: 1rem;
    }

    .vendor-quote-otp-side {
      min-height: auto;
      align-items: flex-start;
      border-radius: 22px 22px 0 0;
    }

    .vendor-quote-otp-mark {
      width: 78px;
      height: 78px;
      border-radius: 24px;
      font-size: 1rem;
    }

    .vendor-quote-otp-title {
      font-size: clamp(1.45rem, 8vw, 1.9rem);
    }

    .vendor-quote-otp-mini,
    .vendor-quote-otp-actions,
    .vendor-quote-otp-resend-wrap form,
    .vendor-quote-otp-submit,
    .vendor-quote-otp-resend {
      width: 100%;
    }

    .vendor-quote-otp-mini,
    .vendor-quote-otp-submit,
    .vendor-quote-otp-resend {
      justify-content: center;
    }
  }
</style>

<% if otp_verified %>
  <script>
    window.history.pushState(null, "", window.location.href);
    window.addEventListener("popstate", function () {
      window.history.pushState(null, "", window.location.href);
    });
  </script>

  <%= form_with model: @quotation_proposal_vendor, url: quotation_vendor_qr_path(@quotation_proposal_vendor.qr_token, direct_access: ("1" if direct_access_mode), verified: ("1" if direct_access_mode)), method: :patch, local: true, data: { vendor_quote_calc: true } do |form| %>
    <div class="vendor-quote-workspace">
      <div class="vendor-quote-shell">
        <%= render "document_branding", vendor_name: (@vendor_registration.firm_name.presence || @vendor_registration.display_name), stakeholder_category: @stakeholder_category %>

        <div class="app-detail-card vendor-quote-card vendor-quote-card--hero">
          <div class="vendor-quote-hero">
            <div class="vendor-quote-hero-copy">
              <span class="vendor-quote-kicker">Vendor quotation response</span>
              <h1 class="vendor-quote-hero-title">Vendor Quotation Form</h1>
              <p class="vendor-quote-hero-subtitle"><%= @vendor_registration.display_name %> for <%= @quotation_proposal.subject %>. Neatly review the proposal details, fill your commercial terms, and submit a polished response.</p>
            </div>
            <div class="vendor-quote-hero-aside">
              <div class="vendor-quote-hero-status">
                <span class="vendor-quote-badge vendor-quote-badge--verified">OTP Verified</span>
                <% if @quotation_proposal_vendor.response_submitted? %>
                  <%= link_to "Print", print_quotation_vendor_qr_path(@quotation_proposal_vendor.qr_token, direct_access: ("1" if direct_access_mode)), class: "app-secondary-btn", target: "_blank", rel: "noopener" %>
                <% end %>
              </div>
              <p class="vendor-quote-hero-note">Fields below are grouped in clear boxed sections so the form stays easy to scan on desktop and phone.</p>
            </div>
          </div>
        </div>

        <div class="app-detail-card vendor-quote-card">
          <div class="vendor-quote-summary">
            <div class="app-detail-item">
              <div class="app-detail-label">Quotation ID</div>
              <div class="app-detail-value"><%= @quotation_proposal.id %></div>
            </div>
            <div class="app-detail-item">
              <div class="app-detail-label">Theme</div>
              <div class="app-detail-value"><%= @quotation_proposal.theme.name %></div>
            </div>
            <div class="app-detail-item">
              <div class="app-detail-label">Proposal End Date</div>
              <div class="app-detail-value"><%= @quotation_proposal.proposal_end_date.strftime("%d-%m-%Y") %></div>
            </div>
            <div class="app-detail-item">
              <div class="app-detail-label">Vendor</div>
              <div class="app-detail-value"><%= @vendor_registration.display_name %></div>
            </div>
            <div class="app-detail-item is-wide">
              <div class="app-detail-label">Proposal Remark</div>
              <div class="app-detail-value"><%= @quotation_proposal.remark.presence || "-" %></div>
            </div>
            <div class="app-form-field">
              <%= form.label :vendor_reference_no, "Vendor Reference No." %>
              <%= form.text_field :vendor_reference_no, placeholder: "Enter vendor reference" %>
            </div>
          </div>
        </div>

        <div class="app-detail-card vendor-quote-card">
          <div class="app-page-header app-subsection-header-tight vendor-quote-section-head">
            <div>
              <h3>Opening Message</h3>
              <p class="app-section-note mb-0">Subject ke baad aur quoted items ke upar ye content print view me dikhai dega.</p>
            </div>
          </div>
          <div class="vendor-quote-inset">
            <%= form.text_area :vendor_cover_note, rows: 6, class: "form-control vendor-quote-message-field", value: vendor_cover_note_value %>
          </div>
        </div>

        <div class="app-detail-card vendor-quote-card">
          <div class="app-page-header app-subsection-header-tight vendor-quote-section-head">
            <div>
              <h3>Quoted Items</h3>
              <p class="app-section-note mb-0">Har item ka rate, GST aur remark fill karke response submit karein. Mobile par each item apne compact response card me stack ho jayega.</p>
            </div>
          </div>

          <div class="vendor-quote-table-shell">
            <div class="app-table-wrap vendor-quote-table-wrap">
              <table class="table app-table vendor-quote-table">
                <thead>
                  <tr>
                    <th>S.No.</th>
                    <th>Item Name</th>
                    <th>Unit</th>
                    <th>Quantity</th>
                    <th>Proposal Remark</th>
                    <th>Your Rate</th>
                    <th>Amount</th>
                    <th>GST %</th>
                    <th>Grand Total</th>
                    <th>Your Remark</th>
                  </tr>
                </thead>
                <tbody>
                  <% @quotation_proposal_vendor.vendor_items.includes(quotation_proposal_item: :unit).each_with_index do |vendor_item, index| %>
                    <%= form.fields_for :vendor_items, vendor_item do |item_form| %>
                      <tr data-vendor-quote-row>
                        <td data-label="S.No."><%= index + 1 %><%= item_form.hidden_field :id %></td>
                        <td data-label="Item Name"><%= vendor_item.quotation_proposal_item.item_name %></td>
                        <td data-label="Unit"><%= vendor_item.quotation_proposal_item.unit.name %></td>
                        <td data-label="Quantity" data-quote-quantity><%= number_with_precision(vendor_item.quotation_proposal_item.quantity, precision: 2, strip_insignificant_zeros: true) %></td>
                        <td data-label="Proposal Remark"><%= vendor_item.quotation_proposal_item.remark.presence || "-" %></td>
                        <td data-label="Your Rate"><%= item_form.number_field :quoted_rate, step: :any, min: 0, required: true, data: { quote_rate: true } %></td>
                        <td data-label="Amount" data-amount-total><%= number_with_precision(vendor_item.line_total || 0, precision: 2) %></td>
                        <td data-label="GST %"><%= item_form.number_field :gst_percentage, step: :any, min: 0, placeholder: "GST %", data: { quote_gst: true } %></td>
                        <td data-label="Grand Total" data-grand-total><%= number_with_precision(vendor_item.grand_total || 0, precision: 2) %></td>
                        <td data-label="Your Remark"><%= item_form.text_field :remark %></td>
                      </tr>
                    <% end %>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="app-detail-card vendor-quote-card">
          <div class="vendor-quote-total-grid">
            <div class="vendor-quote-total-card">
              <div class="app-detail-label">Amount Total</div>
              <div class="app-detail-value" data-summary-amount-total><%= number_with_precision(@quotation_proposal_vendor.total_quoted_amount, precision: 2) %></div>
            </div>
            <div class="vendor-quote-total-card vendor-quote-total-card--accent">
              <div class="app-detail-label">Grand Total</div>
              <div class="app-detail-value" data-summary-grand-total><%= number_with_precision(@quotation_proposal_vendor.grand_total_amount, precision: 2) %></div>
            </div>
            <div class="vendor-quote-total-card">
              <div class="app-detail-label">Amount in Words</div>
              <div class="app-detail-value" data-summary-grand-words><%= amount_in_words(@quotation_proposal_vendor.grand_total_amount) %></div>
            </div>
          </div>
        </div>

        <div class="app-detail-card vendor-quote-card">
          <div class="app-page-header app-subsection-header-tight vendor-quote-section-head">
            <div>
              <h3>Terms & Conditions</h3>
              <p class="app-section-note mb-0">Ye internal vendor terms print form me bhi dikhengi.</p>
            </div>
          </div>
          <input type="hidden" name="quotation_proposal_vendor[vendor_remark]" value="<%= @quotation_proposal_vendor.vendor_remark %>" data-vendor-remark-target>
          <div class="vendor-quote-inset">
            <div class="app-form-grid two-col">
              <div class="app-form-field">
                <label>Payment Terms and condition</label>
                <input type="text" value="<%= payment_terms_value %>" data-vendor-remark-part="payment_terms">
              </div>
              <div class="app-form-field">
                <label>Date of completion</label>
                <input type="text" value="<%= completion_value %>" data-vendor-remark-part="completion">
              </div>
              <div class="app-form-field">
                <label>Warranty period</label>
                <input type="text" value="<%= warranty_value %>" data-vendor-remark-part="warranty">
              </div>
              <div class="app-form-field">
                <label>Earnest Money deposit</label>
                <input type="text" value="<%= earnest_money_value %>" data-vendor-remark-part="earnest_money">
              </div>
            </div>
          </div>
        </div>

        <div class="app-detail-card vendor-quote-card">
          <div class="app-page-header app-subsection-header-tight vendor-quote-section-head">
            <div>
              <h3>Upload Any Documents (Optional)</h3>
              <p class="app-section-note mb-0">Supporting PDF ya image files yahan attach kar sakte hain.</p>
            </div>
          </div>
          <div class="vendor-quote-inset">
            <%= form.file_field :vendor_documents, multiple: true, accept: ".pdf,image/*", class: "form-control" %>

            <% if @quotation_proposal_vendor.vendor_documents.attached? %>
              <div class="mt-3 d-flex flex-wrap gap-2">
                <% @quotation_proposal_vendor.vendor_documents.each do |document| %>
                  <%= link_to document.filename.to_s, rails_blob_path(document, disposition: "attachment"), class: "app-secondary-btn" %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="app-detail-card vendor-quote-card vendor-quote-submit-card">
          <div class="vendor-quote-actionbar">
            <div class="vendor-quote-actioncopy">
              <h3 class="vendor-quote-actiontitle">Ready to submit your response?</h3>
              <p class="vendor-quote-actiontext">Rates, GST, vendor terms, and attachments review karne ke baad boxed action panel se final response save karein.</p>
            </div>
            <div class="vendor-quote-actionbuttons">
              <%= form.submit(@quotation_proposal_vendor.response_submitted? ? "Update Response" : "Submit Response", class: "app-form-submit") %>
              <% if @quotation_proposal_vendor.response_submitted? %>
                <%= link_to "Print", print_quotation_vendor_qr_path(@quotation_proposal_vendor.qr_token, direct_access: ("1" if direct_access_mode)), class: "app-secondary-btn", target: "_blank", rel: "noopener" %>
              <% end %>
            </div>
          </div>
        </div>

        <%= render "document_footer", vendor_registration: @vendor_registration %>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="vendor-quote-otp-shell">
    <%= render "document_branding", vendor_name: (@vendor_registration.firm_name.presence || @vendor_registration.display_name), stakeholder_category: @stakeholder_category %>

    <section class="vendor-quote-otp-card">
      <div class="vendor-quote-otp-side">
        <div>
          <div class="vendor-quote-otp-eyebrow">Secure Verification</div>
          <h1 class="vendor-quote-otp-title">Vendor Quotation OTP Verification</h1>
          <p class="vendor-quote-otp-copy">Enter the OTP sent to your registered mobile number to open the quotation workspace and continue safely.</p>
        </div>
        <div class="vendor-quote-otp-mark">OTP</div>
        <div class="vendor-quote-otp-mini">Protected vendor access</div>
      </div>

      <div class="vendor-quote-otp-form">
        <div class="vendor-quote-otp-facts">
          <div class="app-detail-item vendor-quote-otp-fact">
            <div class="app-detail-label">Mobile Number</div>
            <div class="app-detail-value"><%= @quotation_vendor_dispatch.mobile_no.presence || "-" %></div>
          </div>
          <div class="app-detail-item vendor-quote-otp-fact">
            <div class="app-detail-label">Last OTP Sent At</div>
            <div class="app-detail-value"><%= @quotation_vendor_dispatch.latest_active_otp&.sent_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
          </div>
        </div>

        <%= form_with url: verify_quotation_vendor_qr_otp_path(@quotation_proposal_vendor.qr_token), method: :post, local: true do |form| %>
          <div class="app-form-field vendor-quote-otp-field">
            <%= form.label :otp_code, "Enter OTP" %>
            <%= form.text_field :otp_code, maxlength: 6, required: true, class: "form-control vendor-quote-otp-input", inputmode: "numeric", autocomplete: "one-time-code", placeholder: "------" %>
          </div>
          <div class="vendor-quote-otp-actions">
            <%= form.submit "Verify OTP", class: "app-form-submit vendor-quote-otp-submit" %>
          </div>
        <% end %>

        <div class="vendor-quote-otp-resend-wrap">
          <%= button_to "Send New OTP", send_quotation_vendor_qr_otp_path(@quotation_proposal_vendor.qr_token), method: :post, class: "app-secondary-btn vendor-quote-otp-resend" %>
        </div>
      </div>
    </section>
  </div>
<% end %>

<script>
  (function() {
    var hiddenField = document.querySelector("[data-vendor-remark-target]");
    if (!hiddenField) return;

    var inputs = {
      paymentTerms: document.querySelector("[data-vendor-remark-part='payment_terms']"),
      completion: document.querySelector("[data-vendor-remark-part='completion']"),
      warranty: document.querySelector("[data-vendor-remark-part='warranty']"),
      earnestMoney: document.querySelector("[data-vendor-remark-part='earnest_money']")
    };

    function syncVendorRemark() {
      hiddenField.value = [
        "Payment Terms and condition: " + ((inputs.paymentTerms && inputs.paymentTerms.value) || ""),
        "Date of completion: " + ((inputs.completion && inputs.completion.value) || ""),
        "Warranty period: " + ((inputs.warranty && inputs.warranty.value) || ""),
        "Earnest Money deposit: " + ((inputs.earnestMoney && inputs.earnestMoney.value) || "")
      ].join("\n");
    }

    Object.values(inputs).forEach(function(input) {
      if (!input) return;
      input.addEventListener("input", syncVendorRemark);
    });

    syncVendorRemark();
  })();

  (function() {
    var form = document.querySelector("[data-vendor-quote-calc='true']");
    if (!form) return;

    function formatNumber(value) {
      var number = Number(value || 0);
      if (Number.isNaN(number)) number = 0;
      return number.toFixed(2);
    }

    function recalcRow(row) {
      var qtyCell = row.querySelector("[data-quote-quantity]");
      var rateInput = row.querySelector("[data-quote-rate], input[data-quote-rate='true'], input[name*='[quoted_rate]']");
      var gstInput = row.querySelector("[data-quote-gst], input[data-quote-gst='true'], input[name*='[gst_percentage]']");
      var amountCell = row.querySelector("[data-amount-total]");
      var grandCell = row.querySelector("[data-grand-total]");

      var quantity = parseFloat(qtyCell && qtyCell.textContent) || 0;
      var rate = parseFloat(rateInput && rateInput.value) || 0;
      var gst = parseFloat(gstInput && gstInput.value) || 0;
      var amount = quantity * rate;
      var grand = amount + (amount * gst / 100.0);

      if (amountCell) amountCell.textContent = formatNumber(amount);
      if (grandCell) grandCell.textContent = formatNumber(grand);

      return { amount: amount, grand: grand };
    }

    function recalcAll() {
      var totals = { amount: 0, grand: 0 };

      form.querySelectorAll("[data-vendor-quote-row]").forEach(function(row) {
        var rowTotals = recalcRow(row);
        totals.amount += rowTotals.amount;
        totals.grand += rowTotals.grand;
      });

      var amountTotal = form.querySelector("[data-summary-amount-total]");
      var grandTotal = form.querySelector("[data-summary-grand-total]");
      if (amountTotal) amountTotal.textContent = formatNumber(totals.amount);
      if (grandTotal) grandTotal.textContent = formatNumber(totals.grand);
    }

    form.addEventListener("input", function(event) {
      if (event.target.matches("input[data-quote-rate='true'], input[data-quote-gst='true']")) {
        recalcAll();
      }
    });

    recalcAll();
  })();
</script>
