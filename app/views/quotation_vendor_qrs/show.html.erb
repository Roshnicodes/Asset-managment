<%
  direct_access_mode = params[:direct_access] == "1" && @quotation_proposal.below_10k?
  otp_verified = direct_access_mode ? (@otp_verified_for_render || false) : ((@otp_verified_for_render || false) && @quotation_vendor_dispatch.access_open?)
  vendor_remark_lines = @quotation_proposal_vendor.vendor_remark.to_s.lines.map(&:strip).reject(&:blank?)
  default_cover_note = "Dear Sir / Madam,\n\nWe are pleased to submit our quotation for your kind consideration. Please find our best rates and commercial details below."
  vendor_cover_note_value = @quotation_proposal_vendor.vendor_cover_note.presence || default_cover_note
  payment_terms_value = vendor_remark_lines.find { |line| line.downcase.start_with?("payment terms and condition:") }&.split(":", 2)&.last.to_s.strip
  completion_value = vendor_remark_lines.find { |line| line.downcase.start_with?("date of completion:") }&.split(":", 2)&.last.to_s.strip
  warranty_value = vendor_remark_lines.find { |line| line.downcase.start_with?("warranty period:") }&.split(":", 2)&.last.to_s.strip
  earnest_money_value = vendor_remark_lines.find { |line| line.downcase.start_with?("earnest money deposit:") }&.split(":", 2)&.last.to_s.strip
  asa_reference_no = "ASA/#{@quotation_proposal.id}/#{(@quotation_proposal.sent_to_vendors_at&.year || Time.current.year)}"
%>

<% if otp_verified %>
  <style>
    .vendor-quote-shell {
      display: grid;
      gap: 1.4rem;
    }

    .vendor-quote-card {
      padding: 1.4rem;
    }

    .vendor-quote-card-head {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 1rem;
      margin-bottom: 1rem;
      padding-bottom: 0.85rem;
      border-bottom: 1px solid #d9e6de;
      flex-wrap: wrap;
    }

    .vendor-quote-card-head h3 {
      margin: 0;
      color: #163526;
      font-size: 1.15rem;
    }

    .vendor-quote-card-note {
      margin: 0.2rem 0 0;
      color: #6b8e7f;
      font-size: 0.92rem;
    }

    .vendor-quote-ref-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      align-items: end;
    }

    .vendor-quote-ref-value {
      font-size: 1.05rem;
      font-weight: 700;
      color: #1a3a2a;
      letter-spacing: 0.01em;
    }

    .vendor-quote-ref-input label {
      margin-bottom: 0.45rem;
    }

    .vendor-quote-hero {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .vendor-quote-hero-title {
      margin: 0;
      font-size: 2rem;
      color: #18382a;
    }

    .vendor-quote-hero-subtitle {
      margin: 0.45rem 0 0;
      color: #6b8e7f;
      font-size: 1rem;
    }

    .vendor-quote-badge-row {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      flex-wrap: wrap;
    }

    .vendor-quote-summary {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }

    .vendor-quote-summary .app-detail-item {
      min-height: 100%;
    }

    .vendor-quote-summary .is-wide {
      grid-column: span 2;
    }

    .vendor-quote-section-head {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 1rem;
      margin-bottom: 0.9rem;
      flex-wrap: wrap;
    }

    .vendor-quote-section-head h3 {
      margin: 0;
    }

    .vendor-quote-table th {
      white-space: nowrap;
    }

    .vendor-quote-table td {
      vertical-align: middle;
    }

    .vendor-quote-table input,
    .vendor-quote-table textarea,
    .vendor-quote-table select {
      min-width: 120px;
    }

    .vendor-quote-terms th {
      width: 22%;
      min-width: 220px;
      white-space: nowrap;
    }

    .vendor-quote-actionbar {
      display: flex;
      justify-content: flex-end;
      gap: 0.8rem;
      padding: 1rem 1.2rem;
      border: 1px solid #d4e8df;
      border-radius: 16px;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(244, 250, 246, 0.98));
      box-shadow: 0 10px 24px rgba(26, 58, 42, 0.06);
      position: sticky;
      bottom: 1rem;
      z-index: 2;
    }

    .vendor-quote-actionbar .app-form-submit,
    .vendor-quote-actionbar .app-secondary-btn {
      min-width: 168px;
      min-height: 52px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.85rem 1.5rem;
      box-sizing: border-box;
      text-align: center;
    }

    @media (max-width: 900px) {
      .vendor-quote-ref-grid,
      .vendor-quote-summary,
      .vendor-quote-summary-compact {
        grid-template-columns: 1fr !important;
      }

      .vendor-quote-card {
        padding: 1rem;
      }

      .vendor-quote-summary .is-wide {
        grid-column: span 1;
      }

      .vendor-quote-terms th {
        width: auto;
        min-width: 0;
      }

      .vendor-quote-actionbar {
        position: static;
        padding: 0;
        border: 0;
        box-shadow: none;
        background: transparent;
        justify-content: flex-start;
      }

      .vendor-quote-actionbar .app-form-submit,
      .vendor-quote-actionbar .app-secondary-btn {
        min-width: 0;
        width: 100%;
      }
    }
  </style>

  <script>
    window.history.pushState(null, "", window.location.href);
    window.addEventListener("popstate", function () {
      window.history.pushState(null, "", window.location.href);
    });
  </script>

  <%= form_with model: @quotation_proposal_vendor, url: quotation_vendor_qr_path(@quotation_proposal_vendor.qr_token, direct_access: ("1" if direct_access_mode), verified: ("1" if direct_access_mode)), method: :patch, local: true, data: { vendor_quote_calc: true } do |form| %>
    <div class="vendor-quote-shell">
      <%= render "document_branding", firm_name: (@vendor_registration.firm_name.presence || @vendor_registration.display_name) %>

      <div class="app-detail-card vendor-quote-card">
        <div class="vendor-quote-hero">
          <div>
            <div class="app-detail-label" style="margin-bottom: 0.25rem;">Vendor quotation response</div>
            <h1 class="vendor-quote-hero-title">Vendor Quotation Form</h1>
            <p class="vendor-quote-hero-subtitle"><%= @vendor_registration.display_name %> for <%= @quotation_proposal.subject %></p>
          </div>

      <span class="badge border bg-success bg-opacity-10 text-success px-3 py-2" style="font-size: 0.9rem;">
        OTP Verified
      </span>
    </div>
  </div>

  <div class="app-page-header" style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1.5rem;">
    <div>
      <h2 style="margin: 0; font-size: 1.8rem; color: #1a3a2a;">Vendor Quotation Form</h2>
      <p style="margin: 0.5rem 0 0 0; color: #6b8e7f; font-size: 0.95rem;">
        <%= @vendor_registration.display_name %> for <%= @quotation_proposal.subject %>
      </p>
    </div>
    <% if @quotation_proposal_vendor.response_submitted? %>
      <div class="d-flex gap-2 flex-wrap">
        <%= link_to "Print", print_quotation_vendor_qr_path(@quotation_proposal_vendor.qr_token, direct_access: ("1" if direct_access_mode)), class: "app-secondary-btn", target: "_blank", rel: "noopener" %>
      </div>
    <% end %>
  </div>

  <div class="app-detail-card">
    <div class="app-detail-grid">
      <div class="app-detail-item">
        <div class="app-detail-label">Quotation ID</div>
        <div class="app-detail-value"><%= @quotation_proposal.id %></div>
      </div>

      <div class="app-detail-item">
        <div class="app-detail-label">Vendor</div>
        <div class="app-detail-value"><%= @vendor_registration.display_name %></div>
      </div>

      <div class="app-detail-item">
        <div class="app-detail-label">Theme</div>
        <div class="app-detail-value"><%= @quotation_proposal.theme.name %></div>
      </div>

      <div class="app-detail-item">
        <div class="app-detail-label">Proposal End Date</div>
        <div class="app-detail-value"><%= @quotation_proposal.proposal_end_date.strftime("%d-%m-%Y") %></div>
      </div>

      <div class="app-detail-item" style="grid-column: 1 / -1;">
        <div class="app-detail-label">Remark</div>
        <div class="app-detail-value"><%= @quotation_proposal.remark.presence || "-" %></div>
      </div>
    </div>
  </div>

  <div class="app-page-header" style="margin-top: 1.5rem;">
    <div>
      <h3 style="margin-bottom: 0.25rem;">Quoted Items</h3>
      <p class="app-section-note mb-0">Fill your quotation item-wise and submit the response.</p>
    </div>
  </div>

  <%= form_with model: @quotation_proposal_vendor, url: quotation_vendor_qr_path(@quotation_proposal_vendor.qr_token, direct_access: ("1" if direct_access_mode), verified: ("1" if direct_access_mode)), method: :patch, local: true, data: { vendor_quote_calc: true } do |form| %>
    <div class="app-table-wrap" style="overflow-x: auto; overflow-y: visible;">
      <table class="table app-table" style="min-width: 1400px;">
        <thead>
          <tr>
            <th>Item Name</th>
            <th>Unit</th>
            <th>Quantity</th>
            <th>Proposal Remark</th>
            <th>Your Rate</th>
            <th>Amount</th>
            <th>GST %</th>
            <th>Grand Total</th>
            <th>Your Remark</th>
          </tr>
        </thead>
        <tbody>
          <% @quotation_proposal_vendor.vendor_items.includes(quotation_proposal_item: :unit).each do |vendor_item| %>
            <%= form.fields_for :vendor_items, vendor_item do |item_form| %>
              <tr data-vendor-quote-row>
                <td>
                  <%= vendor_item.quotation_proposal_item.item_name %>
                  <%= item_form.hidden_field :id %>
                </td>
                <td><%= vendor_item.quotation_proposal_item.unit.name %></td>
                <td data-quote-quantity><%= vendor_item.quotation_proposal_item.quantity %></td>
                <td><%= vendor_item.quotation_proposal_item.remark.presence || "-" %></td>
                <td><%= item_form.number_field :quoted_rate, step: :any, min: 0, required: true, data: { quote_rate: true } %></td>
                <td data-amount-total><%= number_with_precision(vendor_item.line_total || 0, precision: 2) %></td>
                <td><%= item_form.number_field :gst_percentage, step: :any, min: 0, placeholder: "GST %", data: { quote_gst: true } %></td>
                <td data-grand-total><%= number_with_precision(vendor_item.grand_total, precision: 2) %></td>
                <td><%= item_form.text_field :remark %></td>
              </tr>
            <% end %>
          </div>
        </div>
      </div>

      <div class="app-detail-card vendor-quote-card">
        <div class="vendor-quote-card-head">
        </div>

    <div class="app-form-actions">
      <%= form.submit(@quotation_proposal_vendor.response_submitted? ? "Update Response" : "Submit Response", class: "app-form-submit") %>
      <% if @quotation_proposal_vendor.response_submitted? %>
        <%= link_to "Print", print_quotation_vendor_qr_path(@quotation_proposal_vendor.qr_token, direct_access: ("1" if direct_access_mode)), class: "app-secondary-btn", target: "_blank", rel: "noopener" %>
      <% end %>
    </div>
  <% end %>

  <%= render "document_footer" %>
<% else %>
  <div class="app-form-card" style="max-width: 720px; margin: 3rem auto;">
    <div class="app-page-header" style="margin-bottom: 1rem;">
      <div>
        <h2 style="margin-bottom: 0.25rem;">Vendor OTP Verification</h2>
        <p class="app-section-note mb-0">Enter the OTP sent to your registered mobile number to open the quotation form.</p>
      </div>
    </div>

    <div class="app-detail-grid">
      <div class="app-detail-item">
        <div class="app-detail-label">Mobile Number</div>
        <div class="app-detail-value"><%= @quotation_vendor_dispatch.mobile_no.presence || "-" %></div>
      </div>

      <div class="app-detail-item">
        <div class="app-detail-label">Last OTP Sent At</div>
        <div class="app-detail-value"><%= @quotation_vendor_dispatch.latest_active_otp&.sent_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
      </div>
    </div>

    <div class="row g-3 mt-1">
      <div class="col-lg-7">
        <%= form_with url: verify_quotation_vendor_qr_otp_path(@quotation_proposal_vendor.qr_token), method: :post, local: true do |form| %>
          <div class="app-form-field">
            <%= form.label :otp_code, "Enter OTP" %>
            <%= form.text_field :otp_code, maxlength: 6, required: true %>
          </div>
          <div class="app-form-actions" style="justify-content: flex-start;">
            <%= form.submit "Verify OTP", class: "app-form-submit" %>
          </div>
        <% end %>
      </div>

      <div class="col-lg-5">
        <div class="app-detail-item h-100">
          <div class="app-detail-label">Need a New OTP?</div>
          <p class="app-section-note" style="margin-bottom: 1rem;">If the OTP has expired, send a fresh OTP again.</p>
          <%= button_to "Send New OTP", send_quotation_vendor_qr_otp_path(@quotation_proposal_vendor.qr_token), method: :post, class: "app-secondary-btn" %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<script>
  (function() {
    var hiddenField = document.querySelector('[data-vendor-remark-target]');
    if (!hiddenField) return;

    var inputs = {
      paymentTerms: document.querySelector('[data-vendor-remark-part="payment_terms"]'),
      completion: document.querySelector('[data-vendor-remark-part="completion"]'),
      warranty: document.querySelector('[data-vendor-remark-part="warranty"]'),
      earnestMoney: document.querySelector('[data-vendor-remark-part="earnest_money"]')
    };

    function syncVendorRemark() {
      hiddenField.value = [
        "Payment Terms and condition: " + (inputs.paymentTerms && inputs.paymentTerms.value || ""),
        "Date of completion: " + (inputs.completion && inputs.completion.value || ""),
        "Warranty period: " + (inputs.warranty && inputs.warranty.value || ""),
        "Earnest Money deposit: " + (inputs.earnestMoney && inputs.earnestMoney.value || "")
      ].join("\n");
    }

    Object.values(inputs).forEach(function(input) {
      if (!input) return;
      input.addEventListener("input", syncVendorRemark);
    });

    syncVendorRemark();
  })();
</script>
