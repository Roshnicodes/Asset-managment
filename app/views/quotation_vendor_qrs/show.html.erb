<%
  direct_access_mode = params[:direct_access] == "1" && @quotation_proposal.below_10k?
  otp_verified = direct_access_mode ? (@otp_verified_for_render || false) : ((@otp_verified_for_render || false) && @quotation_vendor_dispatch.access_open?)
  vendor_remark_lines = @quotation_proposal_vendor.vendor_remark.to_s.lines.map(&:strip).reject(&:blank?)
  default_cover_note = "Dear Sir / Madam,\n\nWe are pleased to submit our quotation for your kind consideration. Please find our best rates and commercial details below."
  vendor_cover_note_value = @quotation_proposal_vendor.vendor_cover_note.presence || default_cover_note
  payment_terms_value = vendor_remark_lines.find { |line| line.downcase.start_with?("payment terms and condition:") }&.split(":", 2)&.last.to_s.strip
  completion_value = vendor_remark_lines.find { |line| line.downcase.start_with?("date of completion:") }&.split(":", 2)&.last.to_s.strip
  warranty_value = vendor_remark_lines.find { |line| line.downcase.start_with?("warranty period:") }&.split(":", 2)&.last.to_s.strip
  earnest_money_value = vendor_remark_lines.find { |line| line.downcase.start_with?("earnest money deposit:") }&.split(":", 2)&.last.to_s.strip
%>

<style>
  .vendor-quote-workspace {
    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: clamp(1rem, 2vw, 1.35rem);
    border: 1px solid #d7e5de;
    border-radius: 32px;
    background:
      radial-gradient(circle at top right, rgba(242, 177, 52, 0.08), transparent 22%),
      radial-gradient(circle at bottom left, rgba(11, 74, 79, 0.06), transparent 24%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(245, 250, 247, 0.96));
    box-shadow:
      0 24px 58px rgba(20, 56, 43, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.72);
    overflow: hidden;
  }

  .vendor-quote-workspace,
  .vendor-quote-workspace * {
    box-sizing: border-box;
  }

  .vendor-quote-shell {
    display: grid;
    gap: 1.15rem;
    width: 100%;
    max-width: none;
    margin: 0;
    min-width: 0;
  }

  .vendor-quote-shell > * {
    min-width: 0;
  }

  .vendor-quote-card {
    width: 100%;
    padding: clamp(1rem, 2vw, 1.45rem);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 16px 36px rgba(26, 58, 42, 0.07);
    overflow: hidden;
  }

  .vendor-quote-card--hero {
    padding: clamp(1.2rem, 2.2vw, 1.8rem);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(241, 248, 244, 0.98)),
      radial-gradient(circle at top right, rgba(15, 110, 120, 0.08), transparent 28%);
  }

  .vendor-quote-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.38rem 0.8rem;
    border: 1px solid rgba(24, 56, 42, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.84);
    color: #2c6a4a;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .vendor-quote-kicker::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #1f8a70;
    box-shadow: 0 0 0 4px rgba(31, 138, 112, 0.12);
  }

  .vendor-quote-hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .vendor-quote-hero-copy {
    min-width: 0;
    max-width: 760px;
  }

  .vendor-quote-hero-title {
    margin: 0.9rem 0 0;
    font-size: clamp(1.8rem, 4vw, 2.35rem);
    color: #18382a;
    line-height: 1.05;
  }

  .vendor-quote-hero-subtitle {
    margin: 0.65rem 0 0;
    color: #5f7d72;
    font-size: 1rem;
    max-width: 62ch;
  }

  .vendor-quote-hero-aside {
    display: grid;
    justify-items: end;
    gap: 0.85rem;
    min-width: 0;
  }

  .vendor-quote-hero-status {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .vendor-quote-hero-note {
    max-width: 320px;
    margin: 0;
    color: #668578;
    font-size: 0.92rem;
    text-align: right;
  }

  .vendor-quote-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0.65rem 1rem;
