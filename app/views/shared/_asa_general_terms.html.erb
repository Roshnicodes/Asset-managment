<%
  checkbox_name = local_assigns.fetch(:checkbox_name, :asa_terms_accepted)
  checkbox_id = local_assigns.fetch(:checkbox_id, checkbox_name.to_s)
  checkbox_label = local_assigns.fetch(:checkbox_label, "I have read and agree to the General Terms and Conditions.")
  checked = local_assigns[:checked] == true
  form_id = local_assigns[:form_id].to_s.presence
  checkbox_options = {
    id: checkbox_id,
    class: "asa-vendor-terms__checkbox",
    required: true,
    data: { vendor_terms_checkbox: true }
  }
  checkbox_options[:form] = form_id if form_id.present?
%>

<div class="asa-vendor-terms">
  <div class="asa-vendor-terms__title">General Terms and Conditions:</div>
  <ol class="asa-vendor-terms__list">
    <% asa_general_terms_and_conditions.each do |term| %>
      <li><%= term %></li>
    <% end %>
  </ol>
  <div class="asa-vendor-terms__email"><%= asa_general_terms_contact_email %></div>

  <div class="asa-vendor-terms__acceptance">
    <label class="asa-vendor-terms__acceptance-control" for="<%= checkbox_id %>">
      <%= check_box_tag checkbox_name, "1", checked, checkbox_options %>
      <span><%= checkbox_label %></span>
    </label>
  </div>
</div>
