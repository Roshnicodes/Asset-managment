<style>
  .user-manual-page {
    --um-brand-deep: #0b4a4f;
    --um-brand-mid: #0b6f66;
    --um-brand-light: #e6f4f1;
    --um-brand-subtle: #f0f7f5;
    --um-accent-amber: #d97706;
    --um-accent-amber-soft: #fef3c7;
    --um-ink-main: #111827;
    --um-ink-muted: #4b5563;
    --um-ink-subtle: #6b7280;
    --um-border: #e2e8f0;
    --um-border-brand: #cce7df;
    --um-surface: #ffffff;
    --um-bg: #f8faf9;
    --um-shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05), 0 1px 2px rgba(0, 0, 0, 0.02);
    --um-shadow-md: 0 4px 16px -2px rgba(11, 74, 79, 0.07), 0 2px 6px -1px rgba(0, 0, 0, 0.03);
    --um-shadow-lg: 0 12px 30px -4px rgba(11, 74, 79, 0.1), 0 4px 12px -2px rgba(0, 0, 0, 0.04);
    --um-radius-sm: 8px;
    --um-radius-md: 12px;
    --um-radius-lg: 16px;

    box-sizing: border-box !important;
    width: 100% !important;
    color: var(--um-ink-main) !important;
    font-family: 'Outfit', 'Inter', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
    padding: 16px 20px 48px !important;
    background: var(--um-bg) !important;
  }

  .user-manual-page *,
  .user-manual-page *::before,
  .user-manual-page *::after {
    box-sizing: border-box !important;
  }

  .user-manual-page.is-hindi {
    font-family: "Noto Sans Devanagari", "Nirmala UI", Mangal, 'Outfit', 'Inter', system-ui, sans-serif !important;
  }

  /* Icons */
  .um-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    display: inline-block;
  }

  .um-icon-dl {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
  }

  .um-icon-flow {
    width: 16px;
    height: 16px;
    color: var(--um-brand-mid);
    flex-shrink: 0;
  }

  /* 1. Hero Header */
  .user-manual-hero {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    gap: 20px !important;
    width: 100% !important;
    margin: 0 0 18px !important;
    padding: 20px 24px !important;
    border: 1px solid var(--um-border-brand) !important;
    border-radius: var(--um-radius-lg) !important;
    background: linear-gradient(135deg, #ffffff 0%, #f0f7f5 100%) !important;
    box-shadow: var(--um-shadow-md) !important;
  }

  .user-manual-hero-left {
    display: flex !important;
    align-items: center !important;
    gap: 18px !important;
    min-width: 0 !important;
    flex: 1 1 auto !important;
  }

  .user-manual-logo-wrap {
    width: 110px !important;
    min-height: 78px !important;
    padding: 8px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid var(--um-border) !important;
    border-radius: var(--um-radius-md) !important;
    background: #ffffff !important;
    box-shadow: var(--um-shadow-sm) !important;
    flex-shrink: 0 !important;
  }

  .user-manual-logo-img {
    max-width: 100% !important;
    max-height: 64px !important;
    object-fit: contain !important;
    display: block !important;
  }

  .user-manual-hero-info {
    min-width: 0 !important;
  }

  .user-manual-tag-row {
    display: flex !important;
    flex-wrap: wrap !important;
    align-items: center !important;
    gap: 6px !important;
    margin-bottom: 6px !important;
  }

  .user-manual-badge-primary {
    display: inline-flex !important;
    align-items: center !important;
    gap: 5px !important;
    padding: 3px 9px !important;
    border-radius: 999px !important;
    background: var(--um-brand-light) !important;
    color: var(--um-brand-deep) !important;
    font-size: 0.76rem !important;
    font-weight: 750 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.04em !important;
  }

  .user-manual-badge-neutral {
    display: inline-flex !important;
    align-items: center !important;
    padding: 3px 9px !important;
    border-radius: 999px !important;
    border: 1px solid var(--um-border) !important;
    background: #ffffff !important;
    color: var(--um-ink-muted) !important;
    font-size: 0.78rem !important;
    font-weight: 600 !important;
  }

  .user-manual-badge-neutral strong {
    color: var(--um-brand-deep) !important;
    margin-left: 3px !important;
  }

  .user-manual-title {
    margin: 0 !important;
    font-size: 1.6rem !important;
    font-weight: 800 !important;
    color: var(--um-brand-deep) !important;
    line-height: 1.2 !important;
    letter-spacing: -0.01em !important;
  }

  .user-manual-subtitle {
    margin: 5px 0 0 !important;
    color: var(--um-ink-muted) !important;
    font-size: 0.92rem !important;
    line-height: 1.45 !important;
    max-width: 760px !important;
  }

  .user-manual-hero-right {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-end !important;
    gap: 10px !important;
    flex-shrink: 0 !important;
  }

  .user-manual-lang-pills {
    display: inline-flex !important;
    padding: 3px !important;
    border: 1px solid var(--um-border) !important;
    border-radius: 10px !important;
    background: #ffffff !important;
    box-shadow: var(--um-shadow-sm) !important;
  }

  .user-manual-lang-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 5px 12px !important;
    border-radius: 7px !important;
    text-decoration: none !important;
    font-size: 0.82rem !important;
    font-weight: 700 !important;
    color: var(--um-ink-muted) !important;
    transition: all 0.2s ease !important;
  }

  .user-manual-lang-btn:hover {
    color: var(--um-brand-deep) !important;
    background: var(--um-brand-subtle) !important;
  }

  .user-manual-lang-btn.active {
    background: var(--um-brand-mid) !important;
    color: #ffffff !important;
  }

  .user-manual-hero-actions {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
  }

  .user-manual-btn-download {
    display: inline-flex !important;
    align-items: center !important;
    gap: 7px !important;
    padding: 8px 15px !important;
    border-radius: 9px !important;
    background: linear-gradient(135deg, var(--um-brand-mid) 0%, var(--um-brand-deep) 100%) !important;
    color: #ffffff !important;
    font-size: 0.85rem !important;
    font-weight: 750 !important;
    text-decoration: none !important;
    box-shadow: 0 4px 12px rgba(11, 111, 102, 0.28) !important;
    transition: all 0.2s ease !important;
    border: none !important;
  }

  .user-manual-btn-download:hover {
    transform: translateY(-1px) !important;
    box-shadow: 0 6px 16px rgba(11, 111, 102, 0.36) !important;
    color: #ffffff !important;
  }

  .user-manual-btn-print {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 38px !important;
    height: 38px !important;
    border-radius: 9px !important;
    border: 1px solid var(--um-border) !important;
    background: #ffffff !important;
    color: var(--um-ink-muted) !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
  }

  .user-manual-btn-print:hover {
    background: var(--um-brand-subtle) !important;
    color: var(--um-brand-deep) !important;
    border-color: var(--um-border-brand) !important;
  }

  /* 2. Process Stepper */
  .user-manual-workflow-bar {
    display: flex !important;
    align-items: center !important;
    gap: 16px !important;
    padding: 10px 16px !important;
    margin-bottom: 14px !important;
    border: 1px solid var(--um-border) !important;
    border-radius: var(--um-radius-md) !important;
    background: #ffffff !important;
    box-shadow: var(--um-shadow-sm) !important;
    overflow: hidden !important;
  }

  .um-workflow-title {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    font-size: 0.85rem !important;
    font-weight: 800 !important;
    color: var(--um-brand-deep) !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
    padding-right: 12px !important;
    border-right: 1px solid var(--um-border) !important;
  }

  .um-stepper-track {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    overflow-x: auto !important;
    padding: 3px 0 !important;
    scrollbar-width: thin !important;
  }

  .um-step-item {
    display: inline-flex !important;
    align-items: center !important;
    gap: 5px !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
  }

  .um-step-dot {
    width: 20px !important;
    height: 20px !important;
    border-radius: 50% !important;
    background: var(--um-brand-light) !important;
    color: var(--um-brand-deep) !important;
    font-size: 0.72rem !important;
    font-weight: 800 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid var(--um-border-brand) !important;
  }

  .um-step-text {
    font-size: 0.8rem !important;
    font-weight: 650 !important;
    color: var(--um-ink-main) !important;
  }

  .um-step-connector {
    width: 14px !important;
    height: 2px !important;
    background: var(--um-border) !important;
    flex-shrink: 0 !important;
    margin: 0 2px !important;
  }

  /* 3. Key Highlights Strip */
  .user-manual-tips-strip {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 12px !important;
    margin-bottom: 18px !important;
  }

  .um-tip-card {
    display: flex !important;
    align-items: flex-start !important;
    gap: 12px !important;
    padding: 12px 14px !important;
    border: 1px solid var(--um-border) !important;
    border-radius: var(--um-radius-md) !important;
    background: #ffffff !important;
    box-shadow: var(--um-shadow-sm) !important;
    transition: box-shadow 0.2s ease !important;
  }

  .um-tip-card:hover {
    box-shadow: var(--um-shadow-md) !important;
  }

  .um-tip-icon {
    width: 32px !important;
    height: 32px !important;
    border-radius: 8px !important;
    background: var(--um-brand-light) !important;
    color: var(--um-brand-mid) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
  }

  .um-tip-icon svg {
    width: 18px !important;
    height: 18px !important;
  }

  .um-tip-content {
    min-width: 0 !important;
  }

  .um-tip-content h4 {
    margin: 0 0 3px !important;
    font-size: 0.88rem !important;
    font-weight: 750 !important;
    color: var(--um-brand-deep) !important;
  }

  .um-tip-content p {
    margin: 0 !important;
    font-size: 0.82rem !important;
    line-height: 1.42 !important;
    color: var(--um-ink-muted) !important;
  }

  /* 4. Main Layout (Sidebar + Content) */
  .user-manual-main-layout {
    display: grid !important;
    grid-template-columns: 260px minmax(0, 1fr) !important;
    gap: 20px !important;
    align-items: start !important;
  }

  /* Table of Contents */
  .user-manual-sidebar {
    min-width: 0 !important;
  }

  .um-toc-sticky-box {
    position: sticky !important;
    top: 14px !important;
    max-height: calc(100vh - 40px) !important;
    overflow-y: auto !important;
    padding: 14px !important;
    border: 1px solid var(--um-border) !important;
    border-radius: var(--um-radius-md) !important;
    background: #ffffff !important;
    box-shadow: var(--um-shadow-md) !important;
  }

  .um-toc-header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding-bottom: 10px !important;
    border-bottom: 1px solid var(--um-border) !important;
    margin-bottom: 10px !important;
  }

  .um-toc-header h3 {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    margin: 0 !important;
    font-size: 0.94rem !important;
    font-weight: 800 !important;
    color: var(--um-brand-deep) !important;
  }

  .um-toc-count {
    font-size: 0.74rem !important;
    font-weight: 700 !important;
    padding: 2px 7px !important;
    border-radius: 999px !important;
    background: var(--um-brand-light) !important;
    color: var(--um-brand-deep) !important;
  }

  .um-toc-search-wrap {
    position: relative !important;
    margin-bottom: 10px !important;
  }

  .um-search-icon {
    position: absolute !important;
    left: 9px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    width: 14px !important;
    height: 14px !important;
    color: var(--um-ink-subtle) !important;
    pointer-events: none !important;
  }

  #um-filter-input {
    width: 100% !important;
    padding: 6px 26px 6px 29px !important;
    font-size: 0.82rem !important;
    border: 1px solid var(--um-border) !important;
    border-radius: 7px !important;
    background: var(--um-bg) !important;
    color: var(--um-ink-main) !important;
    outline: none !important;
    transition: all 0.2s ease !important;
  }

  #um-filter-input:focus {
    background: #ffffff !important;
    border-color: var(--um-brand-mid) !important;
    box-shadow: 0 0 0 2px rgba(11, 111, 102, 0.15) !important;
  }

  .um-filter-clear-btn {
    position: absolute !important;
    right: 7px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    background: transparent !important;
    border: none !important;
    font-size: 1.1rem !important;
    color: var(--um-ink-subtle) !important;
    cursor: pointer !important;
    line-height: 1 !important;
    padding: 0 !important;
  }

  .um-toc-nav {
    display: flex !important;
    flex-direction: column !important;
    gap: 3px !important;
  }

  .um-toc-link {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    padding: 7px 9px !important;
    border-radius: 7px !important;
    text-decoration: none !important;
    color: var(--um-ink-muted) !important;
    font-size: 0.82rem !important;
    font-weight: 650 !important;
    line-height: 1.35 !important;
    transition: all 0.18s ease !important;
  }

  .um-toc-link:hover {
    background: var(--um-brand-subtle) !important;
    color: var(--um-brand-deep) !important;
  }

  .um-toc-link.active {
    background: var(--um-brand-mid) !important;
    color: #ffffff !important;
  }

  .um-toc-num {
    flex-shrink: 0 !important;
    width: 22px !important;
    height: 22px !important;
    border-radius: 5px !important;
    background: var(--um-brand-light) !important;
    color: var(--um-brand-deep) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 0.72rem !important;
    font-weight: 800 !important;
  }

  .um-toc-link.active .um-toc-num {
    background: rgba(255, 255, 255, 0.25) !important;
    color: #ffffff !important;
  }

  .um-toc-title {
    min-width: 0 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  /* 5. Section Cards */
  .user-manual-content {
    display: flex !important;
    flex-direction: column !important;
    gap: 18px !important;
    min-width: 0 !important;
  }

  .user-manual-card {
    border: 1px solid var(--um-border) !important;
    border-radius: var(--um-radius-lg) !important;
    background: #ffffff !important;
    box-shadow: var(--um-shadow-md) !important;
    padding: 22px 24px !important;
    transition: box-shadow 0.2s ease !important;
  }

  .user-manual-card:hover {
    box-shadow: var(--um-shadow-lg) !important;
  }

  .um-card-header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 14px !important;
    padding-bottom: 14px !important;
    border-bottom: 1px solid var(--um-border) !important;
    margin-bottom: 18px !important;
  }

  .um-card-title-group {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    min-width: 0 !important;
  }

  .um-section-badge {
    width: 36px !important;
    height: 36px !important;
    border-radius: 9px !important;
    background: linear-gradient(135deg, var(--um-brand-mid) 0%, var(--um-brand-deep) 100%) !important;
    color: #ffffff !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 0.85rem !important;
    font-weight: 850 !important;
    flex-shrink: 0 !important;
    box-shadow: 0 3px 8px rgba(11, 111, 102, 0.25) !important;
  }

  .um-card-header h2 {
    margin: 0 !important;
    font-size: 1.25rem !important;
    font-weight: 800 !important;
    color: var(--um-ink-main) !important;
    line-height: 1.25 !important;
  }

  .um-step-badge {
    font-size: 0.78rem !important;
    font-weight: 750 !important;
    padding: 3px 9px !important;
    border-radius: 999px !important;
    background: var(--um-brand-light) !important;
    color: var(--um-brand-deep) !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
  }

  .um-card-body {
    min-width: 0 !important;
  }

  /* Steps List */
  .um-steps-list {
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 10px !important;
  }

  .um-step-row {
    display: flex !important;
    align-items: flex-start !important;
    gap: 12px !important;
  }

  .um-step-marker {
    flex-shrink: 0 !important;
    width: 24px !important;
    height: 24px !important;
    border-radius: 50% !important;
    background: var(--um-brand-subtle) !important;
    color: var(--um-brand-deep) !important;
    font-size: 0.78rem !important;
    font-weight: 800 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin-top: 2px !important;
    border: 1px solid var(--um-border-brand) !important;
  }

  .um-step-detail {
    font-size: 0.94rem !important;
    line-height: 1.55 !important;
    color: #24352f !important;
    flex: 1 1 auto !important;
  }

  /* Note Callout */
  .um-note-callout {
    display: flex !important;
    align-items: flex-start !important;
    gap: 10px !important;
    margin-top: 16px !important;
    padding: 11px 14px !important;
    border-radius: 9px !important;
    background: #fffbeb !important;
    border-left: 4px solid var(--um-accent-amber) !important;
    border-top: 1px solid #fef3c7 !important;
    border-right: 1px solid #fef3c7 !important;
    border-bottom: 1px solid #fef3c7 !important;
    box-shadow: 0 1px 3px rgba(217, 119, 6, 0.06) !important;
  }

  .um-note-icon {
    width: 18px !important;
    height: 18px !important;
    color: var(--um-accent-amber) !important;
    flex-shrink: 0 !important;
    margin-top: 1px !important;
  }

  .um-note-icon svg {
    width: 100% !important;
    height: 100% !important;
  }

  .um-note-body {
    font-size: 0.88rem !important;
    line-height: 1.48 !important;
    color: #78350f !important;
  }

  .um-note-body strong {
    color: #451a03 !important;
    font-weight: 750 !important;
    margin-right: 3px !important;
  }

  /* Screenshots */
  .um-screenshots-wrapper {
    margin-top: 20px !important;
    padding-top: 16px !important;
    border-top: 1px solid var(--um-border) !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 14px !important;
  }

  .um-screenshot-card {
    margin: 0 !important;
    min-width: 0 !important;
  }

  a.um-screenshot-frame {
    display: block !important;
    text-decoration: none !important;
    position: relative !important;
    overflow: hidden !important;
    border: 1px solid var(--um-border) !important;
    border-radius: var(--um-radius-md) !important;
    background: #f8fafc !important;
    cursor: pointer !important;
    transition: all 0.22s ease !important;
  }

  a.um-screenshot-frame:hover {
    border-color: var(--um-brand-mid) !important;
    box-shadow: var(--um-shadow-lg) !important;
    transform: translateY(-2px) !important;
  }

  .um-screenshot-topbar {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    height: 28px !important;
    padding: 0 10px !important;
    border-bottom: 1px solid var(--um-border) !important;
    background: #f1f5f9 !important;
  }

  .um-window-btn {
    width: 9px !important;
    height: 9px !important;
    border-radius: 50% !important;
    display: inline-block !important;
  }

  .um-window-btn.red { background: #ef4444 !important; }
  .um-window-btn.yellow { background: #f59e0b !important; }
  .um-window-btn.green { background: #10b981 !important; }

  .um-window-title {
    margin-left: 6px !important;
    font-size: 0.74rem !important;
    font-weight: 650 !important;
    color: var(--um-ink-muted) !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    flex: 1 1 auto !important;
  }

  .um-zoom-hint {
    display: inline-flex !important;
    align-items: center !important;
    gap: 4px !important;
    font-size: 0.72rem !important;
    font-weight: 700 !important;
    color: var(--um-brand-mid) !important;
    padding: 2px 7px !important;
    border-radius: 5px !important;
    background: #ffffff !important;
    border: 1px solid var(--um-border) !important;
  }

  .um-zoom-hint svg {
    width: 12px !important;
    height: 12px !important;
  }

