<% if @vendor_registration.present? %>
  <div class="app-page-header">
    <h2>Vendor Registration Form</h2>
  </div>

  <%= render "vendor_registrations/form",
        vendor_registration: @vendor_registration,
        form_url: register_vendor_registration_invitation_path(@invitation.token),
        form_method: :post,
        lock_mobile_no: true,
        disable_turbo: true %>
<% else %>
  <style>
    .vendor-registration-otp-shell {
      display: grid;
      gap: 1.25rem;
      width: 100%;
      max-width: 900px;
      margin: 2rem auto 0;
      padding: clamp(1rem, 2vw, 1.25rem);
      border: 1px solid #d7e5de;
      border-radius: 30px;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(245, 250, 247, 0.96));
      box-shadow: 0 20px 46px rgba(20, 56, 43, 0.08);
    }

    .vendor-registration-otp-card {
      display: grid;
      grid-template-columns: minmax(250px, 0.86fr) minmax(300px, 1.14fr);
      overflow: hidden;
      border: 1px solid #d8e7df;
      border-radius: 26px;
      background: #fff;
      box-shadow: 0 12px 30px rgba(17, 59, 37, 0.06);
    }

    .vendor-registration-otp-side {
      display: flex;
      min-height: 330px;
      flex-direction: column;
      justify-content: space-between;
      gap: 1.35rem;
      padding: clamp(1.2rem, 3vw, 1.7rem);
      background:
        radial-gradient(circle at 86% 12%, rgba(216, 242, 226, 0.22), transparent 6rem),
        radial-gradient(circle at top left, rgba(255, 255, 255, 0.24), transparent 17rem),
        linear-gradient(145deg, #0f5f38, #174630);
      color: #fff;
    }

    .vendor-registration-otp-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      color: #d8f2e2;
      font-size: 0.76rem;
      font-weight: 800;
      letter-spacing: 0.11em;
      text-transform: uppercase;
    }

    .vendor-registration-otp-eyebrow::before {
      content: "";
      width: 0.65rem;
      height: 0.65rem;
      border-radius: 50%;
      background: #d8f2e2;
      box-shadow: 0 0 0 0.35rem rgba(216, 242, 226, 0.13);
    }

    .vendor-registration-otp-title {
      margin: 0.55rem 0 0;
      font-size: clamp(1.7rem, 3.6vw, 2.35rem);
      font-weight: 850;
      line-height: 1.08;
    }

    .vendor-registration-otp-copy {
      margin: 0.75rem 0 0;
      color: rgba(255, 255, 255, 0.84);
      line-height: 1.7;
    }

    .vendor-registration-otp-mark {
      display: grid;
      width: 108px;
      height: 108px;
      place-items: center;
      border: 1px solid rgba(255, 255, 255, 0.28);
      border-radius: 32px;
      background: rgba(255, 255, 255, 0.12);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 18px 36px rgba(6, 38, 22, 0.2);
      color: #ffffff;
      font-size: 1.35rem;
      font-weight: 900;
      letter-spacing: 0.08em;
    }

    .vendor-registration-otp-mini {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      gap: 0.45rem;
      padding: 0.58rem 0.82rem;
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.1);
      color: rgba(255, 255, 255, 0.86);
      font-size: 0.82rem;
      font-weight: 750;
    }

    .vendor-registration-otp-form {
      display: grid;
      align-content: center;
      padding: clamp(1.2rem, 3vw, 1.7rem);
      background: linear-gradient(180deg, #ffffff, #fbfdfc);
    }

    .vendor-registration-otp-facts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem;
      margin-bottom: 1rem;
    }

    .vendor-registration-otp-fact {
      min-width: 0;
      padding: 1rem;
      border: 1px solid #dbe8e1;
      border-radius: 18px;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 252, 249, 0.98));
    }

    .vendor-registration-otp-input {
      min-height: 54px;
      border-radius: 16px;
      font-size: 1.2rem;
      font-weight: 800;
      letter-spacing: 0.25em;
      text-align: center;
    }

    .vendor-registration-otp-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-top: 0.85rem;
    }

    .vendor-registration-otp-actions form {
      margin: 0;
    }

    .vendor-registration-otp-submit,
    .vendor-registration-otp-resend {
      min-height: 50px;
      border-radius: 999px;
    }

    @media (max-width: 760px) {
      .vendor-registration-otp-shell {
        margin-top: 1rem;
        padding: 0.7rem;
      }

      .vendor-registration-otp-card,
      .vendor-registration-otp-facts {
        grid-template-columns: 1fr;
      }

      .vendor-registration-otp-side {
        min-height: 250px;
      }
    }
  </style>

  <div class="vendor-registration-otp-shell">
    <section class="vendor-registration-otp-card">
      <div class="vendor-registration-otp-side">
        <div>
          <div class="vendor-registration-otp-eyebrow">Secure Verification</div>
          <h1 class="vendor-registration-otp-title">Vendor Registration OTP Verification</h1>
          <p class="vendor-registration-otp-copy">Verify the OTP sent to your mobile number to open the vendor registration form.</p>
        </div>
        <div class="vendor-registration-otp-mark">OTP</div>
        <div class="vendor-registration-otp-mini">Protected registration access</div>
      </div>

      <div class="vendor-registration-otp-form">
        <div class="vendor-registration-otp-facts">
          <div class="vendor-registration-otp-fact">
            <div class="app-detail-label">Mobile Number</div>
            <div class="app-detail-value"><%= @invitation.mobile_no %></div>
          </div>
          <div class="vendor-registration-otp-fact">
            <div class="app-detail-label">Last OTP Sent At</div>
            <div class="app-detail-value"><%= @invitation.otp_sent_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
          </div>
        </div>

        <%= form_with url: verify_vendor_registration_invitation_otp_path(@invitation.token), method: :post, local: true, data: { turbo: false } do |form| %>
          <div class="app-form-field">
            <%= form.label :otp_code, "Enter OTP" %>
            <%= form.text_field :otp_code, maxlength: 6, required: true, class: "form-control vendor-registration-otp-input", inputmode: "numeric", autocomplete: "one-time-code", placeholder: "------" %>
          </div>

          <div class="vendor-registration-otp-actions">
            <%= form.submit "Verify OTP", class: "app-form-submit vendor-registration-otp-submit" %>
          </div>
        <% end %>

        <div class="vendor-registration-otp-actions">
          <%= button_to "Send New OTP", send_vendor_registration_invitation_otp_path(@invitation.token), method: :post, class: "app-secondary-btn vendor-registration-otp-resend", data: { turbo: false } %>
        </div>
      </div>
    </section>
  </div>
<% end %>
