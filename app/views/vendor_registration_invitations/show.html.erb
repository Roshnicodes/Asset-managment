<div class="app-page-header">
  <h2>Vendor Registration SMS Invite</h2>
  <%= link_to "Back", vendor_registrations_path, class: "app-back-link" %>
</div>

<div class="app-detail-card">
  <p class="app-section-note">
    The registration invite has been sent to the vendor mobile number. The registration link is not shown here; the vendor must open the SMS link and verify OTP before submitting the registration form.
  </p>

  <div class="app-detail-grid">
    <div class="app-detail-item">
      <div class="app-detail-label">Mobile No</div>
      <div class="app-detail-value"><%= @invitation.mobile_no %></div>
    </div>
    <div class="app-detail-item">
      <div class="app-detail-label">Status</div>
      <div class="app-detail-value"><%= @invitation.status.to_s.humanize %></div>
    </div>
    <div class="app-detail-item">
      <div class="app-detail-label">Sent At</div>
      <div class="app-detail-value"><%= @invitation.sent_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
    </div>
    <div class="app-detail-item">
      <div class="app-detail-label">OTP Verified At</div>
      <div class="app-detail-value"><%= @invitation.otp_verified_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
    </div>
    <div class="app-detail-item">
      <div class="app-detail-label">Registered At</div>
      <div class="app-detail-value"><%= @invitation.vendor_registration&.submitted_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
    </div>
  </div>

  <div style="margin-top: 1.25rem; max-width: 220px;">
    <%= qr_code_svg(@invitation.registration_link, module_size: 4) %>
  </div>

  <div class="app-form-actions" style="margin-top: 1rem;">
    <%= button_to "Resend SMS Invite",
          resend_vendor_registration_invitation_path(@invitation),
          method: :post,
          class: "app-form-submit",
          data: { turbo: false } %>
  </div>
</div>
