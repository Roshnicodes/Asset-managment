<div class="app-page-header">
  <h2>Vendor Registration SMS Invite</h2>
  <%= link_to "Back", vendor_registrations_path, class: "app-back-link" %>
</div>

<div class="app-detail-card">
  <p class="app-section-note">
    The registration invite has been sent to the vendor mobile number. The registration link is not shown here; the vendor must open the SMS link and verify OTP before submitting the registration form.
  </p>

  <div class="app-detail-grid">
    <div class="app-detail-item">
      <div class="app-detail-label">Mobile No</div>
      <div class="app-detail-value"><%= @invitation.mobile_no %></div>
    </div>
    <div class="app-detail-item">
      <div class="app-detail-label">Status</div>
      <div class="app-detail-value"><%= @invitation.status.to_s.humanize %></div>
    </div>
    <div class="app-detail-item">
      <div class="app-detail-label">Sent At</div>
      <div class="app-detail-value"><%= @invitation.sent_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
    </div>
    <div class="app-detail-item">
      <div class="app-detail-label">OTP Verified At</div>
      <div class="app-detail-value"><%= @invitation.otp_verified_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
    </div>
    <div class="app-detail-item">
      <div class="app-detail-label">Registered At</div>
      <div class="app-detail-value"><%= @invitation.vendor_registration&.submitted_at&.strftime("%d-%m-%Y %H:%M") || "-" %></div>
    </div>
  </div>

  <div style="margin-top: 1.25rem; max-width: 220px;">
    <div data-vendor-registration-qr="true">
      <%= qr_code_svg(@invitation.registration_link, module_size: 4) %>
    </div>
    <div style="margin-top: 0.75rem; display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
      <button type="button" class="app-secondary-btn" data-copy-vendor-registration-qr="true">Copy QR</button>
      <span class="app-section-note mb-0" data-copy-vendor-registration-qr-status="true"></span>
    </div>
  </div>

  <div class="app-form-actions" style="margin-top: 1rem;">
    <%= button_to "Resend SMS Invite",
          resend_vendor_registration_invitation_path(@invitation),
          method: :post,
          class: "app-form-submit",
          data: { turbo: false } %>
  </div>
</div>

<script>
  document.addEventListener("turbo:load", function () {
    var copyButton = document.querySelector("[data-copy-vendor-registration-qr='true']");
    var qrWrap = document.querySelector("[data-vendor-registration-qr='true']");
    var statusEl = document.querySelector("[data-copy-vendor-registration-qr-status='true']");
    if (!copyButton || !qrWrap) return;

    function setStatus(message) {
      if (!statusEl) return;
      statusEl.textContent = message;
    }

    function downloadBlob(blob) {
      var url = URL.createObjectURL(blob);
      var link = document.createElement("a");
      link.href = url;
      link.download = "vendor-registration-qr.png";
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    }

    function qrBlob() {
      return new Promise(function (resolve, reject) {
        var svg = qrWrap.querySelector("svg");
        if (!svg) {
          reject(new Error("QR not found"));
          return;
        }

        var clonedSvg = svg.cloneNode(true);
        var box = svg.getBoundingClientRect();
        var width = Math.ceil(box.width || 220);
        var height = Math.ceil(box.height || width);
        clonedSvg.setAttribute("width", width);
        clonedSvg.setAttribute("height", height);

        var svgText = new XMLSerializer().serializeToString(clonedSvg);
        var image = new Image();
        image.onload = function () {
          var canvas = document.createElement("canvas");
          canvas.width = width;
          canvas.height = height;
          var context = canvas.getContext("2d");
          context.fillStyle = "#ffffff";
          context.fillRect(0, 0, width, height);
          context.drawImage(image, 0, 0, width, height);
          canvas.toBlob(function (blob) {
            blob ? resolve(blob) : reject(new Error("QR copy failed"));
          }, "image/png");
        };
        image.onerror = reject;
        image.src = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svgText);
      });
    }

    copyButton.addEventListener("click", async function () {
      setStatus("Copying...");
      try {
        var blob = await qrBlob();
        if (navigator.clipboard && window.ClipboardItem) {
          await navigator.clipboard.write([new ClipboardItem({ "image/png": blob })]);
          setStatus("QR copied.");
        } else {
          downloadBlob(blob);
          setStatus("QR downloaded.");
        }
      } catch (error) {
        try {
          var fallbackBlob = await qrBlob();
          downloadBlob(fallbackBlob);
          setStatus("QR downloaded.");
        } catch (_) {
          setStatus("QR copy failed.");
        }
      }
    });
  });
</script>
