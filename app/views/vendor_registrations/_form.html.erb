<%= form_with(model: vendor_registration, html: { data: { vendor_validation_form: true }, novalidate: true }) do |form| %>
  <% approval_request = vendor_registration.approval_request %>
  <% field_errors = ->(field_name) { vendor_registration.errors.full_messages_for(field_name) } %>
  <div class="app-form-card app-form-card-wide">
    <% if approval_request&.employee_return_pending? %>
      <div class="app-detail-card" style="margin-bottom: 1.5rem; border: 1px solid #f3d9b1; background: linear-gradient(135deg, #fffaf0, #fffdf7);">
        <div class="app-page-header" style="margin-bottom: 0.75rem;">
          <div>
            <h3 style="margin: 0; color: #8a5a10;">Returned For Correction</h3>
            <p class="app-section-note mb-0">Please review the returned remark below, update the vendor registration form, and save to restart the same approval channel.</p>
          </div>
        </div>

        <div class="app-detail-grid">
          <div class="app-detail-item">
            <div class="app-detail-label">Returned By</div>
            <div class="app-detail-value"><%= approval_request.employee_return_actor_label %></div>
          </div>

          <div class="app-detail-item" style="grid-column: 1 / -1;">
            <div class="app-detail-label">Remark / Fix Required</div>
            <div class="app-detail-value" style="white-space: pre-wrap;"><%= approval_request.employee_return_remark.presence || "No remark was added." %></div>
          </div>
        </div>
      </div>
    <% end %>

    <% if vendor_registration.errors.any? %>
      <div class="app-form-errors">
        <h2>Please fix the following details:</h2>
        <ul>
          <% vendor_registration.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="app-form-section">
      <div class="app-form-section-title">Basic Information</div>
      <p class="app-form-section-note">Firm details and vendor identity.</p>
    </div>

    <div class="app-form-grid two-col">
      <div class="app-form-field <%= "has-error" if field_errors.call(:stakeholder_category_id).any? %>">
        <%= form.label :stakeholder_category_id, "Stakeholder Name" %>
        <% if !admin_user? && @current_stakeholder_category.present? %>
          <%= form.hidden_field :stakeholder_category_id, value: @current_stakeholder_category.id %>
          <input type="text" value="<%= @current_stakeholder_category.name %>" readonly class="form-control">
        <% else %>
          <%= form.collection_select :stakeholder_category_id, @stakeholder_categories, :id, :name, { prompt: "Select stakeholder" }, { required: true, data: { validation_label: "Stakeholder Name" } } %>
        <% end %>
        <% field_errors.call(:stakeholder_category_id).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>

      <div class="app-form-field <%= "has-error" if field_errors.call(:firm_name).any? %>">
        <%= form.label :firm_name, "Firm Name" %>
        <%= form.text_field :firm_name, required: true, data: { validation_label: "Firm Name" } %>
        <% field_errors.call(:firm_name).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>
    </div>

    <div class="app-form-grid three-col">
      <div class="app-form-field <%= "has-error" if field_errors.call(:vendor_name).any? %>">
        <%= form.label :vendor_name, "Vendor Name" %>
        <%= form.text_field :vendor_name, required: true, data: { validation_label: "Vendor Name" } %>
        <% field_errors.call(:vendor_name).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>

      <div class="app-form-field <%= "has-error" if field_errors.call(:firm_type).any? %>">
        <%= form.label :firm_type, "Firm Type" %>
        <%= form.select :firm_type, @firms.pluck(:name), { prompt: "Select firm type" }, { required: true, data: { vendor_firm_type: true, validation_label: "Firm Type" } } %>
        <% field_errors.call(:firm_type).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>
    </div>

    <div class="app-form-section">
      <div class="app-form-section-title">Contact and Location</div>
      <p class="app-form-section-note">Business contact details and LG mapping.</p>
    </div>

    <div class="app-form-grid four-col">
      <div class="app-form-field <%= "has-error" if field_errors.call(:gst_no).any? %>">
        <%= form.label :gst_no, "GST No" %>
        <%= form.text_field :gst_no,
              maxlength: 15,
              minlength: 15,
              pattern: "\\d{2}[A-Za-z]{5}\\d{4}[A-Za-z]{1}[1-9A-Za-z]{1}Z[0-9A-Za-z]{1}",
              title: "Enter a valid 15-character GST number, for example 27ABCDE1234F1Z5.",
              autocomplete: "off",
              data: { uppercase_input: true, validation_label: "GST No", gst_field: true } %>
        <% field_errors.call(:gst_no).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>

      <div class="app-form-field <%= "has-error" if field_errors.call(:pan_no).any? %>">
        <%= form.label :pan_no, "PAN No" %>
        <%= form.text_field :pan_no,
              required: true,
              maxlength: 10,
              minlength: 10,
              pattern: "[A-Za-z]{5}\\d{4}[A-Za-z]{1}",
              title: "Enter a valid 10-character PAN number, for example ABCDE1234F.",
              autocomplete: "off",
              data: { uppercase_input: true, validation_label: "PAN No" } %>
        <% field_errors.call(:pan_no).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>

      <div class="app-form-field <%= "has-error" if field_errors.call(:email).any? %>">
        <%= form.label :email, "Email" %>
        <%= form.email_field :email,
              required: true,
              maxlength: 255,
              title: "Enter a valid email address, for example name@example.com.",
              autocomplete: "email",
              data: { validation_label: "Email" } %>
        <% field_errors.call(:email).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>

      <div class="app-form-field <%= "has-error" if field_errors.call(:mobile_no).any? %>">
        <%= form.label :mobile_no, "Mobile No" %>
        <%= form.telephone_field :mobile_no,
              required: true,
              maxlength: 10,
              minlength: 10,
              pattern: "[6-9][0-9]{9}",
              title: "Enter a valid 10-digit Indian mobile number starting with 6, 7, 8, or 9.",
              inputmode: "numeric",
              autocomplete: "tel",
              data: { numeric_input: true, validation_label: "Mobile No" } %>
        <% field_errors.call(:mobile_no).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>
    </div>

    <div class="app-form-grid three-col">
      <div class="app-form-field <%= "has-error" if field_errors.call(:address).any? %>" style="grid-column: span 2;">
        <%= form.label :address, "Address" %>
        <%= form.text_area :address,
              rows: 2,
              required: true,
              placeholder: "House no, street, locality",
              style: "min-height: 88px; resize: vertical;",
              data: { validation_label: "Address" } %>
        <% field_errors.call(:address).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>
    </div>

    <div class="app-form-grid four-col">
      <div class="app-form-field <%= "has-error" if field_errors.call(:state).any? || field_errors.call(:state_id).any? %>">
        <%= form.label :state_id, "State" %>
        <%= form.collection_select :state_id, @states, :id, :name, { prompt: "Select state" }, { required: true, data: { validation_label: "State" } } %>
        <% (field_errors.call(:state) + field_errors.call(:state_id)).uniq.each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>

      <div class="app-form-field <%= "has-error" if field_errors.call(:district).any? || field_errors.call(:district_id).any? %>">
        <%= form.label :district_id, "District" %>
        <%= form.collection_select :district_id, @districts, :id, :name, { prompt: "Select district" }, { required: true, data: { validation_label: "District" } } %>
        <% (field_errors.call(:district) + field_errors.call(:district_id)).uniq.each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>

      <div class="app-form-field <%= "has-error" if field_errors.call(:block).any? || field_errors.call(:block_id).any? %>">
        <%= form.label :block_id, "Block" %>
        <%= form.collection_select :block_id, @blocks, :id, :name, { prompt: "Select block" }, { required: true, data: { validation_label: "Block" } } %>
        <% (field_errors.call(:block) + field_errors.call(:block_id)).uniq.each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>

      <div class="app-form-field <%= "has-error" if field_errors.call(:pin_no).any? %>">
        <%= form.label :pin_no, "PIN No" %>
        <%= form.text_field :pin_no,
              required: true,
              maxlength: 6,
              minlength: 6,
              pattern: "[1-9][0-9]{5}",
              title: "Enter a valid 6-digit PIN code.",
              inputmode: "numeric",
              autocomplete: "postal-code",
              data: { numeric_input: true, numeric_limit: 6, validation_label: "PIN No" } %>
        <% field_errors.call(:pin_no).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>
    </div>

    <div class="app-form-grid two-col">
      <div class="app-form-field <%= "has-error" if field_errors.call(:contact_person_name).any? %>">
        <%= form.label :contact_person_name, "Name of Contact Person" %>
        <%= form.text_field :contact_person_name, required: true, data: { validation_label: "Name of Contact Person" } %>
        <% field_errors.call(:contact_person_name).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>

      <div class="app-form-field <%= "has-error" if field_errors.call(:contact_person_designation).any? %>">
        <%= form.label :contact_person_designation, "Designation of Contact Person" %>
        <%= form.text_field :contact_person_designation, required: true, data: { validation_label: "Designation of Contact Person" } %>
        <% field_errors.call(:contact_person_designation).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>
    </div>

    <div class="app-form-section">
      <div class="app-form-section-title">Business Status</div>
      <p class="app-form-section-note">MSME and company activity details.</p>
    </div>

    <div class="app-form-grid three-col">
      <div class="app-form-field">
        <%= form.label :msme, "Is your firm MSME?" %>
        <%= form.select :msme, [["Yes", true], ["No", false]], { prompt: "Select MSME status" }, { data: { msme_toggle: true } } %>
      </div>

      <div class="app-form-field">
        <%= form.label :msme_number, "MSME No" %>
        <%= form.text_field :msme_number, data: { msme_number: true } %>
      </div>

      <div class="app-form-field <%= "has-error" if field_errors.call(:company_status).any? %>">
        <%= form.label :company_status, "Status of Company" %>
        <%= form.select :company_status, ["Active", "Inactive"], { prompt: "Select company status" }, { required: true, data: { validation_label: "Status of Company" } } %>
        <% field_errors.call(:company_status).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>
    </div>

    <div class="app-form-section">
      <div class="app-form-section-title">Theme and Product Selection</div>
      <p class="app-form-section-note">Pehle theme select karein, phir uske according product aur product variety choose karein.</p>
    </div>

    <div class="app-form-grid">
      <div class="app-form-field <%= "has-error" if field_errors.call(:theme_ids).any? %>" data-checkbox-group="true" data-checkbox-group-label="Theme Name">
        <%= form.label :theme_ids, "Theme Name" %>
        <p class="app-checkbox-note">Multiple selection ke liye checkbox use karein.</p>
        <%= hidden_field_tag "vendor_registration[theme_ids][]", "" %>
        <div class="app-checkbox-grid">
          <% @themes.each do |theme| %>
            <label class="app-checkbox-card">
              <%= check_box_tag "vendor_registration[theme_ids][]", theme.id, vendor_registration.theme_ids.include?(theme.id), class: "vendor-theme-checkbox", data: { theme_id: theme.id } %>
              <span><%= theme.name %></span>
            </label>
          <% end %>
        </div>
        <% field_errors.call(:theme_ids).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>

      <div class="app-form-field <%= "has-error" if field_errors.call(:product_ids).any? %>" data-checkbox-group="true" data-checkbox-group-label="Product Name">
        <%= form.label :product_ids, "Product Name" %>
        <p class="app-checkbox-note">Selected theme ke according products dikhenge.</p>
        <%= hidden_field_tag "vendor_registration[product_ids][]", "" %>
        <div class="app-checkbox-grid">
          <% @products.each do |product| %>
            <label class="app-checkbox-card vendor-product-card" data-theme-id="<%= product.theme_id %>">
              <%= check_box_tag "vendor_registration[product_ids][]", product.id, vendor_registration.product_ids.include?(product.id), class: "vendor-product-checkbox", data: { theme_id: product.theme_id, product_id: product.id } %>
              <span><%= "#{product.theme.name} - #{product.name}" %></span>
            </label>
          <% end %>
        </div>
        <% field_errors.call(:product_ids).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>

      <div class="app-form-field <%= "has-error" if field_errors.call(:product_variety_ids).any? %>" data-checkbox-group="true" data-checkbox-group-label="Product Variety Name">
        <%= form.label :product_variety_ids, "Product Variety Name" %>
        <p class="app-checkbox-note">Selected product ke according product varieties dikhenge.</p>
        <%= hidden_field_tag "vendor_registration[product_variety_ids][]", "" %>
        <div class="app-checkbox-grid">
          <% @product_varieties.each do |product_variety| %>
            <label class="app-checkbox-card vendor-variety-card" data-product-id="<%= product_variety.product_id %>">
              <%= check_box_tag "vendor_registration[product_variety_ids][]", product_variety.id, vendor_registration.product_variety_ids.include?(product_variety.id), class: "vendor-variety-checkbox", data: { product_id: product_variety.product_id } %>
              <span><%= "#{product_variety.product.name} - #{product_variety.name}" %></span>
            </label>
          <% end %>
        </div>
        <% field_errors.call(:product_variety_ids).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>

      <div class="app-form-field <%= "has-error" if field_errors.call(:firm_profile).any? %>">
        <%= form.label :firm_profile, "Brief Description of Firm Profile" %>
        <%= form.text_area :firm_profile, rows: 4, required: true, data: { validation_label: "Brief Description of Firm Profile" } %>
        <% field_errors.call(:firm_profile).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>

      <div class="app-form-field <%= "has-error" if field_errors.call(:business_description).any? %>">
        <%= form.label :business_description, "Brief Description of Business" %>
        <%= form.text_area :business_description, rows: 4, required: true, data: { validation_label: "Brief Description of Business" } %>
        <% field_errors.call(:business_description).each do |message| %>
          <div class="app-form-error"><%= message %></div>
        <% end %>
        <div class="app-form-error app-form-error-client" data-field-error="true"></div>
      </div>
    </div>

    <div class="app-form-section">
      <div class="app-form-section-title">Bank Details</div>
      <p class="app-form-section-note">Bank details aur check book / cancelled cheque yahan upload karein.</p>
    </div>

    <% field_errors.call(:vendor_bank_masters).each do |message| %>
      <div class="app-form-error" style="margin-bottom: 0.75rem;"><%= message %></div>
    <% end %>

    <%= form.fields_for :vendor_bank_masters do |bank_form| %>
      <%= render "vendor_bank_master_fields", form: bank_form %>
    <% end %>

    <div class="app-form-section">
      <div class="app-form-section-title">Document Uploads</div>
      <p class="app-form-section-note">Document master ke hisaab se uploads yahan dikhenge.</p>
    </div>

    <div class="app-form-grid four-col">
      <% vendor_registration.document_masters_for_form(@document_masters).each do |document_master| %>
        <% attachment_name = document_master.attachment_name %>
        <% attachment = vendor_registration.document_attachment_for(document_master) %>
        <% wrap_attributes = [] %>
        <% wrap_attributes << 'data-aadhar-upload-wrap="true"' if attachment_name == "aadhar_document" %>
        <% wrap_attributes << 'data-proprietor-only-document="true"' if attachment_name == "aadhar_document" %>
        <% wrap_attributes << 'data-msme-certificate-wrap="true"' if attachment_name == "msme_certificate" %>
        <% wrap_attributes << 'data-msme-only-document="true"' if document_master.msme_only? %>
        <% wrapper_classes = ["app-form-field"] %>
        <% wrapper_classes << "is-hidden" if attachment_name == "aadhar_document" && vendor_registration.firm_type.to_s.strip.casecmp("proprietor") != 0 %>
        <div class="<%= wrapper_classes.join(" ") %>" <%= wrap_attributes.join(" ").html_safe %>>
          <% if attachment_name.present? %>
            <%= form.label attachment_name.to_sym, document_master.name %>
            <%= form.file_field attachment_name.to_sym,
                  accept: ".pdf,image/*",
                  required: (
                    if attachment_name == "aadhar_document"
                      vendor_registration.firm_type.to_s.strip.casecmp("proprietor").zero? && !attachment&.attached?
                    elsif attachment_name == "msme_certificate"
                      vendor_registration.msme? && !attachment&.attached?
                    else
                      document_master.mandatory? && !attachment&.attached?
                    end
                  ),
                  data: (
                    if attachment_name == "aadhar_document"
                      { aadhar_upload: true, validation_label: document_master.name, document_input: true, has_attachment: attachment&.attached? }
                    elsif attachment_name == "msme_certificate"
                      { msme_certificate: true, validation_label: document_master.name, document_input: true, has_attachment: attachment&.attached? }
                    else
                      { validation_label: document_master.name, document_input: true, mandatory_document: document_master.mandatory?, has_attachment: attachment&.attached?, msme_only_document: document_master.msme_only? }
                    end
                  ) %>
            <% field_errors.call(attachment_name.to_sym).each do |message| %>
              <div class="app-form-error"><%= message %></div>
            <% end %>
          <% else %>
            <% input_id = "vendor_registration_document_uploads_#{document_master.id}" %>
            <%= label_tag input_id, document_master.name %>
            <%= file_field_tag "vendor_registration[document_uploads][#{document_master.id}]",
                  accept: ".pdf,image/*",
                  id: input_id,
                  required: document_master.mandatory? && !attachment&.attached?,
                  data: { validation_label: document_master.name, document_input: true, mandatory_document: document_master.mandatory?, msme_only_document: document_master.msme_only?, has_attachment: attachment&.attached? } %>
          <% end %>
          <div class="app-form-error app-form-error-client" data-field-error="true"></div>
          <p class="app-section-note" style="margin-top: 0.35rem;">
            <%= document_master.mandatory? ? "Mandatory" : "Optional" %>
          </p>
          <% if attachment_name == "aadhar_document" %>
            <p class="app-section-note">Aadhar upload sirf Proprietor firm type ke liye enable hoga.</p>
          <% end %>
          <% if attachment_name == "msme_certificate" %>
            <p class="app-section-note">MSME status Yes hone par certificate upload required hoga.</p>
          <% end %>
          <% if attachment&.attached? %>
            <p class="app-section-note" style="margin-top: 0.5rem;">
              Current file:
              <%= link_to attachment.filename.to_s, rails_blob_path(attachment, disposition: "attachment"), target: "_blank", rel: "noopener" %>
            </p>
          <% end %>
        </div>
      <% end %>
    </div>

    <p class="app-section-note">Submit time and user IP are saved automatically on submit.</p>

    <div class="app-form-actions">
      <%= form.submit "Submit Registration", class: "app-form-submit" %>
    </div>
  </div>
<% end %>

<script>
  document.addEventListener("turbo:load", function () {
    function toggleWrapperVisibility(wrapper, shouldShow) {
      wrapper.classList.toggle("is-hidden", !shouldShow);
      var input = wrapper.querySelector("input[type='file']");
      if (!input) return;

      if (!shouldShow) {
        input.required = false;
        clearFieldError(input);
      }
    }

    function updateGstRequirement(formEl) {
      var firmTypeInput = formEl.querySelector("[data-vendor-firm-type='true']");
      var gstInput = formEl.querySelector("[data-gst-field='true']");
      if (!firmTypeInput || !gstInput) return;

      var isCompany = firmTypeInput.value.trim().toLowerCase() === "company";
      gstInput.required = isCompany;
      gstInput.dataset.validationLabel = isCompany ? "GST No" : "GST No";
      if (!isCompany && gstInput.value.trim() === "") {
        clearFieldError(gstInput);
      }
    }

    function updateConditionalDocuments(formEl) {
      var firmTypeInput = formEl.querySelector("[data-vendor-firm-type='true']");
      var msmeInput = formEl.querySelector("[data-msme-toggle='true']");
      var isProprietor = firmTypeInput && firmTypeInput.value.trim().toLowerCase() === "proprietor";
      var isMsme = msmeInput && msmeInput.value.toString().trim().toLowerCase() === "true";

      formEl.querySelectorAll("[data-aadhar-upload-wrap='true']").forEach(function (wrapper) {
        toggleWrapperVisibility(wrapper, !!isProprietor);
        var input = wrapper.querySelector("input[type='file']");
        if (!input) return;
        var hasFile = input.dataset.hasAttachment === "true" || input.files.length > 0;
        input.required = !!isProprietor && !hasFile;
      });

      formEl.querySelectorAll("[data-msme-only-document='true'], [data-msme-certificate-wrap='true']").forEach(function (wrapper) {
        toggleWrapperVisibility(wrapper, !!isMsme);
        var input = wrapper.querySelector("input[type='file']");
        if (!input) return;
        var hasFile = input.dataset.hasAttachment === "true" || input.files.length > 0;
        input.required = !!isMsme && (input.dataset.mandatoryDocument === "true" || input.dataset.msmeCertificate === "true") && !hasFile;
      });
    }

    function resolveMessage(input) {
      if (input.validity.valueMissing) {
        return (input.dataset.validationLabel || "This field") + " is required.";
      }

      if (input.validity.patternMismatch || input.validity.tooShort || input.validity.tooLong || input.validity.typeMismatch) {
        return input.title || input.validationMessage;
      }

      return "";
    }

    function setFieldError(input) {
      var wrapper = input.closest(".app-form-field");
      if (!wrapper) return;

      var errorEl = wrapper.querySelector("[data-field-error='true']");
      if (!errorEl) return;

      var message = resolveMessage(input);
      wrapper.classList.toggle("has-error", !!message);
      errorEl.textContent = message;
      errorEl.classList.toggle("is-visible", !!message);
    }

    function clearFieldError(input) {
      var wrapper = input.closest(".app-form-field");
      if (!wrapper) return;

      var errorEl = wrapper.querySelector("[data-field-error='true']");
      if (!errorEl) return;

      if (input.checkValidity()) {
        errorEl.textContent = "";
        errorEl.classList.remove("is-visible");
        if (!wrapper.querySelector(".app-form-error:not(.app-form-error-client)")) {
          wrapper.classList.remove("has-error");
        }
      }
    }

    function setCheckboxGroupError(groupEl) {
      var checkboxes = groupEl.querySelectorAll("input[type='checkbox']");
      var errorEl = groupEl.querySelector("[data-field-error='true']");
      if (!errorEl) return;

      var anyChecked = Array.from(checkboxes).some(function (checkbox) { return checkbox.checked; });
      var hasServerError = groupEl.querySelector(".app-form-error:not(.app-form-error-client)");
      var message = anyChecked ? "" : (groupEl.dataset.checkboxGroupLabel + " is required.");

      errorEl.textContent = message;
      errorEl.classList.toggle("is-visible", !!message);
      groupEl.classList.toggle("has-error", !!message || !!hasServerError);
    }

    function clearCheckboxGroupError(groupEl) {
      var errorEl = groupEl.querySelector("[data-field-error='true']");
      if (!errorEl) return;

      var anyChecked = Array.from(groupEl.querySelectorAll("input[type='checkbox']")).some(function (checkbox) { return checkbox.checked; });
      if (anyChecked) {
        errorEl.textContent = "";
        errorEl.classList.remove("is-visible");
        if (!groupEl.querySelector(".app-form-error:not(.app-form-error-client)")) {
          groupEl.classList.remove("has-error");
        }
      }
    }

    document.querySelectorAll("[data-uppercase-input='true']").forEach(function (input) {
      input.addEventListener("input", function () {
        this.value = this.value.toUpperCase();
        clearFieldError(this);
      });
    });

    document.querySelectorAll("[data-numeric-input='true']").forEach(function (input) {
      input.addEventListener("input", function () {
        var maxLength = parseInt(this.dataset.numericLimit || "10", 10);
        this.value = this.value.replace(/\D/g, "").slice(0, maxLength);
        clearFieldError(this);
      });
    });

    document.querySelectorAll("[data-checkbox-group='true']").forEach(function (groupEl) {
      groupEl.querySelectorAll("input[type='checkbox']").forEach(function (checkbox) {
        checkbox.addEventListener("change", function () {
          clearCheckboxGroupError(groupEl);
        });
      });
    });

    document.querySelectorAll("[data-vendor-validation-form='true'] input[pattern], [data-vendor-validation-form='true'] input[required], [data-vendor-validation-form='true'] input[type='email'], [data-vendor-validation-form='true'] select[required], [data-vendor-validation-form='true'] textarea[required]").forEach(function (input) {
      input.addEventListener("invalid", function (event) {
        event.preventDefault();
        setFieldError(this);
      });

      input.addEventListener("input", function () {
        clearFieldError(this);
      });

      input.addEventListener("blur", function () {
        if (this.value.trim() !== "") {
          setFieldError(this);
        }
      });
    });

    document.querySelectorAll("[data-vendor-validation-form='true']").forEach(function (formEl) {
      updateGstRequirement(formEl);
      updateConditionalDocuments(formEl);

      var firmTypeInput = formEl.querySelector("[data-vendor-firm-type='true']");
      if (firmTypeInput) {
        firmTypeInput.addEventListener("change", function () {
          updateGstRequirement(formEl);
          updateConditionalDocuments(formEl);
        });
      }

      var msmeInput = formEl.querySelector("[data-msme-toggle='true']");
      if (msmeInput) {
        msmeInput.addEventListener("change", function () {
          updateConditionalDocuments(formEl);
        });
      }

      formEl.addEventListener("submit", function (event) {
        var firstInvalidField = null;

        formEl.querySelectorAll("input[pattern], input[required], input[type='email'], select[required], textarea[required]").forEach(function (input) {
          setFieldError(input);
          if (!firstInvalidField && !input.checkValidity()) {
            firstInvalidField = input;
          }
        });

        formEl.querySelectorAll("[data-checkbox-group='true']").forEach(function (groupEl) {
          setCheckboxGroupError(groupEl);
          if (!firstInvalidField && !Array.from(groupEl.querySelectorAll("input[type='checkbox']")).some(function (checkbox) { return checkbox.checked; })) {
            firstInvalidField = groupEl.querySelector("input[type='checkbox']");
          }
        });

        if (firstInvalidField) {
          event.preventDefault();
          firstInvalidField.focus();
        }
      });
    });
  });
</script>
