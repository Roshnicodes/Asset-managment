<style>
  .sticky-top { position: sticky; top: 0; z-index: 100; }
  .app-table thead th { background: #f8fcf9 !important; border-bottom: 2px solid #eef3ef !important; }
  .app-table-wrap { max-height: 75vh; overflow-y: auto; overflow-x: auto; background: white; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
  /* Column widths; values wrap, the rest is shared .app-list-table styling. */
  .vendor-list-table .vl-col-check { width: 40px; }
  .vendor-list-table .vl-col-view { width: 58px; }
  .vendor-list-table .vl-col-stakeholder { width: 100px; }
  .vendor-list-table .vl-col-vendor { width: 170px; }
  .vendor-list-table .vl-col-firm { width: 160px; }
  .vendor-list-table .vl-col-state { width: 120px; }
  .vendor-list-table .vl-col-status { width: 90px; }
  .vendor-list-table .vl-col-approval { width: 130px; }
  .vendor-list-table .vl-col-remark { width: 150px; }
  .vendor-list-table .vl-col-trail { width: 240px; }
  .vendor-list-table .vl-col-submitted { width: 120px; }
  .vendor-list-table .vl-col-action { width: 170px; }
  .vendor-list-table .app-row-actions .app-secondary-btn { min-width: 0; min-height: 32px; padding: .3rem .75rem; font-size: .8rem; }
  .vendor-list-table .app-row-actions > div { flex-wrap: wrap; }
  @media (max-width: 1500px) {
    .vendor-list-table .vl-col-vendor { width: 160px; }
    .vendor-list-table .vl-col-firm { width: 140px; }
    .vendor-list-table .vl-col-trail { width: 200px; }
  }
  /* 1280-1400 px laptops: Vendor Name takes the space that is left */
  @media (max-width: 1400px) {
    .vendor-list-table .vl-col-check { width: 36px; }
    .vendor-list-table .vl-col-view { width: 50px; }
    .vendor-list-table .vl-col-stakeholder { width: 90px; }
    .vendor-list-table .vl-col-vendor { width: auto; }
    .vendor-list-table .vl-col-firm { width: 130px; }
    .vendor-list-table .vl-col-approval { width: 112px; }
    .vendor-list-table .vl-col-trail { width: 185px; }
    .vendor-list-table .vl-col-action { width: 150px; }
  }
</style>

<% sendable_vendor_registrations = @vendor_registrations.select { |vendor_registration| vendor_registration.approval_request.blank? } %>

<div class="app-toolbar">
  <div class="d-flex align-items-center gap-3 flex-wrap" style="width:100%">
    <div>
      <h1 class="mb-0">Vendor Registration Form</h1>
    </div>
    <div style="margin-left:auto; display:flex; flex-wrap:wrap; gap:.5rem; align-items:center;">
      <%= link_to "Add Vendor Registration", new_vendor_registration_path, class: "app-primary-btn" %>
      <%= link_to "Send Registration Link", new_vendor_registration_invitation_path, class: "app-secondary-btn" %>
      <%= form_tag send_for_approval_vendor_registrations_path, method: :post, id: "send-approval-form", style: "display: inline;" do %>
        <button type="submit" class="app-secondary-btn d-none" id="send_for_approval_button">Send for Approval</button>
      <% end %>
    </div>
  </div>
</div>
<div class="app-table-wrap">
<table class="table app-table app-list-table vendor-list-table" data-min-width-ready="true">
  <thead class="sticky-top">
    <tr>
      <th class="vl-col-check">
        <% if sendable_vendor_registrations.any? %>
          <input type="checkbox" id="select_all_checkbox" style="cursor: pointer;">
        <% end %>
      </th>
      <th class="vl-col-view">View</th>
      <th class="vl-col-stakeholder">Stakeholder</th>
      <th class="vl-col-vendor">Vendor Name</th>
      <th class="vl-col-firm">Company / Firm Type</th>
      <th class="vl-col-state ql-optional">State</th>
      <th class="vl-col-status ql-optional">Status</th>
      <th class="vl-col-approval">Approval Status</th>
      <th class="vl-col-remark ql-optional">Latest Remark</th>
      <th class="vl-col-trail">Approval Trail</th>
      <th class="vl-col-submitted ql-optional">Submitted At</th>
      <th class="vl-col-action">Action</th>
    </tr>
  </thead>
  <tbody>
    <% @vendor_registrations.each do |vendor_registration| %>
      <tr>
        <td>
          <% if vendor_registration.approval_request.blank? %>
            <input type="checkbox" name="vendor_registration_ids[]" value="<%= vendor_registration.id %>" class="row-approval-checkbox" style="cursor: pointer;" form="send-approval-form">
          <% end %>
        </td>
        <td>
          <%= link_to vendor_registration_path(vendor_registration), class: "app-action-icon text-primary", title: "View" do %>
            <%= app_icon(:eye, size: 18) %>
          <% end %>
        </td>
        <td><%= vendor_registration.stakeholder_category&.name || "-" %></td>
        <td><span class="ql-clamp-2 fw-semibold" title="<%= vendor_registration.vendor_name %>"><%= vendor_registration.vendor_name %></span></td>
        <% firm_label = vendor_registration.firm_name.presence || vendor_registration.firm_type.presence || vendor_registration.firm&.name || "-" %>
          <td><span class="ql-clamp-2" title="<%= firm_label %>"><%= firm_label %></span></td>
        <td class="ql-optional"><%= vendor_registration.state&.name || "-" %></td>
        <td class="ql-optional"><%= vendor_registration.company_status %></td>
        <td>
          <% approval_request = vendor_registration.approval_request %>
          <% badge_data = approval_status_badge_data(approval_request) %>
          <span class="badge border <%= badge_data[:css_class] %> fw-semibold px-2 py-1">
            <%= badge_data[:label] %>
          </span>
        </td>
        <% latest_remark = vendor_registration.approval_request&.latest_remark.presence %>
          <td class="ql-optional"><span class="ql-remark" title="<%= latest_remark %>"><%= latest_remark || "-" %></span></td>
        <td>
            <% if vendor_registration.approval_request %>
              <%= render "shared/approval_trail", steps: vendor_registration.approval_request.trail_steps, started: true %>
            <% else %>
              <span class="text-muted">-</span>
            <% end %>
          </td>
        <td class="ql-optional"><%= vendor_registration.submitted_at&.strftime("%d-%m-%Y %H:%M") %></td>
        <td class="app-row-actions">
          <div class="d-flex align-items-center gap-2">
            <% if vendor_registration.approval_request.blank? %>
              <%= button_to "Send", send_for_approval_vendor_registration_path(vendor_registration), method: :post, class: "app-secondary-btn", title: "Send for Approval", form: { class: "d-inline-block" } %>
            <% end %>
            <% if admin_user? || (vendor_registration.user_id == current_user.id && !vendor_registration.approval_locked?) %>
              <%= link_to edit_vendor_registration_path(vendor_registration), class: "app-action-icon text-warning", title: "Edit" do %>
                <%= app_icon(:pencil, size: 18) %>
              <% end %>
            <% end %>
            <% if admin_user? || (vendor_registration.user_id == current_user.id && !vendor_registration.approval_locked?) %>
              <%= button_to vendor_registration_path(vendor_registration), method: :delete, data: { turbo_confirm: "Delete this vendor registration?" }, class: "app-action-icon text-danger", title: "Delete" do %>
                <%= app_icon(:trash, size: 18) %>
              <% end %>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>
