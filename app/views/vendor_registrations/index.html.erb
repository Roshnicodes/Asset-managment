<% sendable_vendor_registrations = @vendor_registrations.select { |vendor_registration| vendor_registration.approval_request.blank? } %>
<% approval_tone = ->(request) { { "approved" => "green", "pending" => "amber", "returned" => "orange", "rejected" => "red" }.fetch(request&.status.to_s, "slate") } %>

<div class="rl">
  <section class="rl-head">
    <span class="rl-head__icon"><%= app_icon(:registration, size: 28) %></span>
    <div class="rl-head__title">
      <h1>Vendor Registration Form</h1>
      <p>Manage vendor registrations, track status and take necessary actions.</p>
    </div>
    <div class="rl-head__actions">
      <%= form_tag send_for_approval_vendor_registrations_path, method: :post, id: "send-approval-form", class: "d-inline" do %>
        <button type="submit" class="rl-btn rl-btn--outline d-none" id="send_for_approval_button"><%= app_icon(:approval, size: 16) %> Send for Approval</button>
      <% end %>
      <%= link_to new_vendor_registration_invitation_path, class: "rl-btn rl-btn--outline" do %><%= app_icon(:vendor, size: 16) %> Send Registration Link<% end %>
      <%= link_to new_vendor_registration_path, class: "rl-btn rl-btn--primary" do %>+ Add Vendor Registration<% end %>
    </div>
  </section>

  <div class="rl-card" data-rlist>
    <%= render "shared/rlist_toolbar",
               placeholder: "Search by vendor name, firm, GST, PAN, state...",
               filters: [
                 ["state", "State", @vendor_registrations.filter_map { |v| v.state&.name }.uniq.sort],
                 ["firm", "Firm Type", @vendor_registrations.filter_map { |v| v.firm_type.presence }.uniq.sort],
                 ["approval", "Approval Status", @vendor_registrations.map { |v| approval_status_badge_data(v.approval_request)[:label] }.uniq.sort]
               ] %>

    <div class="app-table-wrap rl-table-wrap" data-table-search="false" data-table-pagination="false">
      <table class="table app-table rl-table" data-min-width-ready="true">
        <thead>
          <tr>
            <th class="rl-col-check">
              <% if sendable_vendor_registrations.any? %>
                <input type="checkbox" id="select_all_checkbox" aria-label="Select all">
              <% end %>
            </th>
            <th class="rl-col-num">#</th>
            <th class="rl-col-view">View</th>
            <th>Vendor Name</th>
            <th>Company / Firm Type</th>
            <th>State</th>
            <th class="rl-optional-sm">Status</th>
            <th>Approval Status</th>
            <th>Submitted At</th>
            <th class="rl-col-actions">Action</th>
          </tr>
        </thead>
        <tbody>
          <% @vendor_registrations.each do |vendor_registration| %>
            <% approval_request = vendor_registration.approval_request %>
            <% badge_data = approval_status_badge_data(approval_request) %>
            <% current_step = approval_request&.current_step %>
            <% trail_text = approval_request ? approval_request.trail_steps.map { |step| "#{step.employee_master&.name}: #{step.effective_status_label}" }.join("\n") : "Not sent for approval" %>
            <% can_change = admin_user? || (vendor_registration.user_id == current_user.id && !vendor_registration.approval_locked?) %>
            <tr data-rlist-row
                data-f-state="<%= vendor_registration.state&.name %>"
                data-f-firm="<%= vendor_registration.firm_type %>"
                data-f-approval="<%= badge_data[:label] %>"
                data-search-text="<%= [vendor_registration.vendor_name, vendor_registration.firm_name, vendor_registration.gst_no, vendor_registration.pan_no, vendor_registration.mobile_no, vendor_registration.state&.name, vendor_registration.district&.name].compact.join(' ') %>">
              <td class="rl-col-check">
                <% if approval_request.blank? %>
                  <input type="checkbox" name="vendor_registration_ids[]" value="<%= vendor_registration.id %>" class="row-approval-checkbox" form="send-approval-form" aria-label="Select <%= vendor_registration.display_name %>">
                <% end %>
              </td>
              <td class="rl-col-num" data-rlist-number></td>
              <td class="rl-col-view">
                <%= link_to vendor_registration_path(vendor_registration), class: "rl-icon-btn rl-icon-btn--plain", title: "View" do %><%= app_icon(:eye, size: 17) %><% end %>
              </td>
              <td>
                <span class="rl-person">
                  <%= list_avatar(vendor_registration.display_name) %>
                  <span>
                    <strong title="<%= vendor_registration.vendor_name %>"><%= vendor_registration.vendor_name.presence || "-" %></strong>
                    <small title="<%= vendor_registration.firm_name %>"><%= vendor_registration.firm_name %></small>
                  </span>
                </span>
              </td>
              <td><%= vendor_registration.firm_type.presence || vendor_registration.firm&.name || "-" %></td>
              <td><%= vendor_registration.state&.name || "-" %></td>
              <td class="rl-optional-sm">
                <% if vendor_registration.company_status.present? %>
                  <span class="rl-pill rl-pill--<%= vendor_registration.company_status.to_s.casecmp?("active") ? "green" : "slate" %>"><%= vendor_registration.company_status %></span>
                <% else %>-<% end %>
              </td>
              <td title="<%= trail_text %>">
                <span class="rl-pill rl-pill--<%= approval_tone.(approval_request) %>"><%= badge_data[:label] %></span>
                <% if current_step && approval_request.status == "pending" %>
                  <small class="rl-sub">Waiting: <%= current_step.employee_master&.name %></small>
                <% end %>
              </td>
              <td class="rl-date">
                <% if vendor_registration.submitted_at %>
                  <%= vendor_registration.submitted_at.in_time_zone("Asia/Kolkata").strftime("%d-%m-%Y") %>
                  <small><%= vendor_registration.submitted_at.in_time_zone("Asia/Kolkata").strftime("%I:%M %p") %></small>
                <% else %>-<% end %>
              </td>
              <td class="rl-col-actions">
                <div class="rl-actions">
                  <% if approval_request.blank? %>
                    <%= button_to send_for_approval_vendor_registration_path(vendor_registration), method: :post, class: "rl-icon-btn rl-icon-btn--green", title: "Send for Approval", form: { class: "d-inline-block" } do %><%= app_icon(:approval, size: 16) %><% end %>
                  <% end %>
                  <% if can_change %>
                    <%= link_to edit_vendor_registration_path(vendor_registration), class: "rl-icon-btn rl-icon-btn--teal", title: "Edit" do %><%= app_icon(:pencil, size: 16) %><% end %>
                    <%= button_to vendor_registration_path(vendor_registration), method: :delete, data: { turbo_confirm: "Delete this vendor registration?" }, class: "rl-icon-btn rl-icon-btn--red", title: "Delete", form: { class: "d-inline-block" } do %><%= app_icon(:trash, size: 16) %><% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="rl-empty" data-rlist-empty hidden>No vendor registration matches the filters.</div>
    </div>
    <div class="rl-footer" data-rlist-footer></div>
  </div>
</div>
