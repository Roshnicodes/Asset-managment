<% approval_request = @vendor_registration.approval_request %>
<% current_step = approval_request&.current_step %>
<% approver_view = approval_request.present? && current_step&.employee_master_id == current_employee_master&.id && approval_request.status == "pending" %>
<% owner_or_admin = current_user == @vendor_registration.user || admin_user? %>
<div class="app-page-shell vendor-registration-show-page">
  <div class="app-page-header vendor-show-header">
    <div>
      <h2>Vendor Registration Details</h2>
      <p><%= @vendor_registration.vendor_name %></p>
    </div>
    <div class="vendor-show-actions">
      <%= link_to "← Back", vendor_registrations_path, class: "app-back-link" %>
      <% if owner_or_admin && !@vendor_registration.approval_locked? %>
        <%= link_to "Edit", edit_vendor_registration_path(@vendor_registration), class: "app-primary-btn" %>
      <% end %>
      <% if admin_user? || (@vendor_registration.user_id == current_user.id && !@vendor_registration.approval_locked?) %>
        <%= button_to "Delete", @vendor_registration, method: :delete, data: { turbo_confirm: "Are you sure you want to delete this vendor registration?" }, class: "app-danger-btn" %>
      <% end %>
    </div>
  </div>

  <%= render @vendor_registration %>

  <% if approver_view %>
    <div class="app-form-card vendor-approval-action-card">
      <h3>Pending Approval Action (<%= current_step.current_action %>)</h3>
      <p class="app-section-note">Only the current pending approver can take action here. Higher levels can return to the previous approver or to the employee. If returned to the employee, the record can be edited and resubmitted through the same approval channel.</p>

      <div class="vendor-approval-action-buttons">
        <%= render "approval_requests/approve_modal",
          approval_request: approval_request,
          modal_id: "approve-approval-request-#{approval_request.id}",
          trigger_label: "Approve",
          trigger_class: "app-primary-btn approval-action-btn" %>

        <%= render "approval_requests/return_modal",
          approval_request: approval_request,
          current_step: current_step,
          modal_id: "return-approval-request-#{approval_request.id}",
          trigger_label: "Return",
          trigger_class: "app-secondary-btn approval-action-btn" %>

        <%= render "approval_requests/reject_modal",
          approval_request: approval_request,
          modal_id: "reject-approval-request-#{approval_request.id}",
          trigger_label: "Reject",
          trigger_class: "app-danger-btn approval-action-btn" %>
      </div>
    </div>
  <% end %>
</div>
