<% if vendor_selection_criterion.persisted? %>
  <%= form_with(
    model: vendor_selection_criterion,
    url: url_for(controller: "vendor_selection_criteria", action: :update, id: vendor_selection_criterion.id),
    method: :patch,
    local: true
  ) do |form| %>
    <div class="app-form-card">
      <% if vendor_selection_criterion.errors.any? %>
        <div class="app-form-errors">
          <h2><%= pluralize(vendor_selection_criterion.errors.count, "error") %> found</h2>
          <ul>
            <% vendor_selection_criterion.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="app-form-grid">
        <div class="app-form-field">
          <%= form.label :theme_id, "Thematic Type" %>
          <%= form.collection_select :theme_id, @themes, :id, :name, { prompt: "Select thematic type" }, class: "form-control" %>
        </div>

        <div class="app-form-field" style="grid-column: 1 / -1;">
          <%= form.label :criteria, "Criteria" %>
          <%= form.text_field :criteria, class: "form-control", placeholder: "Enter vendor selection criteria" %>
        </div>
      </div>

      <div class="app-form-actions">
        <%= form.submit "Save Vendor Selection Criteria", class: "app-form-submit" %>
      </div>
    </div>
  <% end %>
<% else %>
  <% criteria_rows = Array(@vendor_selection_criteria.presence || [vendor_selection_criterion]) %>
  <% batch_context = (@vendor_selection_criteria_batch_context || {}).to_h.with_indifferent_access %>
  <% batch_theme_id = batch_context[:theme_id].presence || criteria_rows.find { |row| row.theme_id.present? }&.theme_id %>

  <%= form_with(url: vendor_selection_criteria_path, method: :post, local: true, class: "product-batch-form vendor-criteria-batch-form", data: { product_batch_form: true }) do %>
    <div class="app-form-card product-batch-card">
      <div class="product-batch-toolbar">
        <div class="product-batch-toolbar-title">
          <strong>Criteria</strong>
          <span data-product-row-count><%= criteria_rows.size %></span>
        </div>
      </div>

      <div class="product-batch-context vendor-criteria-context">
        <div class="app-form-field">
          <%= label_tag "vendor_selection_criteria_batch_theme_id", "Thematic Type" %>
          <%= select_tag "vendor_selection_criteria_batch[theme_id]",
                options_from_collection_for_select(@themes, :id, :name, batch_theme_id),
                include_blank: "Select thematic type",
                id: "vendor_selection_criteria_batch_theme_id",
                required: true,
                class: "form-control" %>
        </div>
      </div>

      <div class="product-batch-rows" data-product-rows>
        <% criteria_rows.each_with_index do |criteria_row, index| %>
          <%= render "vendor_selection_criteria/vendor_selection_criteria_row_fields", vendor_selection_criterion: criteria_row, index: index %>
        <% end %>
      </div>

      <template data-product-row-template>
        <%= render "vendor_selection_criteria/vendor_selection_criteria_row_fields", vendor_selection_criterion: VendorSelectionCriterion.new, index: "NEW_RECORD" %>
      </template>

      <div class="app-form-actions product-batch-actions">
        <button type="button" class="app-secondary-btn product-batch-add-button" data-add-product-row>+ Add New</button>
        <%= submit_tag "Save Vendor Selection Criteria", class: "app-form-submit" %>
      </div>
    </div>
  <% end %>

  <style>
    .vendor-criteria-batch-form .product-batch-card {
      padding: 0 !important;
      overflow: hidden !important;
      border: 1px solid rgba(11, 74, 79, 0.18) !important;
      border-radius: 8px !important;
      background: #ffffff !important;
      box-shadow: none !important;
    }

    .vendor-criteria-batch-form .product-batch-toolbar {
      display: flex !important;
      align-items: center !important;
      justify-content: flex-start !important;
      padding: 0.75rem 1rem !important;
      border-bottom: 1px solid rgba(11, 74, 79, 0.12) !important;
      background: #f8fbf9 !important;
    }

    .vendor-criteria-batch-form .product-batch-toolbar-title {
      display: inline-flex !important;
      align-items: center !important;
      gap: 0.7rem !important;
    }

    .vendor-criteria-batch-form .product-batch-toolbar-title strong {
      color: var(--brand-deep) !important;
      font-size: 1rem !important;
      font-weight: 800 !important;
    }

    .vendor-criteria-batch-form .product-batch-toolbar-title span {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      min-width: 2rem !important;
      height: 1.8rem !important;
      padding: 0 0.6rem !important;
      border-radius: 999px !important;
      background: rgba(242, 177, 52, 0.2) !important;
      color: #6b4500 !important;
      font-size: 0.86rem !important;
      font-weight: 800 !important;
    }

    .vendor-criteria-batch-form .product-batch-context {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) !important;
      gap: 0.65rem !important;
      padding: 0.75rem 1rem !important;
      border-bottom: 1px solid rgba(11, 74, 79, 0.1) !important;
      background: #ffffff !important;
    }

    .vendor-criteria-batch-form .product-batch-rows {
      display: grid !important;
      gap: 0.65rem !important;
      padding: 0.75rem 1rem !important;
      background: #fbfdfc !important;
    }

    .vendor-criteria-batch-form .product-batch-row {
      display: grid !important;
      gap: 0.62rem !important;
      border: 1px solid rgba(11, 74, 79, 0.14) !important;
      border-left: 4px solid var(--brand-accent) !important;
      border-radius: 8px !important;
      padding: 0.75rem 0.95rem !important;
      background: #ffffff !important;
      box-shadow: 0 8px 20px rgba(11, 74, 79, 0.05) !important;
    }

    .vendor-criteria-batch-form .product-batch-row-header {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 1rem !important;
    }

    .vendor-criteria-batch-form .product-batch-row-title {
      display: inline-flex !important;
      align-items: center !important;
      gap: 0.55rem !important;
      color: var(--brand-deep) !important;
      font-weight: 800 !important;
    }

    .vendor-criteria-batch-form .product-batch-row-title strong {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      min-width: 1.9rem !important;
      height: 1.9rem !important;
      border-radius: 999px !important;
      background: rgba(11, 74, 79, 0.1) !important;
      color: var(--brand-deep) !important;
      font-size: 0.9rem !important;
    }

    .vendor-criteria-batch-form .product-batch-remove-button {
      border: 1px solid rgba(185, 28, 28, 0.18) !important;
      border-radius: 8px !important;
      padding: 0.58rem 0.85rem !important;
      background: #fff7f7 !important;
      color: #9f1d1d !important;
      font: inherit !important;
      font-size: 0.9rem !important;
      font-weight: 800 !important;
      line-height: 1 !important;
    }

    .vendor-criteria-batch-form .product-batch-remove-button:hover {
      background: #fee2e2 !important;
    }

    .vendor-criteria-batch-form .product-batch-rows > .product-batch-row:only-child .product-batch-remove-button,
    .vendor-criteria-batch-form .product-batch-remove-button[hidden] {
      display: none !important;
    }

    .vendor-criteria-batch-form .product-batch-row .app-form-grid {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) !important;
      gap: 0.65rem !important;
    }

    .vendor-criteria-batch-form .product-batch-row-errors {
      padding: 0.75rem 0.9rem !important;
      border: 1px solid rgba(185, 28, 28, 0.22) !important;
      border-radius: 8px !important;
      background: rgba(254, 242, 242, 0.88) !important;
      color: #991b1b !important;
      font-size: 0.95rem !important;
      font-weight: 700 !important;
    }

    .vendor-criteria-batch-form .product-batch-actions {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 1rem !important;
      margin: 0 !important;
      padding: 0.75rem 1rem !important;
      border-top: 1px solid rgba(11, 74, 79, 0.12) !important;
      background: #ffffff !important;
    }

    .vendor-criteria-batch-form .product-batch-add-button {
      min-height: 2.45rem !important;
      padding: 0.62rem 1rem !important;
      border: 1px solid rgba(11, 74, 79, 0.24) !important;
      border-radius: 8px !important;
      background: #ffffff !important;
      color: var(--brand-deep) !important;
      font-weight: 800 !important;
      white-space: nowrap !important;
    }

    .vendor-criteria-batch-form .product-batch-add-button:hover {
      background: rgba(11, 74, 79, 0.06) !important;
    }

    @media screen and (max-width: 820px) {
      .vendor-criteria-batch-form .product-batch-row-header,
      .vendor-criteria-batch-form .product-batch-actions {
        align-items: stretch !important;
        flex-direction: column !important;
      }

      .vendor-criteria-batch-form .product-batch-add-button,
      .vendor-criteria-batch-form .product-batch-remove-button,
      .vendor-criteria-batch-form .product-batch-actions .app-form-submit {
        width: 100% !important;
      }
    }
  </style>

  <script>
    (function() {
      function setupVendorCriteriaBatchForm() {
        document.querySelectorAll("[data-product-batch-form]").forEach(function(form) {
          if (form.dataset.productBatchReady === "true") return;

          var rowsContainer = form.querySelector("[data-product-rows]");
          var template = form.querySelector("[data-product-row-template]");
          var addButton = form.querySelector("[data-add-product-row]");
          var rowCount = form.querySelector("[data-product-row-count]");

          if (!rowsContainer || !template || !addButton) return;

          var nextIndex = rowsContainer.querySelectorAll("[data-product-row]").length;

          function syncRows() {
            var rows = Array.prototype.slice.call(rowsContainer.querySelectorAll("[data-product-row]"));

            if (rowCount) rowCount.textContent = String(rows.length);

            rows.forEach(function(row, index) {
              var number = row.querySelector("[data-product-row-number]");
              var removeButton = row.querySelector("[data-remove-product-row]");

              if (number) number.textContent = String(index + 1);
              if (removeButton) removeButton.hidden = rows.length === 1;
            });
          }

          addButton.addEventListener("click", function() {
            var html = template.innerHTML.split("NEW_RECORD").join(String(nextIndex));
            nextIndex += 1;

            rowsContainer.insertAdjacentHTML("beforeend", html);
            syncRows();

            var lastRow = rowsContainer.querySelector("[data-product-row]:last-child");
            var firstField = lastRow && lastRow.querySelector("input[type='text'], select, textarea");
            if (firstField) firstField.focus();
          });

          rowsContainer.addEventListener("click", function(event) {
            var target = event.target;
            var removeButton = target && target.closest ? target.closest("[data-remove-product-row]") : null;
            if (!removeButton) return;

            var rows = rowsContainer.querySelectorAll("[data-product-row]");
            if (rows.length <= 1) return;

            var row = removeButton.closest("[data-product-row]");
            if (row) row.remove();
            syncRows();
          });

          form.dataset.productBatchReady = "true";
          syncRows();
        });
      }

      document.addEventListener("turbo:load", setupVendorCriteriaBatchForm);
      document.addEventListener("DOMContentLoaded", setupVendorCriteriaBatchForm);
      setupVendorCriteriaBatchForm();
    })();
  </script>
<% end %>
